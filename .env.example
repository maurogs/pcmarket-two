# Copy to .env and fill in values. Never commit .env.
# `.env.example` documents every variable read by the application.

# --- Rails / app -----------------------------------------------------------
RAILS_MASTER_KEY=
SECRET_KEY_BASE_DUMMY=0
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
PORT=3000
APP_HOST=pcmarket.example
APP_HOSTS=pcmarket.example
ASSET_HOST=
ACTIVE_STORAGE_HOST=
API_IMAGE_HOST=
API_IMAGE_PROTOCOL=https
SITEMAP_HOST=
NOINDEX=0
CORS_ALLOWED_ORIGINS=

# --- Database (PostgreSQL) --------------------------------------------------
# Primary, cache, queue and cable databases are configured in database.yml.
APP_TEST_TWO_DATABASE_PASSWORD=
DATABASE_URL=
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=
CABLE_DATABASE_URL=

# --- Jobs -------------------------------------------------------------------
SOLID_QUEUE_IN_PUMA=false
JOB_CONCURRENCY=1

# --- Active Record encryption (buyback IBANs) ------------------------------
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Uploads ----------------------------------------------------------------
# local, amazon or cloudflare (R2).
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_BUCKET=
AWS_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
S3_ENDPOINT=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true

# --- Payments ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MOBILE_CONNECT_RETURN_URL=

# --- Authentication ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# --- Demo data / local tooling (never enable in production) ----------------
DEMO=
DEMO_PASSWORD=
DEMO_SCALE=
DEMO_IMAGE_ROOT=
CATEGORIES=
PER_CATEGORY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
VERBOSE=
ADMIN_PASSWORD=
BULLET_DISABLED=0
