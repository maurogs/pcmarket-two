<header data-controller="drawer" class="sticky top-0 z-40 border-b border-border bg-surface">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-2 px-4 sm:gap-3 sm:px-6 lg:px-8">
    <button type="button"
            data-drawer-target="toggle"
            data-action="drawer#open"
            aria-controls="mobile-drawer"
            aria-expanded="false"
            aria-label="<%= t("nav.open_menu") %>"
            class="icon-button md:hidden">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
    </button>

    <%= link_to root_path, class: "flex shrink-0 items-center gap-2", aria: { label: t("nav.home") } do %>
      <svg class="h-9 w-9" viewBox="0 0 36 36" aria-hidden="true">
        <rect width="36" height="36" rx="11" class="fill-primary-600"></rect>
        <path d="M11 25V11h7.4a4.6 4.6 0 0 1 0 9.2H15.8" fill="none" stroke="white" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="24.8" cy="24.4" r="2.4" class="fill-accent"></circle>
      </svg>
      <span class="text-lg font-extrabold tracking-tight text-content"><%= t("app.name") %></span>
    <% end %>

    <div class="mx-auto hidden w-full max-w-xl md:block">
      <%= render "shared/search_form", form_id: "header-search", class: "w-full" %>
    </div>

    <div class="ml-auto flex items-center gap-0.5 sm:gap-1 md:ml-0">
      <%= link_to new_sell_listing_path, class: "btn-primary hidden md:inline-flex" do %>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
        </svg>
        <span><%= t("nav.list_item") %></span>
      <% end %>

      <%= link_to t("nav.sell_to_us"), "#", class: "btn-accent ml-2 hidden lg:inline-flex" %>

      <%= link_to wishlist_path, class: "icon-button hidden lg:inline-flex", aria: { label: t("nav.wishlist") } do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20.8 5.6a5.2 5.2 0 0 0-7.4 0L12 7l-1.4-1.4a5.2 5.2 0 0 0-7.4 7.4L12 21l8.8-8a5.2 5.2 0 0 0 0-7.4Z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      <% end %>

      <% if user_signed_in? %>
        <%= turbo_stream_from current_user, :notifications %>
        <%= render "shared/notifications_bell", user: current_user, locale: I18n.locale %>
      <% else %>
        <%= link_to new_user_session_path, class: "icon-button", aria: { label: t("nav.notifications") } do %>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M10 21h4" stroke-linecap="round"></path>
          </svg>
        <% end %>
      <% end %>

      <%= link_to cart_path, class: "icon-button relative", aria: { label: t("nav.cart") } do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 4h2l2.4 11.2a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.6-1.3L21 7H6" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="9.5" cy="20" r="1.4"></circle>
          <circle cx="17.5" cy="20" r="1.4"></circle>
        </svg>
        <span class="absolute -right-0.5 -top-0.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-accent px-1 text-[11px] font-bold leading-none text-on-accent" aria-hidden="true"><%= cart_badge_count %></span>
      <% end %>

      <% account_menu_item_class = "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm text-content transition hover:bg-surface-muted focus:bg-surface-muted" %>
      <div data-controller="dropdown" class="relative">
        <button type="button"
                data-dropdown-target="trigger"
                data-action="dropdown#toggle keydown->dropdown#triggerKeydown"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="<%= t("nav.account") %>"
                class="icon-button">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 21a8 8 0 0 1 16 0" stroke-linecap="round"></path>
          </svg>
        </button>

        <div data-dropdown-target="menu"
             role="menu"
             aria-label="<%= t("nav.account") %>"
             class="absolute right-0 z-50 mt-2 hidden w-64 overflow-hidden rounded-xl border border-border bg-surface p-1 shadow-xl">
          <% if user_signed_in? %>
            <div class="border-b border-border px-3 py-2">
              <p class="truncate text-sm font-semibold text-content"><%= current_user.display_name %></p>
              <p class="truncate text-xs text-muted"><%= current_user.email %></p>
            </div>

            <%= link_to t("account.menu.my_orders"), orders_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.inbox"), conversations_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.wishlist"), wishlist_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.saved_searches"), saved_searches_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.notifications"), notifications_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.notification_settings"), notification_preferences_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.settings"), account_profile_path, role: "menuitem", class: account_menu_item_class %>

            <div class="my-1 border-t border-border"></div>
            <p class="px-3 py-1 text-xs font-semibold uppercase tracking-widest text-muted"><%= t("account.menu.store.title") %></p>
            <%= link_to t("account.menu.store.public_profile"),
                        current_user.store&.persisted? ? storefront_path(current_user.store) : new_store_path,
                        role: "menuitem",
                        class: account_menu_item_class %>
            <%= link_to t("account.menu.store.seller_dashboard"), sell_dashboard_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.store.listings"), sell_listings_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.store.sales"), sell_orders_path, role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.store.settings"),
                        current_user.store&.persisted? ? edit_store_path : new_store_path,
                        role: "menuitem",
                        class: account_menu_item_class %>

            <div class="my-1 border-t border-border"></div>
            <% if current_user.admin? || current_user.moderator? %>
              <%= link_to t("account.menu.admin_panel"), admin_root_path, role: "menuitem", class: account_menu_item_class %>
            <% end %>
            <%= button_to t("account.menu.logout"),
                          destroy_user_session_path(locale: I18n.locale),
                          method: :delete,
                          role: "menuitem",
                          class: account_menu_item_class %>
          <% else %>
            <%= link_to t("account.menu.signed_out.sign_in"), new_user_session_path(locale: I18n.locale), role: "menuitem", class: account_menu_item_class %>
            <%= link_to t("account.menu.signed_out.sign_up"), new_user_registration_path(locale: I18n.locale), role: "menuitem", class: account_menu_item_class %>
          <% end %>
        </div>
      </div>

      <button type="button"
              data-controller="theme"
              data-action="theme#toggle"
              aria-pressed="false"
              aria-label="<%= t("nav.theme.toggle") %>"
              class="icon-button">
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div data-controller="dropdown" class="relative">
        <button type="button"
                data-dropdown-target="trigger"
                data-action="dropdown#toggle keydown->dropdown#triggerKeydown"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="<%= t("nav.language") %>"
                class="icon-button gap-1.5 px-2">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" stroke-linecap="round"></path>
          </svg>
          <span class="hidden text-xs font-semibold lg:inline"><%= t("locale.names.#{I18n.locale}") %></span>
          <svg class="hidden h-3.5 w-3.5 lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div data-dropdown-target="menu"
             role="menu"
             aria-label="<%= t("nav.language") %>"
             class="absolute right-0 z-50 mt-2 hidden w-44 overflow-hidden rounded-xl border border-border bg-surface p-1 shadow-xl">
          <% I18n.available_locales.each do |locale| %>
            <%= link_to t("locale.names.#{locale}"),
                        url_for(locale: locale),
                        role: "menuitem",
                        lang: locale,
                        hreflang: locale,
                        aria: { current: ("true" if locale == I18n.locale) },
                        class: "flex items-center justify-between rounded-lg px-3 py-2 text-sm text-content transition hover:bg-surface-muted #{locale == I18n.locale ? "font-semibold text-primary-700 dark:text-primary-300" : ""}" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="hidden border-t border-border md:block">
    <%= render "shared/main_nav" %>
  </div>

  <div data-drawer-target="overlay"
       data-action="click->drawer#close"
       class="fixed inset-0 z-40 hidden bg-slate-950/60 backdrop-blur-sm md:hidden"
       aria-hidden="true"></div>

  <aside data-drawer-target="panel"
         id="mobile-drawer"
         role="dialog"
         aria-modal="true"
         aria-label="<%= t("nav.menu") %>"
         class="fixed inset-y-0 left-0 z-50 hidden w-[min(22rem,88vw)] overflow-y-auto border-r border-border bg-surface p-4 shadow-2xl md:hidden">
    <div class="flex items-center justify-between">
      <span class="text-lg font-extrabold tracking-tight"><%= t("app.name") %></span>
      <button type="button" data-action="drawer#close" class="icon-button" aria-label="<%= t("nav.close_menu") %>">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <div class="mt-5">
      <%= render "shared/search_form", form_id: "mobile-search", class: "w-full" %>
    </div>

    <div class="mt-4 flex flex-col gap-2">
      <%= link_to t("nav.list_item"), new_sell_listing_path, class: "btn-primary w-full" %>
      <%= link_to t("nav.sell_to_us"), "#", class: "btn-accent w-full" %>
    </div>

    <div class="mt-6 border-t border-border pt-4">
      <%= render "shared/main_nav", mobile: true %>
    </div>

    <% if user_signed_in? %>
      <div class="mt-6 border-t border-border pt-4">
        <p class="px-3 text-xs font-semibold uppercase tracking-widest text-muted"><%= t("nav.account") %></p>
        <ul class="mt-2 space-y-1">
          <li>
            <%= link_to t("account.menu.inbox"), conversations_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
          <li>
            <%= link_to t("account.menu.wishlist"), wishlist_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
          <li>
            <%= link_to t("account.menu.saved_searches"), saved_searches_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
          <li>
            <%= link_to t("account.menu.notifications"), notifications_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
          <li>
            <%= link_to t("account.menu.notification_settings"), notification_preferences_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
          <li>
            <%= link_to t("account.menu.settings"), account_profile_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
          <li>
            <%= link_to t("account.menu.store.seller_dashboard"), sell_dashboard_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
          <li>
            <%= link_to t("account.menu.store.public_profile"),
                        current_user.store&.persisted? ? storefront_path(current_user.store) : new_store_path,
                        class: "block rounded-lg px-3 py-2 text-sm font-medium text-content transition hover:bg-surface-muted" %>
          </li>
        </ul>
      </div>
    <% end %>

    <div class="mt-6 border-t border-border pt-4">
      <p class="px-3 text-xs font-semibold uppercase tracking-widest text-muted"><%= t("nav.language") %></p>
      <ul class="mt-2 grid grid-cols-2 gap-1">
        <% I18n.available_locales.each do |locale| %>
          <li>
            <%= link_to t("locale.names.#{locale}"),
                        url_for(locale: locale),
                        lang: locale,
                        hreflang: locale,
                        class: "block rounded-lg px-3 py-2 text-sm text-content transition hover:bg-surface-muted #{locale == I18n.locale ? "font-semibold text-primary-700 dark:text-primary-300" : ""}" %>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>
</header>
