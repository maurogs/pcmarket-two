<% if impersonating? %>
  <div role="status" class="border-b border-accent/40 bg-accent/10">
    <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-2 text-sm sm:px-6 lg:px-8">
      <p class="font-semibold text-content">
        <%= t("admin.impersonation.banner", name: current_user.display_name) %>
      </p>
      <%= button_to t("admin.impersonation.stop"),
                    admin_impersonation_path,
                    method: :delete,
                    class: "rounded-lg border border-accent/60 bg-surface px-3 py-1.5 text-xs font-semibold text-content transition hover:bg-surface-muted" %>
    </div>
  </div>
<% end %>
