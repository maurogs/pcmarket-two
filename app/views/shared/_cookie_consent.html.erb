<% unless cookie_consent_given? %>
  <div data-cookie-consent-target="banner"
       role="region"
       aria-label="<%= t("cookie_consent.banner.label") %>"
       class="fixed inset-x-0 bottom-0 z-50 border-t border-border bg-surface/95 p-4 shadow-2xl backdrop-blur sm:p-5">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-bold"><%= t("cookie_consent.banner.title") %></p>
        <p class="mt-1 text-xs leading-relaxed text-muted">
          <%= t("cookie_consent.banner.body") %>
          <%= link_to t("footer.legal.cookies"), legal_page_path(kind: "cookies"), class: "font-semibold text-primary-700 underline underline-offset-2 dark:text-primary-300" %>
        </p>
      </div>

      <div class="flex shrink-0 flex-col gap-2 sm:flex-row sm:items-center">
        <button type="button"
                data-action="cookie_consent#open"
                class="inline-flex items-center justify-center rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-content transition hover:bg-surface-muted">
          <%= t("cookie_consent.banner.configure") %>
        </button>

        <%= form_with url: cookie_consent_path, method: :post, class: "contents" do |form| %>
          <% CookieConsent::CATEGORIES.each do |category| %>
            <%= hidden_field_tag "cookie_consent[#{category}]", "false", id: nil %>
          <% end %>
          <%= hidden_field_tag "cookie_consent[necessary]", "true", id: nil %>
          <button type="submit"
                  class="inline-flex items-center justify-center rounded-xl border border-content/20 bg-surface-muted px-4 py-2.5 text-sm font-semibold text-content transition hover:bg-border">
            <%= t("cookie_consent.banner.reject") %>
          </button>
        <% end %>

        <%= form_with url: cookie_consent_path, method: :post, class: "contents" do |form| %>
          <% CookieConsent::CATEGORIES.each do |category| %>
            <%= hidden_field_tag "cookie_consent[#{category}]", "true", id: nil %>
          <% end %>
          <button type="submit" class="btn-primary">
            <%= t("cookie_consent.banner.accept") %>
          </button>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div data-cookie-consent-target="modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="cookie-consent-title"
     data-action="keydown->cookie_consent#trapTab click->cookie_consent#backdrop"
     class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/70 p-4">
  <div class="max-h-[85vh] w-full max-w-lg overflow-y-auto rounded-3xl border border-border bg-surface p-6 shadow-2xl">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="cookie-consent-title" class="text-xl font-extrabold tracking-tight"><%= t("cookie_consent.modal.title") %></h2>
        <p class="mt-1 text-sm leading-relaxed text-muted"><%= t("cookie_consent.modal.description") %></p>
      </div>
      <button type="button" data-action="cookie_consent#close" class="icon-button shrink-0" aria-label="<%= t("cookie_consent.modal.close") %>">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <%= form_with url: cookie_consent_path, method: :post, class: "mt-5 space-y-3" do |form| %>
      <label class="flex items-start gap-3 rounded-2xl border border-border bg-surface-muted/60 p-4">
        <input type="checkbox" checked disabled class="mt-1 h-4 w-4 rounded border-border text-primary-600">
        <span>
          <span class="flex items-center gap-2 text-sm font-semibold"><%= t("cookie_consent.categories.necessary.title") %><span class="rounded-full bg-surface px-2 py-0.5 text-[11px] text-muted"><%= t("cookie_consent.categories.always") %></span></span>
          <span class="mt-1 block text-xs leading-relaxed text-muted"><%= t("cookie_consent.categories.necessary.description") %></span>
        </span>
      </label>

      <% %w[preferences analytics marketing].each do |category| %>
        <label class="flex items-start gap-3 rounded-2xl border border-border p-4">
          <%= check_box_tag "cookie_consent[#{category}]", "true", cookie_consent_categories[category],
                            id: "cookie-consent-#{category}",
                            class: "mt-1 h-4 w-4 rounded border-border text-primary-600" %>
          <span>
            <span class="block text-sm font-semibold"><%= t("cookie_consent.categories.#{category}.title") %></span>
            <span class="mt-1 block text-xs leading-relaxed text-muted"><%= t("cookie_consent.categories.#{category}.description") %></span>
          </span>
        </label>
      <% end %>

      <div class="flex flex-col gap-2 pt-2 sm:flex-row sm:justify-end">
        <button type="button" data-action="cookie_consent#close" class="inline-flex items-center justify-center rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-content transition hover:bg-surface-muted">
          <%= t("cookie_consent.modal.cancel") %>
        </button>
        <button type="submit" class="btn-primary"><%= t("cookie_consent.modal.save") %></button>
      </div>
    <% end %>
  </div>
</div>
