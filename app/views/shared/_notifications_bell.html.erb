<% I18n.with_locale(local_assigns.fetch(:locale, I18n.locale)) do %>
  <% unread_count = Notification.unread_count_for(user) %>
  <% recent_notifications = Notification.where(recipient_id: user.id).includes(:notifiable).latest.to_a %>
  <div id="notifications-bell" data-controller="dropdown" class="relative">
    <button type="button"
            data-dropdown-target="trigger"
            data-action="dropdown#toggle keydown->dropdown#triggerKeydown"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="<%= t("notifications.bell.label") %>"
            class="icon-button relative">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M10 21h4" stroke-linecap="round"></path>
      </svg>
      <% if unread_count.positive? %>
        <span class="absolute -right-0.5 -top-0.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-accent px-1 text-[11px] font-bold leading-none text-on-accent" aria-hidden="true">
          <%= unread_count > 9 ? "9+" : unread_count %>
        </span>
        <span class="sr-only"><%= t("notifications.bell.unread_count", count: unread_count) %></span>
      <% end %>
    </button>

    <div data-dropdown-target="menu"
         role="menu"
         aria-label="<%= t("notifications.bell.label") %>"
         class="absolute right-0 z-50 mt-2 hidden w-80 max-w-[calc(100vw-2rem)] overflow-hidden rounded-xl border border-border bg-surface shadow-xl">
      <div class="flex items-center justify-between gap-2 border-b border-border px-3 py-2">
        <p class="text-sm font-bold text-content"><%= t("notifications.bell.title") %></p>
        <%= link_to t("notifications.bell.view_all"),
                    notifications_path,
                    role: "menuitem",
                    class: "text-xs font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
      </div>

      <% if recent_notifications.any? %>
        <ul class="max-h-80 divide-y divide-border overflow-y-auto">
          <% recent_notifications.each do |notification| %>
            <li>
              <%= link_to notification_path(notification),
                          role: "menuitem",
                          class: "flex items-start gap-2 px-3 py-2.5 transition hover:bg-surface-muted" do %>
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full <%= notification_unread?(notification) ? "bg-accent" : "bg-transparent" %>" aria-hidden="true"></span>
                <span class="min-w-0">
                  <span class="line-clamp-2 block text-xs font-medium text-content"><%= notification_message(notification) %></span>
                  <span class="mt-0.5 block text-[11px] text-muted"><%= l(notification.created_at, format: :short) %></span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-3 py-6 text-center text-xs text-muted"><%= t("notifications.bell.empty") %></p>
      <% end %>

      <% if unread_count.positive? %>
        <div class="border-t border-border p-2">
          <%= button_to t("notifications.bell.mark_all_read"),
                        notification_read_path,
                        role: "menuitem",
                        class: "w-full rounded-lg px-3 py-2 text-left text-xs font-semibold text-content transition hover:bg-surface-muted" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
