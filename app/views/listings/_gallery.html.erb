<% photos = listing.photos.select { |photo| photo.image.attached? } %>
<div data-controller="gallery"
     data-gallery-counter-template-value="<%= t("listings.show.gallery.counter_template") %>"
     data-action="touchstart->gallery#touchStart touchend->gallery#touchEnd"
     tabindex="0"
     class="space-y-3 rounded-2xl focus:outline-none">
  <% if photos.any? %>
    <% primary = photos.first %>
    <% primary_image = primary.image %>
    <div class="relative overflow-hidden rounded-2xl border border-border bg-surface-muted">
      <button type="button"
              data-action="gallery#openLightbox"
              class="block w-full"
              aria-label="<%= t("listings.show.gallery.open") %>">
        <%= image_tag url_for(primary_image.variant(:large)),
                      srcset: "#{url_for(primary_image.variant(:card))} 640w, #{url_for(primary_image.variant(:large))} 1600w",
                      sizes: "(min-width: 1024px) 60vw, 100vw",
                      width: 1600,
                      height: 1200,
                      alt: listing.title,
                      data: { gallery_target: "main" },
                      class: "aspect-[4/3] h-auto w-full object-cover" %>
      </button>

      <% if photos.size > 1 %>
        <button type="button"
                data-action="gallery#previous"
                aria-label="<%= t("listings.show.gallery.previous") %>"
                class="absolute left-3 top-1/2 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border/70 bg-surface/90 text-content shadow-md backdrop-blur transition hover:bg-surface">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button"
                data-action="gallery#next"
                aria-label="<%= t("listings.show.gallery.next") %>"
                class="absolute right-3 top-1/2 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border/70 bg-surface/90 text-content shadow-md backdrop-blur transition hover:bg-surface">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      <% end %>

      <span class="absolute bottom-3 right-3 rounded-full bg-slate-950/70 px-2.5 py-1 text-xs font-semibold text-white">
        <span data-gallery-target="counter" aria-live="polite"><%= t("listings.show.gallery.counter", current: 1, total: photos.size) %></span>
      </span>
    </div>

    <% if photos.size > 1 %>
      <ul class="flex gap-2 overflow-x-auto pb-1">
        <% photos.each_with_index do |photo, index| %>
          <li>
            <button type="button"
                    data-gallery-target="thumb"
                    data-index="<%= index %>"
                    data-action="gallery#select"
                    data-large="<%= url_for(photo.image.variant(:large)) %>"
                    data-srcset="<%= url_for(photo.image.variant(:card)) %> 640w, <%= url_for(photo.image.variant(:large)) %> 1600w"
                    data-alt="<%= listing.title %>"
                    aria-label="<%= t("listings.show.gallery.show_photo", number: index + 1) %>"
                    class="h-16 w-16 overflow-hidden rounded-xl border-2 <%= index.zero? ? "border-primary-600" : "border-transparent hover:border-primary-300" %>">
              <%= image_tag url_for(photo.image.variant(:thumb)),
                            width: 320,
                            height: 320,
                            loading: "lazy",
                            alt: "",
                            class: "h-full w-full object-cover" %>
            </button>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <div class="flex aspect-[4/3] w-full items-center justify-center rounded-2xl border border-border bg-surface-muted text-muted">
      <div class="text-center">
        <svg class="mx-auto h-12 w-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m4 17 5-5 4 4 3-3 4 4" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="9" cy="9.5" r="1.2"></circle>
        </svg>
        <p class="mt-2 text-sm"><%= t("listings.show.gallery.empty") %></p>
      </div>
    </div>
  <% end %>

  <div data-gallery-target="lightbox"
       data-action="click->gallery#lightboxClick"
       class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/95 p-4">
    <div class="relative max-h-full w-full max-w-5xl">
      <button type="button"
              data-action="gallery#closeLightbox"
              aria-label="<%= t("listings.show.gallery.close") %>"
              class="absolute -top-12 right-0 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
        </svg>
      </button>

      <img data-gallery-target="lightboxImage"
           alt="<%= listing.title %>"
           class="mx-auto max-h-[80vh] w-auto rounded-xl object-contain">

      <div class="mt-3 flex items-center justify-center gap-4">
        <button type="button" data-action="gallery#previous" aria-label="<%= t("listings.show.gallery.previous") %>"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <span class="text-sm font-semibold text-white" data-gallery-target="lightboxCounter" aria-live="polite"></span>
        <button type="button" data-action="gallery#next" aria-label="<%= t("listings.show.gallery.next") %>"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
