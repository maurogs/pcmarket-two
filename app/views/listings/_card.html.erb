<% eager = local_assigns.fetch(:eager, false) %>
<div class="group relative h-full">
  <% cache [ listing, I18n.locale, eager ] do %>
    <% photo = listing.primary_photo %>
    <% labels = product_labels(listing) %>
    <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg">
      <div class="relative aspect-[4/3] overflow-hidden bg-surface-muted">
        <%= link_to listing_path(listing), class: "block h-full w-full", tabindex: "-1", aria: { hidden: "true" } do %>
          <% if photo&.image&.attached? %>
            <%= image_tag url_for(photo.image.variant(:card)),
                          alt: "",
                          width: 640,
                          height: 480,
                          loading: eager ? "eager" : "lazy",
                          fetchpriority: (eager ? "high" : nil),
                          class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" %>
          <% else %>
            <div class="flex h-full w-full items-center justify-center text-muted">
              <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m4 17 5-5 4 4 3-3 4 4" stroke-linecap="round" stroke-linejoin="round"></path>
                <circle cx="9" cy="9.5" r="1.2"></circle>
              </svg>
            </div>
          <% end %>
        <% end %>

        <div class="absolute left-3 top-3 flex flex-col items-start gap-1">
          <% if labels.any? %>
            <span class="inline-flex items-center rounded-full bg-primary-600 px-2 py-0.5 text-[11px] font-semibold text-white shadow-sm">
              <%= labels.first.name %>
            </span>
          <% end %>
          <% if listing.discount_percent %>
            <span class="inline-flex items-center rounded-full bg-accent px-2 py-0.5 text-[11px] font-bold text-on-accent shadow-sm">
              -<%= listing.discount_percent %>%
            </span>
          <% end %>
        </div>
      </div>

      <div class="flex flex-1 flex-col gap-2 p-4">
        <h2 class="text-sm font-semibold leading-snug text-content">
          <%= link_to listing.title, listing_path(listing), class: "line-clamp-2 transition hover:text-primary-700 dark:hover:text-primary-300" %>
        </h2>

        <% specs = card_specs(listing) %>
        <% if specs.any? %>
          <ul class="space-y-0.5 text-xs text-muted">
            <% specs.each do |spec| %>
              <li class="flex gap-1">
                <span class="shrink-0 text-muted/80"><%= spec[:label] %>:</span>
                <span class="line-clamp-1"><%= spec[:value] %></span>
              </li>
            <% end %>
          </ul>
        <% end %>

        <div class="mt-auto space-y-2 pt-1">
          <div class="flex items-baseline gap-2">
            <span class="text-lg font-extrabold tracking-tight text-content"><%= money(listing.price_cents, currency: listing.currency) %></span>
            <% if listing.compare_at_price_cents.present? && listing.compare_at_price_cents > listing.price_cents %>
              <span class="text-xs text-muted line-through"><%= money(listing.compare_at_price_cents, currency: listing.currency) %></span>
            <% end %>
          </div>

          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
            <span><%= condition_label(listing.condition) %></span>
            <span aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke-linecap="round" stroke-linejoin="round"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
              <%= location_label(listing) %>
            </span>
          </div>

          <div class="flex items-center justify-between gap-2 border-t border-border pt-2">
            <span class="inline-flex min-w-0 items-center gap-1 text-xs font-medium text-content">
              <span class="truncate"><%= listing.store.name %></span>
              <% if listing.store.verified? %>
                <svg class="h-3.5 w-3.5 shrink-0 text-primary-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.5 14.7 5l3.6-.2.6 3.6 3 2-1.7 3.2 1.7 3.2-3 2-.6 3.6-3.6-.2L12 21.5 9.3 19l-3.6.2-.6-3.6-3-2 1.7-3.2L2.1 7.2l3-2 .6-3.6L9.3 2 12 2.5Z"></path>
                  <path d="m8.6 12 2.2 2.2 4.6-4.6" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="sr-only"><%= t("listings.card.verified_seller") %></span>
              <% end %>
            </span>
            <% if listing.free_shipping? %>
              <span class="shrink-0 rounded-full bg-success-soft px-2 py-0.5 text-[11px] font-semibold text-success">
                <%= t("listings.card.free_shipping") %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </article>
  <% end %>
  <div class="absolute right-3 top-3">
    <%= render "favourites/button", listing: listing, favourited: favourited?(listing) %>
  </div>
</div>
