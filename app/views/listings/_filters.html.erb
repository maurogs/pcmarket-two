<div class="space-y-5">
  <div>
    <label for="<%= id_prefix %>_q" class="text-xs font-semibold uppercase tracking-widest text-muted">
      <%= t("listings.filters.text_label") %>
    </label>
    <div class="relative mt-1.5">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-muted">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
      </span>
      <%= search_field_tag :q,
                           @search.query,
                           id: "#{id_prefix}_q",
                           placeholder: t("listings.filters.text_placeholder"),
                           autocomplete: "off",
                           class: "field pl-10",
                           data: { action: "input->filters#debouncedSubmit" } %>
    </div>
  </div>

  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("listings.filters.price") %></p>
    <div class="mt-1.5 grid grid-cols-2 gap-2">
      <div class="relative">
        <label for="<%= id_prefix %>_min_price" class="sr-only"><%= t("listings.filters.min_price") %></label>
        <%= number_field_tag :min_price,
                             @search.min_price,
                             id: "#{id_prefix}_min_price",
                             min: 0,
                             step: 0.01,
                             placeholder: t("listings.filters.min_price"),
                             class: "field pr-8",
                             data: { action: "input->filters#debouncedSubmit" } %>
        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-muted">€</span>
      </div>
      <div class="relative">
        <label for="<%= id_prefix %>_max_price" class="sr-only"><%= t("listings.filters.max_price") %></label>
        <%= number_field_tag :max_price,
                             @search.max_price,
                             id: "#{id_prefix}_max_price",
                             min: 0,
                             step: 0.01,
                             placeholder: t("listings.filters.max_price"),
                             class: "field pr-8",
                             data: { action: "input->filters#debouncedSubmit" } %>
        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-muted">€</span>
      </div>
    </div>
  </div>

  <fieldset>
    <legend class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("listings.filters.condition") %></legend>
    <div class="mt-1.5 space-y-1">
      <% Listing.conditions.each_key do |condition| %>
        <% count = @search.facets[:conditions][condition].to_i %>
        <% checked = @search.selected_conditions.include?(condition) %>
        <% disabled = count.zero? && !checked %>
        <label class="flex items-center gap-2 rounded-lg px-1 py-1 text-sm <%= disabled ? "cursor-not-allowed opacity-45" : "cursor-pointer hover:text-primary-700 dark:hover:text-primary-300" %>">
          <%= check_box_tag "condition[]",
                            condition,
                            checked,
                            id: "#{id_prefix}_condition_#{condition}",
                            disabled: disabled,
                            class: "h-4 w-4 rounded border-border text-primary-600 focus:ring-primary-500",
                            data: { action: "change->filters#submit" } %>
          <span class="flex-1"><%= condition_label(condition) %></span>
          <span class="text-xs tabular-nums text-muted"><%= count %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <% @search.filterable_definitions.select(&:select_type?).each do |definition| %>
    <% selected = Array(@search.selected_specs[definition.key]) %>
    <% options = definition.attribute_options.select(&:active?) %>
    <% popular = options.select(&:popular?) %>
    <% visible = popular.any? ? (popular + options.select { |option| selected.include?(option.value) }).uniq : options %>
    <% rest = options - visible %>
    <details class="group border-t border-border pt-3" <%= "open" if selected.any? %>>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-xs font-semibold uppercase tracking-widest text-muted [&::-webkit-details-marker]:hidden">
        <span><%= definition.name %></span>
        <svg class="h-3.5 w-3.5 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </summary>
      <div class="mt-2 space-y-1">
        <% visible.each do |option| %>
          <%= render "listings/filter_option", definition: definition, option: option, id_prefix: id_prefix %>
        <% end %>
      </div>
      <% if rest.any? %>
        <details class="mt-1">
          <summary class="cursor-pointer list-none rounded-lg px-1 py-1 text-xs font-semibold text-primary-700 hover:underline dark:text-primary-300 [&::-webkit-details-marker]:hidden">
            <%= t("listings.filters.show_more", count: rest.size) %>
          </summary>
          <div class="mt-1 space-y-1">
            <% rest.each do |option| %>
              <%= render "listings/filter_option", definition: definition, option: option, id_prefix: id_prefix %>
            <% end %>
          </div>
        </details>
      <% end %>
    </details>
  <% end %>

  <% if @search.product_labels.any? %>
    <fieldset class="border-t border-border pt-3">
      <legend class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("listings.filters.product_labels") %></legend>
      <div class="mt-1.5 space-y-1">
        <% @search.product_labels.each do |tag| %>
          <label class="flex cursor-pointer items-center gap-2 rounded-lg px-1 py-1 text-sm hover:text-primary-700 dark:hover:text-primary-300">
            <%= check_box_tag "tags[]",
                              tag.slug,
                              @search.selected_tags.any? { |selected| selected.id == tag.id },
                              id: "#{id_prefix}_tag_#{tag.id}",
                              class: "h-4 w-4 rounded border-border text-primary-600 focus:ring-primary-500",
                              data: { action: "change->filters#submit" } %>
            <span><%= tag.name %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <% if @search.seller_tags.any? %>
    <fieldset class="border-t border-border pt-3">
      <legend class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("listings.filters.seller_tags") %></legend>
      <div class="mt-1.5 space-y-1">
        <% @search.seller_tags.each do |tag| %>
          <label class="flex cursor-pointer items-center gap-2 rounded-lg px-1 py-1 text-sm hover:text-primary-700 dark:hover:text-primary-300">
            <%= check_box_tag "tags[]",
                              tag.slug,
                              @search.selected_tags.any? { |selected| selected.id == tag.id },
                              id: "#{id_prefix}_tag_#{tag.id}",
                              class: "h-4 w-4 rounded border-border text-primary-600 focus:ring-primary-500",
                              data: { action: "change->filters#submit" } %>
            <span><%= tag.name %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <fieldset class="border-t border-border pt-3">
    <legend class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("listings.filters.delivery") %></legend>
    <label class="mt-1.5 flex cursor-pointer items-center gap-2 rounded-lg px-1 py-1 text-sm hover:text-primary-700 dark:hover:text-primary-300">
      <%= check_box_tag :free_shipping,
                        "1",
                        @search.free_shipping,
                        id: "#{id_prefix}_free_shipping",
                        class: "h-4 w-4 rounded border-border text-primary-600 focus:ring-primary-500",
                        data: { action: "change->filters#submit" } %>
      <span><%= t("listings.filters.free_shipping") %></span>
    </label>
  </fieldset>

  <div class="border-t border-border pt-3">
    <label for="<%= id_prefix %>_region" class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("listings.filters.region") %></label>
    <%= select_tag :region,
                   options_from_collection_for_select(@search.regions, :id, :name, @search.selected_region&.id),
                   include_blank: t("listings.filters.all_regions"),
                   id: "#{id_prefix}_region",
                   class: "field mt-1.5 text-sm",
                   data: { action: "change->filters#submit" } %>
  </div>

  <noscript>
    <button type="submit" class="btn-primary w-full"><%= t("listings.filters.apply") %></button>
  </noscript>
</div>
