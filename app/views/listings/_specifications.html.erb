<% groups = specification_groups(listing) %>
<section id="specifications" class="rounded-2xl border border-border bg-surface p-6">
  <h2 class="text-lg font-bold"><%= t("listings.show.specifications.title") %></h2>

  <% if groups.any? %>
    <div class="mt-4 space-y-6">
      <% groups.each do |group, rows| %>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-muted"><%= group %></h3>
          <dl class="mt-2 divide-y divide-border overflow-hidden rounded-xl border border-border">
            <% rows.each do |row| %>
              <div class="grid grid-cols-2 gap-4 px-4 py-2.5 text-sm odd:bg-surface-muted/60">
                <dt class="text-muted"><%= row[:definition].name %></dt>
                <dd class="font-medium text-content"><%= row[:value] %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-muted"><%= t("listings.show.specifications.empty") %></p>
  <% end %>
</section>
