<% set_meta_tags(title: t("legal_pages.versions.title", title: @page.title), noindex: true) %>
<% breadcrumbs = [ [ t("nav.home"), root_path ], [ t("legal_pages.public.index_title"), legal_pages_path ], [ @page.title, legal_page_path(kind: @page.kind) ], [ t("legal_pages.versions.title", title: @page.title), nil ] ] %>

<div class="space-y-8">
  <%= render "listings/breadcrumbs", trail: breadcrumbs %>

  <header class="max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight"><%= t("legal_pages.versions.title", title: @page.title) %></h1>
    <p class="mt-2 text-sm leading-relaxed text-muted"><%= t("legal_pages.versions.description") %></p>
  </header>

  <ol class="space-y-3">
    <% @versions.each do |version| %>
      <li class="rounded-2xl border border-border bg-surface p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="text-sm font-bold"><%= t("legal_pages.public.version", version: version.version) %></p>
            <p class="mt-1 text-xs text-muted"><%= t("legal_pages.public.effective_from") %> <%= legal_page_date(version) %></p>
          </div>
          <div class="flex items-center gap-2">
            <% if version.id == @page.id %>
              <span class="rounded-full bg-success-soft px-2.5 py-1 text-xs font-semibold text-success"><%= t("legal_pages.versions.current") %></span>
            <% end %>
            <%= link_to t("legal_pages.versions.open"), legal_page_path(kind: version.kind),
                        class: "text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
          </div>
        </div>
      </li>
    <% end %>
  </ol>

  <%= link_to t("legal_pages.versions.back"), legal_page_path(kind: @page.kind),
              class: "inline-flex text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
</div>
