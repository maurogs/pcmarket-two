<!DOCTYPE html>
<html lang="<%= @locale || I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= message.subject %></title>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f4f6fb; color: #0f172a; font-family: Inter, Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f6fb; padding: 24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto;">
            <tr>
              <td style="padding: 0 24px 16px; text-align: center;">
                <p style="margin: 0; font-size: 20px; font-weight: 800; color: #312e81;"><%= t("app.name") %></p>
                <p style="margin: 4px 0 0; font-size: 13px; color: #52607a;"><%= t("app.tagline") %></p>
              </td>
            </tr>
            <tr>
              <td style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 32px 28px;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding: 20px 24px; text-align: center; font-size: 12px; line-height: 1.6; color: #52607a;">
                <p style="margin: 0;"><%= t("alert_mailer.footer.reason", app: t("app.name")) %></p>
                <% if @unsubscribe_url.present? %>
                  <p style="margin: 4px 0 0;">
                    <a href="<%= @unsubscribe_url %>" style="color: #4f46e5; text-decoration: underline;">
                      <%= t("alert_mailer.footer.unsubscribe") %>
                    </a>
                  </p>
                <% end %>
                <p style="margin: 4px 0 0;"><%= t("alert_mailer.footer.signature", app: t("app.name")) %></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
