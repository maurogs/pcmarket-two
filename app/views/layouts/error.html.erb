<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f6fb" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#080d18" media="(prefers-color-scheme: dark)">
    <title><%= content_for?(:title) ? yield(:title) : t("errors.pages.not_found.title") %> · <%= t("app.name") %></title>
    <%= stylesheet_link_tag :app %>
    <script nonce="<%= content_security_policy_nonce %>">
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (error) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-content">
    <main class="mx-auto flex min-h-screen w-full max-w-2xl flex-col items-center justify-center px-6 py-16 text-center">
      <a href="<%= root_path %>" class="flex items-center gap-2" aria-label="<%= t("nav.home") %>">
        <svg class="h-10 w-10" viewBox="0 0 36 36" aria-hidden="true">
          <rect width="36" height="36" rx="11" class="fill-primary-600"></rect>
          <path d="M11 25V11h7.4a4.6 4.6 0 0 1 0 9.2H15.8" fill="none" stroke="white" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="24.8" cy="24.4" r="2.4" class="fill-accent"></circle>
        </svg>
        <span class="text-xl font-extrabold tracking-tight"><%= t("app.name") %></span>
      </a>
      <%= yield %>
    </main>
  </body>
</html>
