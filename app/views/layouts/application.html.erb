<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-4 px-4 py-3">
        <%= link_to t("app.name"), root_path, class: "text-lg font-semibold" %>

        <form class="flex-1" role="search">
          <input type="search"
                 placeholder="<%= t("nav.search_placeholder") %>"
                 aria-label="<%= t("nav.search_placeholder") %>"
                 class="w-full rounded border border-gray-300 px-3 py-2 text-sm">
        </form>

        <nav class="flex flex-wrap items-center gap-3 text-sm">
          <%= link_to t("nav.sell"), "#" %>
          <%= link_to t("nav.wishlist"), "#" %>
          <%= link_to t("nav.cart"), "#" %>
          <%= link_to t("nav.notifications"), "#" %>
          <%= link_to t("nav.login"), "#" %>
          <%= link_to t("nav.logout"), "#" %>
        </nav>
      </div>

      <div class="mx-auto flex max-w-6xl flex-wrap gap-3 px-4 pb-3 text-sm text-gray-600">
        <% Localization::SUPPORTED_LOCALES.each do |locale| %>
          <%= link_to t("locale.names.#{locale}"), root_path(locale: locale) %>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-4 text-sm text-gray-600">
        <%= t("footer.copyright", year: Date.current.year) %>
      </div>
    </footer>
  </body>
</html>
