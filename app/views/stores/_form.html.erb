<%= form_with model: store, url: store_path, method: store.persisted? ? :patch : :post,
              data: { controller: "store-kind" }, class: "space-y-8" do |f| %>
  <%= render "shared/form_errors", object: store %>

  <section class="rounded-2xl border border-border bg-surface p-5 sm:p-6">
    <h2 class="text-lg font-bold"><%= t("stores.form.kind") %></h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <% Store.kinds.each_key do |kind| %>
        <label class="cursor-pointer rounded-2xl border border-border bg-surface-muted p-4 transition has-checked:border-primary-500 has-checked:bg-primary-50 has-checked:ring-2 has-checked:ring-primary-500/20 dark:has-checked:bg-primary-900/30">
          <span class="flex items-center gap-3">
            <%= f.radio_button :kind, kind,
                               class: "h-4 w-4 text-primary-600 focus:ring-primary-500",
                               data: { action: "change->store-kind#toggle" } %>
            <span class="text-sm font-semibold text-content"><%= t("stores.form.#{kind}") %></span>
          </span>
          <span class="mt-2 block pl-7 text-xs leading-relaxed text-muted"><%= t("stores.form.#{kind}_hint") %></span>
        </label>
      <% end %>
    </div>
  </section>

  <section class="space-y-5 rounded-2xl border border-border bg-surface p-5 sm:p-6">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :name, t("stores.form.name"), class: "text-sm font-semibold text-content" %>
        <%= f.text_field :name, required: true, maxlength: 60, class: "field mt-1.5" %>
        <p class="mt-1 text-xs text-muted"><%= t("stores.form.name_hint") %></p>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :description, t("stores.form.description"), class: "text-sm font-semibold text-content" %>
        <%= f.text_area :description, rows: 4, maxlength: 2000, class: "field mt-1.5" %>
        <p class="mt-1 text-xs text-muted"><%= t("stores.form.description_hint") %></p>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :logo, t("stores.form.logo"), class: "text-sm font-semibold text-content" %>
        <div class="mt-1.5 flex items-center gap-4">
          <% if store.logo.attached? %>
            <%= image_tag url_for(store.logo.variant(resize_to_limit: [ 96, 96 ], format: :webp)),
                          width: 96, height: 96, alt: store.name,
                          class: "h-16 w-16 rounded-xl object-cover" %>
          <% end %>
          <%= f.file_field :logo,
                           accept: Store::IMAGE_CONTENT_TYPES.join(","),
                           class: "block w-full text-sm text-muted file:mr-3 file:rounded-xl file:border-0 file:bg-primary-600 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-primary-700" %>
        </div>
        <p class="mt-1 text-xs text-muted"><%= t("stores.form.logo_hint") %></p>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :banner, t("stores.form.banner"), class: "text-sm font-semibold text-content" %>
        <div class="mt-1.5 flex items-center gap-4">
          <% if store.banner.attached? %>
            <%= image_tag url_for(store.banner.variant(resize_to_limit: [ 240, 120 ], format: :webp)),
                          width: 240, height: 120, alt: "",
                          class: "h-16 w-32 rounded-xl object-cover" %>
          <% end %>
          <%= f.file_field :banner,
                           accept: Store::IMAGE_CONTENT_TYPES.join(","),
                           class: "block w-full text-sm text-muted file:mr-3 file:rounded-xl file:border-0 file:bg-primary-600 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-primary-700" %>
        </div>
        <p class="mt-1 text-xs text-muted"><%= t("stores.form.banner_hint") %></p>
      </div>

      <div>
        <%= f.label :region_id, t("stores.form.province"), class: "text-sm font-semibold text-content" %>
        <%= f.collection_select :region_id, @regions, :id, :name,
                                { include_blank: t("stores.form.province_placeholder") },
                                { required: true, class: "field mt-1.5" } %>
        <p class="mt-1 text-xs text-muted"><%= t("stores.form.province_hint") %></p>
      </div>

      <div>
        <%= f.label :city, t("stores.form.city"), class: "text-sm font-semibold text-content" %>
        <%= f.text_field :city, required: true, placeholder: t("stores.form.city_placeholder"), class: "field mt-1.5" %>
      </div>
    </div>

    <%= f.hidden_field :country_code, value: "ES" %>
  </section>

  <section class="space-y-5 rounded-2xl border border-border bg-surface p-5 sm:p-6">
    <div>
      <h2 class="text-lg font-bold"><%= t("stores.form.policies_heading") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("stores.form.policies_hint") %></p>
    </div>

    <div>
      <%= f.label :return_policy, t("stores.form.return_policy"), class: "text-sm font-semibold text-content" %>
      <%= f.text_area :return_policy, rows: 3, maxlength: 2000, class: "field mt-1.5" %>
    </div>

    <div>
      <%= f.label :shipping_policy, t("stores.form.shipping_policy"), class: "text-sm font-semibold text-content" %>
      <%= f.text_area :shipping_policy, rows: 3, maxlength: 2000, class: "field mt-1.5" %>
    </div>

    <div class="max-w-xs">
      <%= f.label :handling_days, t("stores.form.handling_days"), class: "text-sm font-semibold text-content" %>
      <%= f.number_field :handling_days, min: 1, max: 10, class: "field mt-1.5" %>
      <p class="mt-1 text-xs text-muted"><%= t("stores.form.handling_days_hint") %></p>
    </div>
  </section>

  <section data-store-kind-target="business"
           class="space-y-5 rounded-2xl border border-border bg-surface p-5 sm:p-6">
    <div>
      <h2 class="text-lg font-bold"><%= t("stores.form.business_heading") %></h2>
      <p class="mt-2 rounded-xl bg-surface-muted p-3 text-sm leading-relaxed text-muted">
        <%= t("stores.form.business_intro") %>
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :legal_name, t("stores.form.legal_name"), class: "text-sm font-semibold text-content" %>
        <%= f.text_field :legal_name, class: "field mt-1.5" %>
      </div>

      <div>
        <%= f.label :tax_id, t("stores.form.tax_id"), class: "text-sm font-semibold text-content" %>
        <%= f.text_field :tax_id, class: "field mt-1.5 uppercase" %>
        <p class="mt-1 text-xs text-muted"><%= t("stores.form.tax_id_hint") %></p>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :address_line, t("stores.form.address_line"), class: "text-sm font-semibold text-content" %>
        <%= f.text_field :address_line, class: "field mt-1.5" %>
      </div>

      <div>
        <%= f.label :postal_code, t("stores.form.postal_code"), class: "text-sm font-semibold text-content" %>
        <%= f.text_field :postal_code, inputmode: "numeric", maxlength: 5, class: "field mt-1.5" %>
        <p class="mt-1 text-xs text-muted"><%= t("stores.form.postal_code_hint") %></p>
      </div>

      <div>
        <%= f.label :phone, t("stores.form.phone"), class: "text-sm font-semibold text-content" %>
        <%= f.telephone_field :phone, class: "field mt-1.5" %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :website, t("stores.form.website"), class: "text-sm font-semibold text-content" %>
        <%= f.url_field :website, placeholder: "https://", class: "field mt-1.5" %>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit store.persisted? ? t("stores.form.update") : t("stores.form.submit"),
                 class: "btn-primary" %>
    <%= link_to t("stores.form.cancel"), root_path,
                class: "inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-semibold text-muted transition hover:bg-surface-muted hover:text-content" %>
  </div>
<% end %>
