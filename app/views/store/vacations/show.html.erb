<% set_meta_tags(title: t("stores.vacation.title"), noindex: true) %>

<div class="mx-auto max-w-3xl space-y-6">
  <header>
    <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("account.menu.store.title") %></p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("stores.vacation.title") %></h1>
    <p class="mt-2 text-sm leading-relaxed text-muted"><%= t("stores.vacation.subtitle") %></p>
  </header>

  <%= render "stores/tabs" %>

  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <%= form_with model: @store, url: store_vacation_path, method: :patch, class: "space-y-5 rounded-2xl border border-border bg-surface p-5 sm:p-6" do |form| %>
      <%= render "shared/form_errors", object: @store %>

      <label class="flex items-start gap-3 rounded-xl border border-border bg-surface-muted p-4">
        <%= form.check_box :vacation_mode, class: "mt-0.5 h-4 w-4 rounded border-border text-primary-600" %>
        <span>
          <span class="block text-sm font-semibold text-content"><%= t("stores.vacation.enable") %></span>
          <span class="mt-1 block text-xs leading-relaxed text-muted"><%= t("stores.vacation.enable_hint") %></span>
        </span>
      </label>

      <div>
        <%= form.label :vacation_message, t("stores.vacation.message"), class: "block text-sm font-semibold text-content" %>
        <%= form.text_area :vacation_message, rows: 4, maxlength: 500, class: "field mt-1.5" %>
        <p class="mt-1 text-xs text-muted"><%= t("stores.vacation.message_hint") %></p>
      </div>

      <div class="max-w-xs">
        <%= form.label :vacation_until, t("stores.vacation.return_date"), class: "block text-sm font-semibold text-content" %>
        <%= form.date_field :vacation_until, min: Date.current, class: "field mt-1.5" %>
        <p class="mt-1 text-xs text-muted"><%= t("stores.vacation.return_date_hint") %></p>
      </div>

      <div class="flex justify-end">
        <%= form.submit t("stores.vacation.save"), class: "btn-primary" %>
      </div>
    <% end %>

    <aside class="rounded-2xl border border-border bg-surface p-5 text-sm">
      <h2 class="text-base font-bold"><%= t("stores.vacation.help_title") %></h2>
      <p class="mt-2 text-muted"><%= t("stores.vacation.help_body") %></p>
      <% if @store.vacation_active? %>
        <p class="mt-3 rounded-xl bg-warning-soft p-3 text-warning">
          <%= t("stores.vacation.status_on") %>
          <% if @store.vacation_until.present? %>
            <%= t("stores.vacation.status_until", date: l(@store.vacation_until, format: :long)) %>
          <% end %>
        </p>
      <% else %>
        <p class="mt-3 rounded-xl bg-success-soft p-3 text-success"><%= t("stores.vacation.status_off") %></p>
      <% end %>
    </aside>
  </div>
</div>
