<p style="margin: 0 0 12px; font-size: 16px; font-weight: 700;"><%= t("contact_mailer.notification.heading") %></p>
<p style="margin: 0 0 16px; font-size: 14px; line-height: 1.6;"><%= t("contact_mailer.notification.intro") %></p>

<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; font-size: 14px; line-height: 1.6;">
  <tr><td style="padding: 4px 0; font-weight: 600;"><%= t("contact.form.name") %></td><td style="padding: 4px 0;"><%= @contact_message.name %></td></tr>
  <tr><td style="padding: 4px 0; font-weight: 600;"><%= t("contact.form.email") %></td><td style="padding: 4px 0;"><%= @contact_message.email %></td></tr>
  <tr><td style="padding: 4px 0; font-weight: 600;"><%= t("contact.form.topic") %></td><td style="padding: 4px 0;"><%= t("contact.topics.#{@contact_message.topic}") %></td></tr>
  <tr><td style="padding: 4px 0; font-weight: 600;"><%= t("contact.form.order_number") %></td><td style="padding: 4px 0;"><%= @contact_message.order_number.presence || t("contact_mailer.notification.none") %></td></tr>
</table>

<p style="margin: 20px 0 6px; font-size: 14px; font-weight: 600;"><%= t("contact.form.message") %></p>
<p style="margin: 0; white-space: pre-line; font-size: 14px; line-height: 1.7;"><%= @contact_message.message %></p>
