<%= t("buyback_mailer.events.#{@event}.title", reference: @request.reference) %>

<%= t("buyback_mailer.events.#{@event}.body") %>

<%= t("buyback_mailer.details.reference") %>: <%= @request.reference %>
<%= t("buyback_mailer.details.component") %>: <%= @request.component_model %>
