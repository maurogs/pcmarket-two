<% cache ["home/styles", I18n.locale, Listing.search_cache_version], expires_in: 5.minutes do %>
  <% tiles = home.style_tiles %>
  <% if tiles.any? %>
    <section class="space-y-4" aria-labelledby="style-tiles-title">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <h2 id="style-tiles-title" class="text-2xl font-extrabold tracking-tight"><%= t("home.styles.title") %></h2>
          <p class="mt-1 text-sm text-muted"><%= t("home.styles.description") %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        <% tiles.each do |tile| %>
          <%= link_to tile[:path],
                      class: "group flex flex-col justify-between gap-6 rounded-2xl border border-border bg-surface p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md dark:hover:border-primary-700" do %>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary-50 text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <rect x="3" y="4" width="18" height="12" rx="2"></rect>
                <path d="M8 20h8M12 16v4" stroke-linecap="round"></path>
              </svg>
            </span>
            <span>
              <span class="block text-sm font-bold"><%= tile[:tag].name %></span>
              <span class="mt-1 block text-xs text-muted"><%= t("home.styles.count", count: tile[:count]) %></span>
            </span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
