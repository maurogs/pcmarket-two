<% cache ["home/rail", section, I18n.locale, Listing.search_cache_version], expires_in: 5.minutes do %>
  <% listings = home.public_send(section) %>
  <% if listings.any? %>
    <section aria-labelledby="rail-<%= section %>" data-controller="rail" class="space-y-3">
      <div class="flex items-end justify-between gap-3">
        <h2 id="rail-<%= section %>" class="text-xl font-extrabold tracking-tight sm:text-2xl"><%= t(title_key) %></h2>
        <%= link_to t("home.rails.view_all"), path,
                    class: "shrink-0 text-sm font-semibold text-primary-700 transition hover:text-primary-800 dark:text-primary-300 dark:hover:text-primary-200" %>
      </div>

      <div class="relative">
        <button type="button"
                data-rail-target="previous"
                data-action="rail#previous"
                aria-label="<%= t("home.rails.previous") %>"
                class="absolute -left-4 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-surface text-content shadow-lg transition hover:bg-surface-muted lg:flex">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <div data-rail-target="track"
             class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          <% listings.each do |listing| %>
            <div class="w-[15rem] shrink-0 snap-start sm:w-[17rem]">
              <%= render "listings/card", listing: listing, eager: false, sold: local_assigns.fetch(:sold, false) %>
            </div>
          <% end %>
        </div>

        <button type="button"
                data-rail-target="next"
                data-action="rail#next"
                aria-label="<%= t("home.rails.next") %>"
                class="absolute -right-4 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-surface text-content shadow-lg transition hover:bg-surface-muted lg:flex">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </section>
  <% end %>
<% end %>
