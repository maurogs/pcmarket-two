<% cache ["home/trust", I18n.locale, Listing.search_cache_version], expires_in: 5.minutes do %>
  <% reviews = home.testimonials %>
  <section class="space-y-8" aria-labelledby="trust-title">
    <% if reviews.any? %>
      <div>
        <h2 id="trust-title" class="text-2xl font-extrabold tracking-tight"><%= t("home.testimonials.title") %></h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <% reviews.each do |review| %>
            <figure class="flex h-full flex-col rounded-2xl border border-border bg-surface p-5 shadow-sm">
              <div class="flex items-center gap-1 text-warning" aria-label="<%= t("home.testimonials.rating", rating: review.rating) %>">
                <% review.rating.times do %>
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 3 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 9.8l6.5-.9L12 3Z"></path>
                  </svg>
                <% end %>
              </div>
              <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-content">
                “<%= truncate(review.body, length: 220) %>”
              </blockquote>
              <figcaption class="mt-4 flex items-center gap-3 border-t border-border pt-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary-50 text-sm font-bold text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">
                  <%= review.reviewer_name.to_s.first&.upcase.presence || "?" %>
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-sm font-semibold"><%= review.reviewer_name %></span>
                  <span class="block truncate text-xs text-muted"><%= link_to review.store.name, storefront_path(review.store), class: "hover:text-primary-700 dark:hover:text-primary-300" %></span>
                </span>
              </figcaption>
            </figure>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% [
           { key: "protection", icon: "shield" },
           { key: "payments", icon: "lock" },
           { key: "sellers", icon: "check" },
           { key: "support", icon: "chat" }
         ].each do |item| %>
        <div class="flex items-start gap-3 rounded-2xl border border-border bg-surface-muted/60 p-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-success-soft text-success">
            <% case item[:icon] %>
            <% when "shield" %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 3 5 6v6c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V6l-7-3Z" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            <% when "lock" %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                <path d="M8 10V7a4 4 0 1 1 8 0v3" stroke-linecap="round"></path>
              </svg>
            <% when "check" %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="m8 12 2.5 2.5L16 9" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            <% else %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5Z" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" stroke-linecap="round"></path>
              </svg>
            <% end %>
          </span>
          <span>
            <span class="block text-sm font-bold"><%= t("home.trust.#{item[:key]}.title") %></span>
            <span class="mt-1 block text-xs leading-relaxed text-muted"><%= t("home.trust.#{item[:key]}.description") %></span>
          </span>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
