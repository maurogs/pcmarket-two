<% set_meta_tags(title: t("checkout.title"), noindex: true) %>

<div class="space-y-6">
  <header>
    <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("checkout.eyebrow") %></p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("checkout.title") %></h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("checkout.subtitle") %></p>
  </header>

  <% if @errors.present? %>
    <div role="alert" class="rounded-xl border border-danger/30 bg-danger-soft px-4 py-3 text-sm text-danger">
      <p class="font-semibold"><%= t("checkout.errors.title") %></p>
      <ul class="mt-1 list-inside list-disc">
        <% @errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: checkout_path, method: :post, scope: nil, class: "grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]" do %>
    <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
    <% if @buy_now_listing_id.present? %>
      <%= hidden_field_tag :buy_now_listing_id, @buy_now_listing_id %>
    <% end %>

    <div class="space-y-4">
      <details open class="overflow-hidden rounded-2xl border border-border bg-surface">
        <summary class="cursor-pointer list-none px-5 py-4">
          <span class="flex items-center justify-between gap-3">
            <span class="text-base font-bold"><%= t("checkout.address.title") %></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("checkout.address.step") %></span>
          </span>
        </summary>
        <div class="space-y-4 border-t border-border px-5 py-4">
          <% unless user_signed_in? %>
            <div>
              <%= label_tag :email, t("checkout.address.email"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
              <%= email_field_tag :email, @checkout.email || params[:email], required: true, class: "field mt-1.5" %>
              <p class="mt-1 text-xs text-muted"><%= t("checkout.address.email_hint") %></p>
            </div>
          <% end %>

          <% if @addresses.any? %>
            <fieldset>
              <legend class="text-sm font-semibold"><%= t("checkout.address.saved") %></legend>
              <div class="mt-2 space-y-2">
                <% @addresses.each do |address| %>
                  <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-border bg-surface-muted p-3 text-sm">
                    <%= radio_button_tag :address_id, address.id, params[:address_id].to_s == address.id.to_s, class: "mt-1" %>
                    <span>
                      <span class="block font-semibold"><%= address.full_name %></span>
                      <span class="block text-muted"><%= address.line1 %><%= ", #{address.line2}" if address.line2.present? %></span>
                      <span class="block text-muted"><%= [ address.postal_code, address.city, address.province_name ].compact_blank.join(" · ") %></span>
                    </span>
                  </label>
                <% end %>
                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border p-3 text-sm">
                  <%= radio_button_tag :address_id, "", params[:address_id].blank?, class: "mt-0" %>
                  <span class="font-semibold"><%= t("checkout.address.use_new") %></span>
                </label>
              </div>
            </fieldset>
          <% end %>

          <fieldset>
            <legend class="text-sm font-semibold"><%= t("checkout.address.new_title") %></legend>
            <div class="mt-2 grid gap-3 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <%= label_tag "address_full_name", t("checkout.address.full_name"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= text_field_tag "address[full_name]", @address.full_name, class: "field mt-1.5" %>
              </div>
              <div class="sm:col-span-2">
                <%= label_tag "address_line1", t("checkout.address.line1"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= text_field_tag "address[line1]", @address.line1, class: "field mt-1.5" %>
              </div>
              <div class="sm:col-span-2">
                <%= label_tag "address_line2", t("checkout.address.line2"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= text_field_tag "address[line2]", @address.line2, class: "field mt-1.5" %>
              </div>
              <div>
                <%= label_tag "address_region_id", t("checkout.address.province"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= select_tag "address[region_id]",
                               options_from_collection_for_select(Region.for_country("ES").ordered, :id, :name, @address.region_id),
                               include_blank: t("checkout.address.choose_province"),
                               class: "field mt-1.5" %>
              </div>
              <div>
                <%= label_tag "address_city", t("checkout.address.city"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= text_field_tag "address[city]", @address.city, class: "field mt-1.5" %>
              </div>
              <div>
                <%= label_tag "address_postal_code", t("checkout.address.postal_code"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= text_field_tag "address[postal_code]", @address.postal_code, class: "field mt-1.5" %>
              </div>
              <div>
                <%= label_tag "address_phone", t("checkout.address.phone"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= telephone_field_tag "address[phone]", @address.phone, class: "field mt-1.5" %>
              </div>
              <div>
                <%= label_tag "address_country_code", t("checkout.address.country"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
                <%= select_tag "address[country_code]",
                               options_for_select([ [ t("countries.es"), "ES" ] ], @address.country_code.presence || "ES"),
                               class: "field mt-1.5" %>
              </div>
            </div>

            <% if user_signed_in? %>
              <label class="mt-3 inline-flex items-center gap-2 text-sm">
                <%= check_box_tag :save_address, "1", ActiveModel::Type::Boolean.new.cast(params[:save_address]), class: "h-4 w-4 rounded border-border text-primary-600" %>
                <span><%= t("checkout.address.save_address") %></span>
              </label>
            <% end %>
          </fieldset>
        </div>
      </details>

      <details open class="overflow-hidden rounded-2xl border border-border bg-surface">
        <summary class="cursor-pointer list-none px-5 py-4">
          <span class="flex items-center justify-between gap-3">
            <span class="text-base font-bold"><%= t("checkout.shipping.title") %></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("checkout.shipping.step") %></span>
          </span>
        </summary>
        <div class="space-y-5 border-t border-border px-5 py-4">
          <% @groups.each do |group| %>
            <% shipping_allowed = group.items.all? { |item| item.listing.shipping? || item.listing.shipping_and_pickup? } %>
            <% pickup_allowed = group.items.all? { |item| item.listing.local_pickup? || item.listing.shipping_and_pickup? } %>
            <% selected = params.dig(:fulfilment, group.store.id.to_s) || (shipping_allowed ? "shipping" : "local_pickup") %>
            <fieldset>
              <legend class="text-sm font-semibold"><%= group.store.name %></legend>
              <div class="mt-2 space-y-2 text-sm">
                <% if shipping_allowed %>
                  <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border p-3">
                    <%= radio_button_tag "fulfilment[#{group.store.id}]", "shipping", selected == "shipping" %>
                    <span class="flex-1"><%= t("checkout.shipping.shipping") %></span>
                    <span class="font-semibold"><%= group.shipping_cents.zero? ? t("checkout.shipping.free") : money(group.shipping_cents) %></span>
                  </label>
                <% end %>
                <% if pickup_allowed %>
                  <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border p-3">
                    <%= radio_button_tag "fulfilment[#{group.store.id}]", "local_pickup", selected == "local_pickup" %>
                    <span class="flex-1"><%= t("checkout.shipping.local_pickup") %></span>
                    <span class="font-semibold"><%= money(0) %></span>
                  </label>
                <% end %>
              </div>

              <p class="mt-3 rounded-xl bg-surface-muted p-3 text-xs leading-relaxed text-muted">
                <% if group.store.business? %>
                  <%= t("checkout.withdrawal.business") %>
                <% else %>
                  <%= t("checkout.withdrawal.private", days: Setting.get(:buyer_protection_days, 2).to_i) %>
                <% end %>
              </p>
            </fieldset>
          <% end %>
        </div>
      </details>

      <details open class="overflow-hidden rounded-2xl border border-border bg-surface">
        <summary class="cursor-pointer list-none px-5 py-4">
          <span class="flex items-center justify-between gap-3">
            <span class="text-base font-bold"><%= t("checkout.payment.title") %></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("checkout.payment.step") %></span>
          </span>
        </summary>
        <div class="space-y-4 border-t border-border px-5 py-4">
          <div class="rounded-xl border border-border bg-surface-muted p-4">
            <p class="text-sm font-semibold"><%= t("checkout.payment.fake_title") %></p>
            <p class="mt-1 text-xs text-muted"><%= t("checkout.payment.fake_body") %></p>
          </div>

          <div>
            <label for="discount_code" class="block text-xs font-semibold uppercase tracking-widest text-muted"><%= t("checkout.payment.discount") %></label>
            <div class="mt-1.5 flex gap-2">
              <input id="discount_code" type="text" disabled placeholder="<%= t("checkout.payment.discount_placeholder") %>" class="field cursor-not-allowed opacity-60">
              <button type="button" disabled class="btn-accent cursor-not-allowed opacity-60"><%= t("checkout.payment.apply") %></button>
            </div>
            <p class="mt-1 text-xs text-muted"><%= t("checkout.payment.coming_soon") %></p>
          </div>

          <label class="flex items-start gap-3 text-sm">
            <%= check_box_tag :terms_accepted, "1", ActiveModel::Type::Boolean.new.cast(params[:terms_accepted]), class: "mt-0.5 h-4 w-4 rounded border-border text-primary-600" %>
            <span><%= t("checkout.legal.accept") %></span>
          </label>
          <p class="text-xs leading-relaxed text-muted"><%= t("checkout.legal.notice") %></p>

          <button type="submit" class="btn-primary w-full"><%= t("checkout.payment.pay") %></button>
        </div>
      </details>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-lg font-bold"><%= t("checkout.summary.title") %></h2>
        <ul class="mt-3 space-y-2 text-sm">
          <% @groups.each do |group| %>
            <% group.items.each do |item| %>
              <li class="flex justify-between gap-3">
                <span class="text-muted"><%= item.listing.title %> × <%= item.quantity %></span>
                <span class="font-semibold"><%= money(item.line_total_cents, currency: item.listing.currency) %></span>
              </li>
            <% end %>
          <% end %>
        </ul>
        <dl class="mt-4 space-y-2 border-t border-border pt-3 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t("checkout.summary.subtotal") %></dt>
            <dd class="font-semibold"><%= money(@subtotal_cents) %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t("checkout.summary.shipping") %></dt>
            <dd class="font-semibold"><%= money(@shipping_cents) %></dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-border pt-2 text-base">
            <dt class="font-bold"><%= t("checkout.summary.total") %></dt>
            <dd class="font-extrabold"><%= money(@subtotal_cents + @shipping_cents) %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-2xl border border-primary-200 bg-primary-50 p-5 text-sm dark:border-primary-800 dark:bg-primary-900/30">
        <h2 class="text-sm font-bold text-primary-900 dark:text-primary-100"><%= t("checkout.protection.title") %></h2>
        <p class="mt-1.5 text-primary-800 dark:text-primary-200"><%= t("checkout.protection.body", days: Setting.get(:buyer_protection_days, 2).to_i) %></p>
      </section>
    </aside>
  <% end %>
</div>
