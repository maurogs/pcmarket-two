<% set_meta_tags(title: t("contact.meta.title"), description: t("contact.meta.description"), canonical: contact_messages_url) %>
<% breadcrumbs = [ [ t("nav.home"), root_path ], [ t("contact.title"), contact_messages_path ] ] %>

<div class="space-y-8">
  <%= render "listings/breadcrumbs", trail: breadcrumbs %>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="min-w-0">
      <header class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("contact.eyebrow") %></p>
        <h1 class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl"><%= t("contact.title") %></h1>
        <p class="mt-3 text-base leading-relaxed text-muted"><%= t("contact.subtitle") %></p>
      </header>

      <section class="mt-6 rounded-2xl border border-border bg-surface p-5 shadow-sm sm:p-6">
        <%= render "shared/form_errors", object: @contact_message %>

        <%= form_with model: @contact_message, url: contact_messages_path, method: :post, class: "mt-1 space-y-4" do |form| %>
          <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            <label for="contact-website"><%= t("contact.form.website") %></label>
            <%= text_field_tag :website, nil, id: "contact-website", tabindex: -1, autocomplete: "off" %>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :name, t("contact.form.name"), class: "block text-sm font-semibold" %>
              <%= form.text_field :name, required: true, autocomplete: "name", class: "field mt-1.5" %>
            </div>
            <div>
              <%= form.label :email, t("contact.form.email"), class: "block text-sm font-semibold" %>
              <%= form.email_field :email, required: true, autocomplete: "email", class: "field mt-1.5" %>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :topic, t("contact.form.topic"), class: "block text-sm font-semibold" %>
              <%= form.select :topic,
                              ContactMessage::TOPICS.map { |topic| [ t("contact.topics.#{topic}"), topic ] },
                              {},
                              class: "field mt-1.5" %>
            </div>
            <div>
              <%= form.label :order_number, t("contact.form.order_number"), class: "block text-sm font-semibold" %>
              <%= form.text_field :order_number, placeholder: t("contact.form.order_number_placeholder"), class: "field mt-1.5" %>
              <p class="mt-1 text-xs text-muted"><%= t("contact.form.order_number_hint") %></p>
            </div>
          </div>

          <div>
            <%= form.label :message, t("contact.form.message"), class: "block text-sm font-semibold" %>
            <%= form.text_area :message, rows: 7, required: true, maxlength: 5000, class: "field mt-1.5" %>
          </div>

          <p class="text-xs leading-relaxed text-muted"><%= t("contact.form.privacy_note") %></p>

          <%= form.submit t("contact.form.submit"), class: "btn-primary cursor-pointer" %>
        <% end %>
      </section>
    </div>

    <aside class="space-y-4">
      <section class="rounded-2xl border border-border bg-surface p-5 text-sm">
        <h2 class="text-base font-bold"><%= t("contact.aside.title") %></h2>
        <p class="mt-2 leading-relaxed text-muted"><%= t("contact.aside.body") %></p>
        <a href="mailto:<%= Setting.get(:support_email, 'support@pcmarket.example') %>" class="mt-3 inline-flex font-semibold text-primary-700 hover:underline dark:text-primary-300">
          <%= Setting.get(:support_email, "support@pcmarket.example") %>
        </a>
      </section>

      <section class="rounded-2xl border border-border bg-surface p-5 text-sm">
        <h2 class="text-base font-bold"><%= t("contact.aside.links_title") %></h2>
        <ul class="mt-3 space-y-2">
          <li><%= link_to t("help.index.title"), help_pages_path, class: "text-content transition hover:text-primary-700 dark:hover:text-primary-300" %></li>
          <li><%= link_to t("footer.about.trust_safety"), trust_path, class: "text-content transition hover:text-primary-700 dark:hover:text-primary-300" %></li>
          <li><%= link_to t("contact.aside.report"), new_report_path, class: "text-content transition hover:text-primary-700 dark:hover:text-primary-300" %></li>
        </ul>
      </section>
    </aside>
  </div>
</div>
