<% set_meta_tags(title: t("buyback.quote.offer_title"), noindex: true) %>

<div class="mx-auto max-w-2xl space-y-6">
  <header class="text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("buyback.quote.offer_eyebrow") %></p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("buyback.quote.offer_title") %></h1>
  </header>

  <div class="rounded-3xl border border-border bg-surface p-6 text-center sm:p-8">
    <p class="text-sm text-muted"><%= @quote.component_model %></p>
    <p class="mt-1 text-xs font-semibold uppercase tracking-widest text-muted"><%= buyback_condition_label(@quote.condition) %></p>
    <p class="mt-4 text-4xl font-extrabold tracking-tight text-primary-700 dark:text-primary-300"><%= money(@quote.offer_cents, currency: "EUR") %></p>

    <% if @quote.expired? %>
      <p class="mt-4 rounded-xl bg-warning-soft px-4 py-3 text-sm font-semibold text-warning"><%= t("buyback.quote.expired") %></p>
      <%= link_to t("buyback.quote.new_quote"), new_buyback_quote_path, class: "btn-primary mt-5" %>
    <% else %>
      <p class="mt-2 text-xs text-muted"><%= t("buyback.quote.valid_until", date: l(@quote.expires_at.to_date, format: :long)) %></p>
      <%= link_to t("buyback.quote.accept"), new_buyback_request_path(quote_id: @quote.token), class: "btn-primary mt-5" %>
      <p class="mt-2 text-xs text-muted"><%= t("buyback.quote.accept_hint") %></p>
    <% end %>
  </div>

  <div class="rounded-2xl border border-border bg-surface p-5">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("buyback.quote.summary_title") %></h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-muted"><%= t("buyback.details.condition") %></dt>
        <dd class="font-semibold"><%= buyback_condition_label(@quote.condition) %></dd>
      </div>
      <% [ [ "powers_on", t("buyback.quote.questions.powers_on") ], [ "artifacts", t("buyback.quote.questions.artifacts") ], [ "original_box", t("buyback.quote.questions.original_box") ], [ "physical_damage", t("buyback.quote.questions.physical_damage") ] ].each do |key, label| %>
        <% answer = ActiveModel::Type::Boolean.new.cast(@quote.answers.to_h[key]) %>
        <div class="flex justify-between gap-4">
          <dt class="text-muted"><%= label %></dt>
          <dd class="font-medium"><%= answer ? t("buyback.questions.yes") : t("buyback.questions.no") %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%= link_to t("buyback.quote.back"), sell_to_us_path, class: "block text-center text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
</div>
