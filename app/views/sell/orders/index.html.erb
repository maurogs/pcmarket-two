<% set_meta_tags(title: t("sales.index.title"), noindex: true) %>

<div class="space-y-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("sales.index.eyebrow") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("sales.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("sales.index.subtitle") %></p>
    </div>
    <p class="text-sm text-muted"><%= t("sales.index.count", count: @collection.orders.size) %></p>
  </header>

  <nav aria-label="<%= t("sales.index.filters_label") %>" class="overflow-x-auto">
    <ul class="flex min-w-max items-center gap-1.5">
      <% Sell::OrderCollection::TABS.each do |tab| %>
        <% current = @collection.tab == tab %>
        <li>
          <%= link_to sell_orders_path(status: tab),
                      aria: { current: ("page" if current) },
                      class: "inline-flex items-center rounded-full border px-3 py-1.5 text-sm font-medium transition #{current ? "border-primary-600 bg-primary-600 text-white" : "border-border bg-surface text-muted hover:border-primary-400 hover:text-primary-700 dark:hover:text-primary-300"}" do %>
            <%= tab == "all" ? t("sales.index.all") : order_status_label(tab) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <% if @collection.orders.any? %>
    <ul class="space-y-3">
      <% @collection.orders.each do |order| %>
        <li class="rounded-2xl border border-border bg-surface p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-muted"><%= l(order.created_at.to_date, format: :long) %></p>
              <h2 class="text-lg font-extrabold">
                <%= link_to order.number, sell_order_path(order), class: "hover:text-primary-700 dark:hover:text-primary-300" %>
              </h2>
              <p class="text-sm text-muted"><%= t("sales.index.items", count: order.items.sum(&:quantity)) %></p>
            </div>
            <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold <%= order_status_badge_class(order.status) %>">
              <%= order_status_label(order.status) %>
            </span>
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3 text-sm">
            <p class="text-muted"><%= t("sales.index.payout", amount: money(order.subtotal_cents - order.commission_cents, currency: order.currency)) %></p>
            <div class="flex items-center gap-3">
              <span class="font-bold"><%= money(order.total_cents, currency: order.currency) %></span>
              <%= link_to t("sales.index.view"), sell_order_path(order), class: "btn-accent" %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("sales.index.empty_title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("sales.index.empty_body") %></p>
    </div>
  <% end %>
</div>
