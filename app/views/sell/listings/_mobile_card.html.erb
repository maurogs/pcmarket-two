<article class="rounded-2xl border border-border bg-surface p-4">
  <div class="flex items-start gap-3">
    <input type="checkbox"
           name="bulk_archive[listing_ids][]"
           value="<%= listing.id %>"
           form="bulk-archive-form"
           aria-label="<%= t("sell.listings.bulk.select_listing", title: listing.title.presence || t("sell.listings.untitled")) %>"
           data-bulk-select-target="item"
           data-action="change->bulk_select#update"
           class="mt-1 h-4 w-4 shrink-0 rounded border-border text-primary-600">

    <%= render "sell/listings/thumbnail", listing: listing %>

    <div class="min-w-0 flex-1">
      <p class="font-semibold leading-snug text-content">
        <%= link_to listing.title.presence || t("sell.listings.untitled"),
                    listing_path(listing),
                    class: "transition hover:text-primary-700 dark:hover:text-primary-300" %>
      </p>
      <p class="truncate text-xs text-muted"><%= listing.category&.name %></p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold <%= status_badge_class(listing.status) %>">
          <%= status_label(listing) %>
        </span>
        <span class="text-sm font-bold text-content"><%= listing.price_cents ? money(listing.price_cents, currency: listing.currency) : "—" %></span>
      </div>
      <dl class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
        <div class="flex gap-1">
          <dt><%= t("sell.listings.table.views") %>:</dt>
          <dd><%= number_with_delimiter(listing.views_count) %></dd>
        </div>
        <div class="flex gap-1">
          <dt><%= t("sell.listings.table.favourites") %>:</dt>
          <dd><%= number_with_delimiter(listing.favorites_count) %></dd>
        </div>
        <div class="flex gap-1">
          <dt><%= t("sell.listings.table.updated") %>:</dt>
          <dd><%= short_date(listing.updated_at) %></dd>
        </div>
      </dl>
      <% if listing.rejected? && listing.rejection_reason.present? %>
        <p class="mt-2 text-xs text-danger">
          <%= t("sell.listings.rejected.reason", reason: listing.rejection_reason) %>
          <%= link_to t("sell.listings.rejected.resubmit"), edit_sell_listing_path(listing), class: "ml-1 font-semibold underline underline-offset-2" %>
        </p>
      <% end %>
    </div>
  </div>

  <div class="mt-3 border-t border-border pt-3">
    <%= render "sell/listings/actions", listing: listing %>
  </div>
</article>
