<%= form_with model: listing,
              url: sell_listing_path(listing),
              method: :patch,
              data: { turbo_frame: "listing_wizard" },
              class: "space-y-6" do |f| %>
  <%= hidden_field_tag :step, "details" %>

  <section class="space-y-5 rounded-2xl border border-border bg-surface p-5 sm:p-6">
    <div>
      <h2 class="text-xl font-bold"><%= t("sell.details.title") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("sell.details.subtitle") %></p>
    </div>

    <div data-controller="character-counter" data-character-counter-max-value="140">
      <div class="flex items-center justify-between gap-2">
        <%= f.label :title, t("sell.details.title_label"), class: "text-sm font-semibold text-content" %>
        <span class="text-xs tabular-nums text-muted" data-character-counter-target="output"></span>
      </div>
      <%= f.text_field :title,
                       maxlength: 140,
                       required: true,
                       placeholder: t("sell.details.title_placeholder"),
                       class: "field mt-1.5",
                       data: { character_counter_target: "input", action: "input->character-counter#update" } %>
    </div>

    <fieldset>
      <legend class="text-sm font-semibold text-content"><%= t("sell.details.condition_label") %></legend>
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        <% Listing.conditions.each_key do |condition| %>
          <label class="cursor-pointer rounded-2xl border border-border bg-surface-muted p-3 transition hover:border-primary-400 has-checked:border-primary-500 has-checked:bg-primary-50 has-checked:ring-2 has-checked:ring-primary-500/20 dark:has-checked:bg-primary-900/30">
            <span class="flex items-start gap-2">
              <%= f.radio_button :condition, condition,
                                 class: "mt-0.5 h-4 w-4 text-primary-600 focus:ring-primary-500" %>
              <span>
                <span class="block text-sm font-semibold text-content"><%= condition_title(condition) %></span>
                <span class="mt-0.5 block text-xs leading-relaxed text-muted"><%= condition_description(condition) %></span>
              </span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div data-controller="character-counter" data-character-counter-max-value="10000">
      <div class="flex items-center justify-between gap-2">
        <%= f.label :description, t("sell.details.description_label"), class: "text-sm font-semibold text-content" %>
        <span class="text-xs tabular-nums text-muted" data-character-counter-target="output"></span>
      </div>
      <%= f.text_area :description,
                      rows: 6,
                      maxlength: 10_000,
                      required: true,
                      placeholder: t("sell.details.description_placeholder"),
                      class: "field mt-1.5",
                      data: { character_counter_target: "input", action: "input->character-counter#update" } %>
    </div>
  </section>

  <% if attributes.any? %>
    <section class="rounded-2xl border border-border bg-surface p-5 sm:p-6">
      <h2 class="text-lg font-bold"><%= t("sell.details.attributes_title") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("sell.details.attributes_hint") %></p>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <% attributes.each do |category_attribute| %>
          <% definition = category_attribute.attribute_definition %>
          <% next unless definition.active? %>
          <% value = listing_spec_value(listing, definition) %>
          <% input_name = "listing[specs][#{definition.key}]" %>
          <% input_id = "spec_#{definition.key}" %>

          <div class="<%= "sm:col-span-2" if definition.multi_select? || definition.text? %>">
            <%= label_tag input_id, class: "flex items-center gap-1.5 text-sm font-semibold text-content" do %>
              <span><%= definition.name %></span>
              <% if category_attribute.required? %>
                <span class="text-danger" aria-hidden="true">*</span>
                <span class="sr-only"><%= t("sell.details.required") %></span>
              <% end %>
            <% end %>

            <% case definition.input_type %>
            <% when "single_select" %>
              <% options = definition.attribute_options.select(&:active?) %>
              <%= select_tag input_name,
                             options_from_collection_for_select(options, :value, :label, Array(value).first),
                             include_blank: t("sell.details.choose"),
                             id: input_id,
                             class: "field mt-1.5" %>
            <% when "multi_select" %>
              <div class="mt-2 grid gap-2 sm:grid-cols-2">
                <% definition.attribute_options.select(&:active?).each do |option| %>
                  <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-border bg-surface-muted px-3 py-2 text-sm has-checked:border-primary-500 has-checked:bg-primary-50 dark:has-checked:bg-primary-900/30">
                    <%= check_box_tag "#{input_name}[]", option.value, Array(value).map(&:to_s).include?(option.value),
                                      id: "#{input_id}_#{option.value}",
                                      class: "h-4 w-4 rounded border-border text-primary-600 focus:ring-primary-500" %>
                    <span><%= option.label %></span>
                  </label>
                <% end %>
              </div>
            <% when "number" %>
              <div class="relative mt-1.5">
                <%= number_field_tag input_name, value, step: "any", id: input_id,
                                     class: "field pr-16" %>
                <% if definition.unit.present? %>
                  <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs font-semibold text-muted"><%= definition.unit %></span>
                <% end %>
              </div>
            <% when "boolean" %>
              <div class="mt-1.5 flex items-center gap-3">
                <%= hidden_field_tag input_name, "false", id: nil %>
                <%= check_box_tag input_name, "true", value.to_s == "true",
                                  id: input_id,
                                  include_hidden: false,
                                  class: "h-5 w-5 rounded border-border text-primary-600 focus:ring-primary-500" %>
                <span class="text-sm text-muted"><%= t("sell.details.boolean_yes") %></span>
              </div>
            <% else %>
              <%= text_field_tag input_name, value, id: input_id, class: "field mt-1.5" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="rounded-2xl border border-border bg-surface p-5 sm:p-6">
    <h2 class="text-lg font-bold"><%= t("sell.details.tags_title") %></h2>
    <p class="mt-1 text-sm text-muted"><%= t("sell.details.tags_hint", max: Listing::MAX_SELLER_TAGS) %></p>

    <div class="mt-3 flex flex-wrap gap-2">
      <% seller_tag_ids = listing.seller_tag_ids %>
      <% seller_tags.each do |tag| %>
        <label class="flex cursor-pointer items-center gap-2 rounded-full border border-border bg-surface-muted px-3 py-1.5 text-sm has-checked:border-primary-500 has-checked:bg-primary-50 dark:has-checked:bg-primary-900/30">
          <%= check_box_tag "listing[seller_tag_ids][]", tag.id, seller_tag_ids.include?(tag.id),
                            id: "seller_tag_#{tag.id}",
                            class: "h-4 w-4 rounded border-border text-primary-600 focus:ring-primary-500" %>
          <span><%= tag.name %></span>
        </label>
      <% end %>
    </div>

    <p class="mt-3 text-xs text-muted"><%= t("sell.details.product_labels_note") %></p>
  </section>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= link_to t("sell.steps.back"),
                edit_sell_listing_path(listing, step: "photos"),
                class: "inline-flex items-center justify-center rounded-xl px-4 py-2.5 text-sm font-semibold text-muted transition hover:bg-surface-muted hover:text-content",
                data: { turbo_frame: "listing_wizard" } %>
    <button type="submit" class="btn-primary"><%= t("sell.steps.continue") %></button>
  </div>
<% end %>
