<% set_meta_tags(title: t("sell.listings.title"), noindex: true) %>

<div class="mx-auto max-w-7xl space-y-6" data-controller="bulk_select">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("nav.list_item") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("sell.listings.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("sell.listings.subtitle") %></p>
    </div>
    <%= link_to t("sell.listings.new_listing"), new_sell_listing_path, class: "btn-primary" %>
  </header>

  <nav aria-label="<%= t("sell.listings.tabs_label") %>" class="overflow-x-auto">
    <ul class="flex min-w-max items-center gap-1.5">
      <% Sell::ListingCollection::TABS.each do |tab| %>
        <% current = @collection.tab == tab %>
        <li>
          <%= link_to sell_listings_path(tab: tab, q: @collection.query),
                      aria: { current: ("page" if current) },
                      class: "inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm font-medium transition #{current ? "border-primary-600 bg-primary-600 text-white" : "border-border bg-surface text-muted hover:border-primary-400 hover:text-primary-700 dark:hover:text-primary-300"}" do %>
            <span><%= t("sell.listings.tabs.#{tab}") %></span>
            <span class="inline-flex min-w-5 items-center justify-center rounded-full px-1.5 py-0.5 text-[11px] font-bold leading-none <%= current ? "bg-white/20 text-white" : "bg-surface-muted text-content" %>">
              <%= @collection.count_for(tab) %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <%= form_with url: sell_listings_path,
                method: :get,
                scope: nil,
                class: "flex flex-wrap items-end gap-2 rounded-2xl border border-border bg-surface px-4 py-3" do %>
    <%= hidden_field_tag :tab, @collection.tab %>
    <div class="min-w-0 flex-1">
      <%= label_tag :q, t("sell.listings.search.label"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
      <%= search_field_tag :q,
                           @collection.query,
                           placeholder: t("sell.listings.search.placeholder"),
                           class: "field mt-1.5" %>
    </div>
    <%= submit_tag t("sell.listings.search.submit"), class: "btn-primary" %>
    <% if @collection.query.present? %>
      <%= link_to t("sell.listings.search.clear"), sell_listings_path(tab: @collection.tab), class: "btn-accent" %>
    <% end %>
  <% end %>

  <%= form_with url: bulk_archive_path,
                method: :post,
                scope: nil,
                id: "bulk-archive-form",
                class: "flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-border bg-surface px-4 py-3" do %>
    <%= hidden_field_tag :tab, @collection.tab %>
    <label class="inline-flex items-center gap-2 text-sm font-medium text-content">
      <input type="checkbox"
             data-bulk-select-target="all"
             data-action="change->bulk_select#toggleAll"
             class="h-4 w-4 rounded border-border text-primary-600">
      <span><%= t("sell.listings.bulk.select_all") %></span>
    </label>
    <%= submit_tag t("sell.listings.bulk.archive_selected"),
                   class: "btn-accent",
                   data: { turbo_confirm: t("sell.listings.bulk.confirm") } %>
  <% end %>

  <% if @collection.listings.any? %>
    <div class="hidden overflow-hidden rounded-2xl border border-border bg-surface md:block">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th scope="col" class="w-10 px-4 py-3">
              <span class="sr-only"><%= t("sell.listings.table.select") %></span>
            </th>
            <th scope="col" class="px-4 py-3"><%= t("sell.listings.table.listing") %></th>
            <th scope="col" class="px-4 py-3"><%= t("sell.listings.table.price") %></th>
            <th scope="col" class="px-4 py-3"><%= t("sell.listings.table.status") %></th>
            <th scope="col" class="px-4 py-3"><%= t("sell.listings.table.views") %></th>
            <th scope="col" class="px-4 py-3"><%= t("sell.listings.table.favourites") %></th>
            <th scope="col" class="px-4 py-3"><%= t("sell.listings.table.updated") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t("sell.listings.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <%= render partial: "sell/listings/listing_row", collection: @collection.listings, as: :listing %>
        </tbody>
      </table>
    </div>

    <div class="space-y-3 md:hidden">
      <%= render partial: "sell/listings/mobile_card", collection: @collection.listings, as: :listing %>
    </div>

    <%= pagy_nav(@collection.pagy) %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-50 text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </div>
      <h2 class="mt-4 text-lg font-bold"><%= t("sell.listings.empty.title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("sell.listings.empty.body") %></p>
      <div class="mt-5 flex justify-center">
        <%= link_to t("sell.listings.empty.cta"), new_sell_listing_path, class: "btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
