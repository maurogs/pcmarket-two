<div class="flex flex-wrap items-center justify-end gap-1.5">
  <%= link_to t("sell.listings.actions.edit"),
              edit_sell_listing_path(listing),
              class: "rounded-lg px-2 py-1 text-xs font-semibold text-content transition hover:bg-surface-muted" %>

  <% if listing.draft? %>
    <%= button_to t("sell.listings.actions.delete_draft"),
                  sell_listing_path(listing),
                  method: :delete,
                  form: { class: "inline" },
                  data: { turbo_confirm: t("sell.steps.confirm_delete") },
                  class: "rounded-lg px-2 py-1 text-xs font-semibold text-danger transition hover:bg-danger-soft" %>
  <% elsif listing.may_archive? %>
    <%= button_to t("sell.listings.actions.archive"),
                  sell_listing_path(listing),
                  method: :delete,
                  form: { class: "inline" },
                  data: { turbo_confirm: t("sell.steps.confirm_delete") },
                  class: "rounded-lg px-2 py-1 text-xs font-semibold text-danger transition hover:bg-danger-soft" %>
  <% end %>

  <% if listing.archived? %>
    <%= button_to t("sell.listings.actions.republish"),
                  sell_listing_republish_path(listing),
                  method: :post,
                  form: { class: "inline" },
                  class: "rounded-lg px-2 py-1 text-xs font-semibold text-primary-700 transition hover:bg-primary-50 dark:text-primary-300 dark:hover:bg-primary-900/40" %>
  <% end %>
</div>
