<nav aria-label="<%= t("sell.dashboard.nav_label") %>" class="space-y-4">
  <div class="rounded-2xl border border-border bg-surface p-3">
    <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-widest text-muted"><%= t("sell.dashboard.nav_heading") %></p>
    <ul class="space-y-1">
      <% sell_nav_items.each do |item| %>
        <% active = current_page?(item[:path]) %>
        <li>
          <%= link_to t("sell.dashboard.nav.#{item[:key]}"),
                      item[:path],
                      aria: { current: (active ? "page" : nil) },
                      class: sell_nav_item_classes(active) %>
        </li>
      <% end %>
    </ul>
  </div>

  <%= link_to t("sell.listings.new_listing"), new_sell_listing_path, class: "btn-primary w-full" %>
</nav>
