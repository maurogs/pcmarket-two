<% series = analytics.revenue_by_day %>
<% max = analytics_chart_max(series) %>
<% width = 640 %>
<% height = 180 %>
<% padding = 12 %>
<% plot_height = height - padding * 2 %>
<% gap = series.any? ? 2 : 0 %>
<% bar_width = series.any? ? [ (width - padding * 2 - gap * (series.size - 1)).to_f / series.size, 1 ].max : 0 %>

<figure class="rounded-2xl border border-border bg-surface p-5">
  <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-base font-bold"><%= t("sell.dashboard.chart.title") %></h2>
    <p class="text-xs text-muted"><%= t("sell.dashboard.chart.subtitle", count: analytics.range) %></p>
  </figcaption>

  <svg viewBox="0 0 <%= width %> <%= height %>"
       role="img"
       aria-labelledby="revenue-chart-title revenue-chart-desc"
       class="mt-4 h-48 w-full text-primary-500">
    <title id="revenue-chart-title"><%= t("sell.dashboard.chart.title") %></title>
    <desc id="revenue-chart-desc"><%= t("sell.dashboard.chart.description", count: analytics.range) %></desc>

    <line x1="<%= padding %>" y1="<%= height - padding %>" x2="<%= width - padding %>" y2="<%= height - padding %>" class="stroke-border" stroke-width="1"></line>

    <% series.each_with_index do |point, index| %>
      <% ratio = point[:amount_cents].to_f / max %>
      <% bar_height = [ (ratio * plot_height).round, point[:amount_cents].positive? ? 2 : 0 ].max %>
      <% x = padding + index * (bar_width + gap) %>
      <% y = height - padding - bar_height %>
      <rect x="<%= x.round(1) %>"
            y="<%= y %>"
            width="<%= bar_width.round(1) %>"
            height="<%= bar_height %>"
            rx="1.5"
            class="fill-primary-500/80">
        <title><%= t("sell.dashboard.chart.bar_label", date: l(point[:date], format: :short), amount: money(point[:amount_cents], currency: "EUR")) %></title>
      </rect>
    <% end %>
  </svg>

  <details class="mt-3">
    <summary class="cursor-pointer text-xs font-semibold text-primary-700 hover:underline dark:text-primary-300">
      <%= t("sell.dashboard.chart.show_table") %>
    </summary>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="text-muted">
          <tr>
            <th scope="col" class="py-1 pr-3 font-semibold"><%= t("sell.dashboard.chart.date") %></th>
            <th scope="col" class="py-1 font-semibold"><%= t("sell.dashboard.chart.revenue") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% series.each do |point| %>
            <tr>
              <td class="py-1 pr-3"><%= l(point[:date], format: :short) %></td>
              <td class="py-1 tabular-nums"><%= money(point[:amount_cents], currency: "EUR") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>
</figure>
