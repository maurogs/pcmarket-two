<% set_meta_tags(title: t("account.privacy.title"), noindex: true) %>

<div class="grid gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]">
  <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
    <%= render "account/shared/sidebar" %>
  </aside>

  <div class="min-w-0 space-y-6">
    <header>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("account.settings.eyebrow") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("account.privacy.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("account.privacy.subtitle") %></p>
    </header>

    <section class="space-y-4 rounded-2xl border border-border bg-surface p-5 sm:p-6">
      <h2 class="text-lg font-bold"><%= t("account.privacy.data_title") %></h2>
      <p class="text-sm leading-relaxed text-muted"><%= t("account.privacy.data_body") %></p>
      <ul class="list-disc space-y-1 pl-5 text-sm text-muted">
        <li><%= t("account.privacy.includes_profile") %></li>
        <li><%= t("account.privacy.includes_activity") %></li>
        <li><%= t("account.privacy.includes_orders") %></li>
      </ul>
      <%= button_to t("account.privacy.download"), account_data_export_path,
                    method: :post,
                    class: "btn-primary" %>
      <p class="text-xs text-muted"><%= t("account.privacy.download_hint") %></p>
    </section>

    <section class="rounded-2xl border border-border bg-surface p-5 sm:p-6">
      <h2 class="text-lg font-bold"><%= t("account.privacy.cookies_title") %></h2>
      <p class="mt-2 text-sm leading-relaxed text-muted"><%= t("account.privacy.cookies_body") %></p>
      <button type="button"
              data-action="cookie_consent#open"
              class="mt-3 inline-flex rounded-xl border border-border bg-surface px-3 py-2 text-sm font-semibold text-content transition hover:border-primary-300 hover:text-primary-700 dark:hover:border-primary-700 dark:hover:text-primary-300">
        <%= t("account.privacy.cookies_link") %>
      </button>
      <p class="mt-2 text-xs text-muted"><%= t("account.privacy.cookies_placeholder") %></p>
    </section>
  </div>
</div>
