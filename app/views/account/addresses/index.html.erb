<% set_meta_tags(title: t("account.addresses.title"), noindex: true) %>

<div class="grid gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]">
  <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
    <%= render "account/shared/sidebar" %>
  </aside>

  <div class="min-w-0 space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("account.settings.eyebrow") %></p>
        <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("account.addresses.title") %></h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("account.addresses.subtitle") %></p>
      </div>
      <%= link_to t("account.addresses.new"), new_account_address_path, class: "btn-primary" %>
    </header>

    <% if @addresses.any? %>
      <ul class="space-y-3">
        <% @addresses.each do |address| %>
          <li class="rounded-2xl border border-border bg-surface p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="flex flex-wrap items-center gap-2 text-sm font-bold text-content">
                  <span><%= address.full_name %></span>
                  <% if address.default? %>
                    <span class="rounded-full bg-primary-50 px-2 py-0.5 text-[11px] font-bold text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">
                      <%= t("account.addresses.default_badge") %>
                    </span>
                  <% end %>
                </p>
                <address class="mt-1 text-sm not-italic text-muted">
                  <span class="block"><%= address.line1 %></span>
                  <% if address.line2.present? %><span class="block"><%= address.line2 %></span><% end %>
                  <span class="block"><%= [ address.postal_code, address.city ].compact_blank.join(" ") %></span>
                  <span class="block"><%= [ address.province_name, t("countries.#{address.country_code.downcase}") ].compact_blank.join(", ") %></span>
                  <span class="block"><%= address.phone %></span>
                </address>
              </div>
              <div class="flex items-center gap-2">
                <%= link_to t("account.addresses.edit"), edit_account_address_path(address), class: "btn-accent px-3 py-1.5 text-xs" %>
                <%= button_to t("account.addresses.delete"),
                              account_address_path(address),
                              method: :delete,
                              class: "rounded-xl border border-border bg-surface px-3 py-1.5 text-xs font-semibold text-danger hover:bg-danger-soft",
                              data: { turbo_confirm: t("account.addresses.delete_confirm") } %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
        <h2 class="text-lg font-bold"><%= t("account.addresses.empty_title") %></h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("account.addresses.empty_body") %></p>
        <%= link_to t("account.addresses.new"), new_account_address_path, class: "btn-primary mt-4" %>
      </div>
    <% end %>
  </div>
</div>
