<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to t("admin.categories.form.back"), admin_categories_path, class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.categories.edit.title") %></h1>
      <p class="mt-2 text-sm text-muted"><%= t("admin.categories.edit.subtitle") %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("admin.categories.index.filters"), admin_category_category_attributes_path(@category), class: "btn-accent" %>
      <%= link_to t("admin.categories.index.new"), new_admin_category_path(parent_id: @category.id), class: "btn-accent" %>
    </div>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div><%= render "form" %></div>

    <aside class="space-y-4">
      <section class="rounded-2xl border border-border bg-surface p-4">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.categories.edit.stats_title") %></h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-2"><dt class="text-muted"><%= t("admin.categories.table.listings", count: @category.listings_count) %></dt><dd class="font-semibold"><%= @category.listings_count %></dd></div>
          <div class="flex justify-between gap-2"><dt class="text-muted"><%= t("admin.categories.table.total_listings") %></dt><dd class="font-semibold"><%= @category.total_listings_count %></dd></div>
          <div class="flex justify-between gap-2"><dt class="text-muted"><%= t("admin.categories.table.children", count: @category.children.count) %></dt><dd class="font-semibold"><%= @category.children.count %></dd></div>
        </dl>
      </section>

      <section class="rounded-2xl border border-border bg-surface p-4">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.category_attributes.index.title") %></h2>
          <%= link_to t("admin.common.manage"), admin_category_category_attributes_path(@category), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
        </div>
        <% if @effective_filters.any? %>
          <ul class="mt-3 space-y-2 text-sm">
            <% @effective_filters.first(8).each do |row| %>
              <li class="flex items-center justify-between gap-2">
                <span><%= row.attribute_definition.name.presence || row.attribute_definition.key %></span>
                <span class="text-xs text-muted"><%= row.required? ? t("admin.category_attributes.required") : t("admin.category_attributes.optional") %></span>
              </li>
            <% end %>
          </ul>
          <% if @effective_filters.size > 8 %>
            <p class="mt-2 text-xs text-muted"><%= t("admin.categories.edit.more_filters", count: @effective_filters.size - 8) %></p>
          <% end %>
        <% else %>
          <p class="mt-2 text-sm text-muted"><%= t("admin.category_attributes.index.empty") %></p>
        <% end %>
      </section>
    </aside>
  </div>
</div>
