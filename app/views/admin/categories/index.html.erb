<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.categories.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.categories.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.categories.index.count", count: @total) %></p>
      <%= link_to t("admin.categories.index.new"), new_admin_category_path, class: "btn-primary" %>
    </div>
  </header>

  <% if @groups.any? %>
    <% @groups.each do |parent_id, children| %>
      <% parent = parent_id && Category.find_by(id: parent_id) %>
      <section class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-sm font-bold uppercase tracking-widest text-muted">
            <%= parent ? t("admin.categories.tree.group", name: admin_category_label(parent)) : t("admin.categories.tree.root_group") %>
          </h2>
          <p class="text-xs text-muted"><%= t("admin.categories.tree.drag_hint") %></p>
        </div>

        <%= form_with url: admin_category_positions_path, method: :patch, scope: nil,
                      class: "mt-3", data: { controller: "sortable", sortable_name_value: "ordered_ids[]" } do %>
          <%= hidden_field_tag :parent_id, parent_id %>
          <%= hidden_field_tag :category_id, children.first.id %>
          <div data-sortable-target="order"></div>

          <ul class="space-y-2" data-sortable-target="list">
            <% children.each do |category| %>
              <li data-sortable-target="item"
                  data-sortable-id="<%= category.id %>"
                  draggable="true"
                  data-action="dragstart->sortable#dragStart dragover->sortable#dragOver dragend->sortable#dragEnd drop->sortable#drop"
                  class="grid gap-3 rounded-xl border border-border bg-surface-muted/40 p-3 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-center">
                <span class="cursor-grab select-none text-lg text-muted" aria-hidden="true">⠿</span>

                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <%= link_to admin_category_label(category), edit_admin_category_path(category),
                                class: "font-semibold text-content underline-offset-2 hover:underline" %>
                    <span class="rounded-full border px-2 py-0.5 text-[11px] font-semibold <%= admin_status_badge_class(category.active? ? 'active' : 'draft') %>">
                      <%= category.active? ? t("admin.categories.statuses.active") : t("admin.categories.statuses.inactive") %>
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-muted">
                    /<%= category.slug %> · <%= t("admin.categories.table.listings", count: category.listings_count) %> ·
                    <%= t("admin.categories.table.children", count: category.children.count) %>
                  </p>
                  <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                    <%= label_tag "moves_#{category.id}", t("admin.categories.tree.move_to"), class: "font-semibold text-muted" %>
                    <%= select_tag "moves[#{category.id}]", options_for_select(admin_category_move_options(category), "keep"),
                                   id: "moves_#{category.id}", class: "field max-w-xs py-1 text-xs" %>
                  </div>
                </div>

                <div class="flex flex-wrap items-center justify-end gap-2">
                  <%= link_to t("admin.categories.index.new"), new_admin_category_path(parent_id: category.id),
                              class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                  <%= link_to t("admin.categories.index.filters"), admin_category_category_attributes_path(category),
                              class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                  <%= link_to t("admin.common.edit"), edit_admin_category_path(category),
                              class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                  <%= link_to t("admin.common.delete"), admin_category_path(category),
                              data: { turbo_method: :delete, turbo_confirm: t("admin.categories.index.delete_confirm") },
                              class: "text-xs font-semibold text-danger underline-offset-2 hover:underline" %>
                </div>
              </li>
            <% end %>
          </ul>

          <div class="mt-3 flex justify-end">
            <%= submit_tag t("admin.categories.tree.save_order"), class: "btn-accent" %>
          </div>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.categories.index.empty_title") %></h2>
      <p class="mt-2 text-sm text-muted"><%= t("admin.categories.index.empty_body") %></p>
    </div>
  <% end %>
</div>
