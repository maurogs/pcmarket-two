<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.games.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.games.index.subtitle") %></p>
    </div>
    <%= link_to t("admin.games.index.new"), new_admin_game_path, class: "btn-primary" %>
  </header>

  <% if @games.any? %>
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th class="px-4 py-3"><%= t("admin.games.table.game") %></th>
            <th class="px-4 py-3"><%= t("admin.games.table.slug") %></th>
            <th class="px-4 py-3"><%= t("admin.games.table.position") %></th>
            <th class="px-4 py-3"><%= t("admin.games.table.active") %></th>
            <th class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @games.each do |game| %>
            <tr>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="h-12 w-9 overflow-hidden rounded-lg bg-surface-muted">
                    <% if game.cover.attached? %>
                      <%= image_tag url_for(game.cover.variant(:thumb)), alt: "", class: "h-full w-full object-cover" %>
                    <% end %>
                  </span>
                  <span class="font-semibold"><%= game.name %></span>
                </div>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-muted"><%= game.slug %></td>
              <td class="px-4 py-3 text-muted"><%= game.position %></td>
              <td class="px-4 py-3">
                <span class="rounded-full border px-2 py-0.5 text-xs font-semibold <%= admin_status_badge_class(game.active? ? 'active' : 'draft') %>">
                  <%= game.active? ? t("admin.common.yes") : t("admin.common.no") %>
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to t("admin.common.edit"), edit_admin_game_path(game), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                <%= link_to t("admin.common.delete"), admin_game_path(game),
                            data: { turbo_method: :delete, turbo_confirm: t("admin.games.index.delete_confirm") },
                            class: "ml-2 text-xs font-semibold text-danger underline-offset-2 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.games.index.empty_title") %></h2>
      <p class="mt-2 text-sm text-muted"><%= t("admin.games.index.empty_body") %></p>
    </div>
  <% end %>
</div>
