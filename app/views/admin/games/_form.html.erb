<%= form_with model: @game, url: @game.persisted? ? admin_game_path(@game) : admin_games_path,
              method: @game.persisted? ? :patch : :post, multipart: true, class: "space-y-5" do |form| %>
  <%= render "shared/form_errors", object: @game %>

  <div class="grid gap-4 rounded-2xl border border-border bg-surface p-4 sm:grid-cols-2 sm:p-5">
    <div>
      <%= form.label :name, t("admin.games.form.name"), class: "block text-sm font-semibold" %>
      <%= form.text_field :name, class: "field mt-1.5" %>
    </div>
    <div>
      <%= form.label :slug, t("admin.games.form.slug"), class: "block text-sm font-semibold" %>
      <%= form.text_field :slug, class: "field mt-1.5", placeholder: t("admin.games.form.slug_placeholder") %>
    </div>
    <div>
      <%= form.label :position, t("admin.games.form.position"), class: "block text-sm font-semibold" %>
      <%= form.number_field :position, min: 0, class: "field mt-1.5" %>
    </div>
    <label class="flex items-center gap-3 self-end text-sm">
      <%= form.check_box :active, class: "h-5 w-5 rounded border-border text-primary-600" %>
      <span><%= t("admin.games.form.active") %></span>
    </label>
    <div class="sm:col-span-2">
      <%= form.label :cover, t("admin.games.form.cover"), class: "block text-sm font-semibold" %>
      <%= form.file_field :cover, accept: "image/png,image/jpeg,image/webp", class: "field mt-1.5" %>
      <% if @game.cover.attached? %>
        <div class="mt-3 flex items-center gap-3">
          <%= image_tag url_for(@game.cover.variant(:thumb)), alt: "", class: "h-20 w-15 rounded-lg object-cover" %>
          <p class="text-xs text-muted"><%= t("admin.games.form.cover_hint") %></p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.games.form.requirements_title") %></h2>
    <p class="mt-1 text-xs text-muted"><%= t("admin.games.form.requirements_hint") %></p>
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <div>
        <h3 class="text-sm font-semibold"><%= t("admin.games.form.gpu_tier") %></h3>
        <div class="mt-2 grid gap-2 sm:grid-cols-3">
          <% Game::RESOLUTIONS.each do |resolution| %>
            <% Game::FPS_BANDS.each do |fps| %>
              <% key = "#{resolution}_#{fps}" %>
              <label class="block text-xs">
                <span class="font-medium text-muted"><%= t("pc_finder.bands.#{key}") %></span>
                <%= number_field_tag "game[min_gpu_tier][#{key}]", @game.min_gpu_tier&.dig(key), min: 1, max: 10, class: "field mt-1" %>
              </label>
            <% end %>
          <% end %>
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold"><%= t("admin.games.form.cpu_tier") %></h3>
        <div class="mt-2 grid gap-2 sm:grid-cols-3">
          <% Game::RESOLUTIONS.each do |resolution| %>
            <% Game::FPS_BANDS.each do |fps| %>
              <% key = "#{resolution}_#{fps}" %>
              <label class="block text-xs">
                <span class="font-medium text-muted"><%= t("pc_finder.bands.#{key}") %></span>
                <%= number_field_tag "game[min_cpu_tier][#{key}]", @game.min_cpu_tier&.dig(key), min: 1, max: 10, class: "field mt-1" %>
              </label>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <% if @game.persisted? %>
        <%= link_to t("admin.games.form.delete"), admin_game_path(@game),
                    data: { turbo_method: :delete, turbo_confirm: t("admin.games.form.delete_confirm") },
                    class: "text-sm font-semibold text-danger underline-offset-2 hover:underline" %>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("admin.common.cancel"), admin_games_path, class: "btn-accent" %>
      <%= submit_tag t("admin.common.save"), class: "btn-primary" %>
    </div>
  </div>
<% end %>
