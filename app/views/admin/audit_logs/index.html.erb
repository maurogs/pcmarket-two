<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.audit_logs.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.audit_logs.index.subtitle") %></p>
    </div>
    <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.audit_logs.index.count", count: @query.pagy.count) %></p>
  </header>

  <%= form_with url: admin_audit_logs_path, method: :get, scope: nil, class: "rounded-2xl border border-border bg-surface px-4 py-4" do %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <%= label_tag :actor_id, t("admin.audit_logs.filters.actor"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :actor_id, options_for_select([[t("admin.common.any"), ""]] + @query.actors.map { |a| [a.display_name, a.id] }, @query.filters[:actor_id]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :auditable_type, t("admin.audit_logs.filters.type"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :auditable_type, options_for_select([[t("admin.common.any"), ""]] + Admin::AuditLogQuery::AUDITABLE_TYPES.map { |type| [t("admin.audit_logs.types.#{type.underscore}"), type] }, @query.filters[:auditable_type]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :action, t("admin.audit_logs.filters.action"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :action, options_for_select([[t("admin.common.any"), ""]] + Admin::AuditLogQuery.actions.map { |a| [admin_audit_action_label(a), a] }, @query.filters[:action]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :date_from, t("admin.common.from"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= date_field_tag :date_from, @query.filters[:date_from], class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :date_to, t("admin.common.to"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= date_field_tag :date_to, @query.filters[:date_to], class: "field mt-1.5" %>
      </div>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <%= submit_tag t("admin.common.apply"), class: "btn-primary" %>
      <%= link_to t("admin.common.clear"), admin_audit_logs_path, class: "btn-accent" %>
      <div class="ml-auto flex items-center gap-2">
        <%= label_tag :per_page, t("admin.common.per_page"), class: "text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :per_page, options_for_select(Admin::Filterable::PER_PAGE_OPTIONS, @query.per_page), class: "field w-24", onchange: "this.form.requestSubmit()" %>
      </div>
    </div>
  <% end %>

  <% if @query.records.any? %>
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th class="px-4 py-3"><%= t("admin.audit_logs.table.created") %></th>
            <th class="px-4 py-3"><%= t("admin.audit_logs.table.actor") %></th>
            <th class="px-4 py-3"><%= t("admin.audit_logs.table.action") %></th>
            <th class="px-4 py-3"><%= t("admin.audit_logs.table.item") %></th>
            <th class="px-4 py-3"><%= t("admin.audit_logs.table.ip") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @query.records.each do |log| %>
            <tr class="align-top">
              <td class="whitespace-nowrap px-4 py-3 text-muted"><%= l(log.created_at, format: :short) %></td>
              <td class="px-4 py-3"><%= log.actor ? link_to(log.actor.display_name, admin_user_path(log.actor), class: "font-semibold text-primary-700 hover:underline dark:text-primary-300") : t("admin.audit_logs.system") %></td>
              <td class="px-4 py-3 font-semibold"><%= admin_audit_action_label(log.action) %></td>
              <td class="px-4 py-3 text-muted">
                <p class="text-xs uppercase tracking-wide"><%= t("admin.audit_logs.types.#{log.auditable_type.underscore}", default: log.auditable_type) %></p>
                <p><%= admin_auditable_label(log.auditable) %></p>
                <% if log.changes.present? %>
                  <p class="mt-1 break-all font-mono text-[11px] text-muted"><%= log.changes.to_json %></p>
                <% end %>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-muted"><%= log.ip.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagy_nav(@query.pagy) %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.audit_logs.index.empty_title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("admin.audit_logs.index.empty_body") %></p>
    </div>
  <% end %>
</div>
