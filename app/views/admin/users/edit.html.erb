<div class="space-y-6">
  <header>
    <%= link_to t("admin.users.edit.back"), admin_user_path(@user), class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.users.edit.title") %></h1>
    <p class="mt-2 text-sm text-muted"><%= t("admin.users.edit.subtitle") %></p>
  </header>

  <%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "space-y-6" do |f| %>
    <%= render "shared/form_errors", object: @user %>

    <section class="grid gap-4 rounded-2xl border border-border bg-surface p-5 sm:grid-cols-2 sm:p-6">
      <div><%= f.label :first_name, t("admin.users.edit.first_name"), class: "text-sm font-semibold" %><%= f.text_field :first_name, class: "field mt-1.5" %></div>
      <div><%= f.label :last_name, t("admin.users.edit.last_name"), class: "text-sm font-semibold" %><%= f.text_field :last_name, class: "field mt-1.5" %></div>
      <div><%= f.label :username, t("admin.users.edit.username"), class: "text-sm font-semibold" %><%= f.text_field :username, class: "field mt-1.5" %></div>
      <div><%= f.label :email, t("admin.users.edit.email"), class: "text-sm font-semibold" %><%= f.email_field :email, class: "field mt-1.5" %></div>
      <div><%= f.label :phone, t("admin.users.edit.phone"), class: "text-sm font-semibold" %><%= f.telephone_field :phone, class: "field mt-1.5" %></div>
      <div>
        <%= f.label :locale, t("admin.users.edit.locale"), class: "text-sm font-semibold" %>
        <%= f.select :locale, I18n.available_locales.map { |locale| [t("locale.names.#{locale}"), locale] }, {}, class: "field mt-1.5" %>
      </div>
      <div><%= f.label :country_code, t("admin.users.edit.country"), class: "text-sm font-semibold" %><%= f.text_field :country_code, maxlength: 2, class: "field mt-1.5 uppercase" %></div>
      <label class="flex items-center gap-3 self-end text-sm"><%= f.check_box :marketing_opt_in, class: "h-5 w-5 rounded border-border text-primary-600" %><span><%= t("admin.users.edit.marketing_opt_in") %></span></label>
    </section>

    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= link_to t("admin.common.cancel"), admin_user_path(@user), class: "btn-accent" %>
      <%= submit_tag t("admin.common.save"), class: "btn-primary" %>
    </div>
  <% end %>
</div>
