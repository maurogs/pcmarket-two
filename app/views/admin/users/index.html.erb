<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.users.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.users.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.users.index.count", count: @query.pagy.count) %></p>
      <%= link_to t("admin.common.export_csv"), admin_users_path(request.query_parameters.merge(format: :csv)), class: "btn-accent" %>
    </div>
  </header>

  <%= form_with url: admin_users_path, method: :get, scope: nil, class: "rounded-2xl border border-border bg-surface px-4 py-4" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <%= label_tag :q, t("admin.users.filters.search"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= search_field_tag :q, @query.filters[:q], placeholder: t("admin.users.filters.search_placeholder"), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :per_page, t("admin.common.per_page"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :per_page, options_for_select(Admin::Filterable::PER_PAGE_OPTIONS, @query.per_page), class: "field mt-1.5", onchange: "this.form.requestSubmit()" %>
      </div>
      <%= submit_tag t("admin.common.apply"), class: "btn-primary" %>
      <%= link_to t("admin.common.clear"), admin_users_path, class: "btn-accent" %>
    </div>

    <details class="mt-4 rounded-xl border border-border bg-surface-muted/60 px-4 py-3" <%= "open" if admin_filters_active?(@query.filters) %>>
      <summary class="cursor-pointer text-sm font-semibold text-content"><%= t("admin.users.filters.title") %></summary>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <%= label_tag :role, t("admin.users.filters.role"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= select_tag :role, options_for_select([[t("admin.common.any"), ""]] + Admin::UserQuery::ROLES.map { |r| [admin_user_role_label(r), r] }, @query.filters[:role]), class: "field mt-1.5" %>
        </div>
        <div>
          <%= label_tag :status, t("admin.users.filters.status"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= select_tag :status, options_for_select([[t("admin.common.any"), ""]] + Admin::UserQuery::STATUSES.map { |s| [admin_user_status_label(s), s] }, @query.filters[:status]), class: "field mt-1.5" %>
        </div>
        <div>
          <%= label_tag :has_store, t("admin.users.filters.has_store"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= select_tag :has_store, options_for_select([[t("admin.common.any"), ""], [t("admin.common.yes"), "true"], [t("admin.common.no"), "false"]], @query.filters[:has_store].nil? ? "" : @query.filters[:has_store].to_s), class: "field mt-1.5" %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <%= label_tag :created_from, t("admin.common.from"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= date_field_tag :created_from, @query.filters[:created_from], class: "field mt-1.5" %>
          </div>
          <div>
            <%= label_tag :created_to, t("admin.common.to"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= date_field_tag :created_to, @query.filters[:created_to], class: "field mt-1.5" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2 sm:col-span-2">
          <div>
            <%= label_tag :last_sign_in_from, t("admin.users.filters.last_sign_in_from"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= date_field_tag :last_sign_in_from, @query.filters[:last_sign_in_from], class: "field mt-1.5" %>
          </div>
          <div>
            <%= label_tag :last_sign_in_to, t("admin.users.filters.last_sign_in_to"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= date_field_tag :last_sign_in_to, @query.filters[:last_sign_in_to], class: "field mt-1.5" %>
          </div>
        </div>
      </div>
    </details>
  <% end %>

  <% if @query.records.any? %>
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.users.table.user"), "username", query: @query, path: :admin_users_path) %></th>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.users.table.email"), "email", query: @query, path: :admin_users_path) %></th>
            <th scope="col" class="px-4 py-3"><%= t("admin.users.table.role") %></th>
            <th scope="col" class="px-4 py-3"><%= t("admin.users.table.status") %></th>
            <th scope="col" class="px-4 py-3"><%= t("admin.users.table.store") %></th>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.users.table.last_sign_in"), "last_sign_in_at", query: @query, path: :admin_users_path) %></th>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.users.table.created"), "created_at", query: @query, path: :admin_users_path) %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @query.records.each do |user| %>
            <% status = user.soft_deleted? ? "deleted" : (user.banned? ? "banned" : (user.confirmed_at.nil? ? "unconfirmed" : "active")) %>
            <tr class="align-middle">
              <td class="px-4 py-3">
                <%= link_to user.display_name, admin_user_path(user), class: "font-semibold text-content underline-offset-2 hover:underline" %>
                <p class="text-xs text-muted">@<%= user.username %> · #<%= user.id %></p>
              </td>
              <td class="px-4 py-3 text-muted"><%= user.email %></td>
              <td class="whitespace-nowrap px-4 py-3 text-muted"><%= admin_user_role_label(user.role) %></td>
              <td class="whitespace-nowrap px-4 py-3">
                <span class="rounded-full border px-2 py-0.5 text-xs font-semibold <%= admin_status_badge_class(status) %>"><%= admin_user_status_label(status) %></span>
              </td>
              <td class="px-4 py-3 text-muted"><%= user.store&.name || t("admin.common.none") %></td>
              <td class="whitespace-nowrap px-4 py-3 text-muted"><%= user.last_sign_in_at ? l(user.last_sign_in_at, format: :short) : t("admin.users.never_signed_in") %></td>
              <td class="whitespace-nowrap px-4 py-3 text-muted"><%= l(user.created_at, format: :short) %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right">
                <%= link_to t("admin.common.view"), admin_user_path(user), class: "font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagy_nav(@query.pagy) %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.users.index.empty_title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("admin.users.index.empty_body") %></p>
    </div>
  <% end %>
</div>
