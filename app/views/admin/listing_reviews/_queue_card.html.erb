<% profile = @queue.profile_for(listing) %>
<article class="rounded-2xl border border-border bg-surface p-4">
  <div class="flex items-start gap-3">
    <%= render "admin/listing_reviews/thumbnail", listing: listing %>
    <div class="min-w-0 flex-1">
      <p class="font-semibold text-content">
        <%= link_to listing.title.presence || t("sell.listings.untitled"),
                    admin_listing_review_path(listing),
                    class: "transition hover:text-primary-700 dark:hover:text-primary-300" %>
      </p>
      <p class="mt-0.5 text-xs text-muted"><%= listing.category&.name %></p>
      <p class="mt-1 text-sm font-semibold text-content">
        <%= listing.price_cents ? money(listing.price_cents, currency: listing.currency) : "—" %>
      </p>
    </div>
  </div>

  <div class="mt-3 space-y-1 border-t border-border pt-3 text-xs text-muted">
    <p class="flex items-center gap-1 font-semibold text-content">
      <span><%= listing.seller.display_name %></span>
      <% if profile.verified? %>
        <span class="inline-flex items-center rounded-full bg-primary-50 px-1.5 py-0.5 text-[10px] font-semibold text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">
          <%= t("admin.moderation.seller.verified") %>
        </span>
      <% end %>
    </p>
    <p><%= t("admin.moderation.seller.account_age", count: profile.account_age_days) %></p>
    <p><%= t("admin.moderation.seller.previous_rejections", count: profile.previous_rejections_count) %></p>
    <p><%= t("admin.moderation.index.waiting_for", time: time_ago_in_words(listing.submitted_at || listing.created_at)) %></p>
  </div>

  <div class="mt-3">
    <%= link_to t("admin.moderation.index.review"), admin_listing_review_path(listing), class: "btn-primary w-full" %>
  </div>
</article>
