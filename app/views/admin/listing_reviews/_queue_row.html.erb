<% profile = @queue.profile_for(listing) %>
<tr class="align-middle">
  <td class="px-4 py-3">
    <div class="flex items-center gap-3">
      <%= render "admin/listing_reviews/thumbnail", listing: listing %>
      <div class="min-w-0">
        <p class="truncate font-semibold text-content">
          <%= link_to listing.title.presence || t("sell.listings.untitled"),
                      admin_listing_review_path(listing),
                      class: "transition hover:text-primary-700 dark:hover:text-primary-300" %>
        </p>
        <p class="truncate text-xs text-muted"><%= listing.category&.name %></p>
        <p class="truncate text-xs text-muted">
          <%= t("admin.moderation.index.waiting_for", time: time_ago_in_words(listing.submitted_at || listing.created_at)) %>
        </p>
      </div>
    </div>
  </td>

  <td class="px-4 py-3">
    <div class="min-w-0">
      <p class="flex items-center gap-1 truncate font-semibold text-content">
        <span class="truncate"><%= listing.seller.display_name %></span>
        <% if profile.verified? %>
          <span class="inline-flex shrink-0 items-center rounded-full bg-primary-50 px-1.5 py-0.5 text-[10px] font-semibold text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">
            <%= t("admin.moderation.seller.verified") %>
          </span>
        <% end %>
      </p>
      <p class="truncate text-xs text-muted"><%= listing.store&.name %></p>
      <p class="truncate text-xs text-muted">
        <%= t("admin.moderation.seller.account_age", count: profile.account_age_days) %>
        ·
        <%= t("admin.moderation.seller.previous_rejections", count: profile.previous_rejections_count) %>
      </p>
    </div>
  </td>

  <td class="whitespace-nowrap px-4 py-3 font-semibold text-content">
    <%= listing.price_cents ? money(listing.price_cents, currency: listing.currency) : "—" %>
  </td>

  <td class="whitespace-nowrap px-4 py-3 text-muted">
    <%= time_ago_in_words(listing.submitted_at || listing.created_at) %>
  </td>

  <td class="whitespace-nowrap px-4 py-3 text-right">
    <%= link_to t("admin.moderation.index.review"),
                admin_listing_review_path(listing),
                class: "font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
  </td>
</tr>
