<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to t("admin.category_attributes.index.back"), edit_admin_category_path(@category), class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.category_attributes.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.category_attributes.index.subtitle", category: @category.name) %></p>
    </div>
    <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.category_attributes.index.count", count: @effective_filters.size) %></p>
  </header>

  <section class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.category_attributes.index.effective_title") %></h2>
    <% if @effective_filters.any? %>
      <div class="mt-3 overflow-x-auto">
        <table class="min-w-full divide-y divide-border text-sm">
          <thead class="text-left text-xs font-semibold uppercase tracking-widest text-muted">
            <tr>
              <th class="px-2 py-2"><%= t("admin.category_attributes.table.attribute") %></th>
              <th class="px-2 py-2"><%= t("admin.category_attributes.table.source") %></th>
              <th class="px-2 py-2"><%= t("admin.category_attributes.table.required") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @effective_filters.each do |row| %>
              <tr>
                <td class="px-2 py-2 font-medium"><%= row.attribute_definition.name.presence || row.attribute_definition.key %></td>
                <td class="px-2 py-2 text-muted">
                  <% if row.category_id == @category.id %>
                    <%= t("admin.category_attributes.sources.own") %>
                  <% else %>
                    <%= link_to t("admin.category_attributes.sources.inherited_from", category: row.category.name),
                                admin_category_category_attributes_path(row.category),
                                class: "font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                  <% end %>
                </td>
                <td class="px-2 py-2"><%= row.required? ? t("admin.category_attributes.required") : t("admin.category_attributes.optional") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-muted"><%= t("admin.category_attributes.index.empty") %></p>
    <% end %>
  </section>

  <section class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.category_attributes.index.own_title") %></h2>

    <% if @own_filters.any? %>
      <div class="mt-3 space-y-3">
        <% @own_filters.each do |row| %>
          <%= form_with model: row, url: admin_category_category_attribute_path(@category, row), method: :patch, scope: :category_attribute,
                        class: "flex flex-wrap items-end gap-3 rounded-xl border border-border bg-surface-muted/40 p-3" do |form| %>
            <p class="min-w-0 flex-1 font-semibold"><%= row.attribute_definition.name.presence || row.attribute_definition.key %></p>
            <div>
              <%= form.label :position, t("admin.category_attributes.table.position"), class: "block text-xs font-semibold text-muted" %>
              <%= form.number_field :position, min: 0, class: "field mt-1 py-1 text-sm" %>
            </div>
            <label class="flex items-center gap-2 text-sm">
              <%= form.check_box :required, class: "h-4 w-4 rounded border-border text-primary-600" %>
              <span><%= t("admin.category_attributes.required") %></span>
            </label>
            <%= submit_tag t("admin.common.save"), class: "btn-primary py-1.5 text-xs" %>
            <%= link_to t("admin.common.delete"), admin_category_category_attribute_path(@category, row),
                        data: { turbo_method: :delete, turbo_confirm: t("admin.category_attributes.index.delete_confirm") },
                        class: "text-xs font-semibold text-danger underline-offset-2 hover:underline" %>
          <% end %>
        <% end %>
      </div>

      <%= form_with url: admin_category_category_attribute_positions_path(@category), method: :patch, scope: nil,
                    class: "mt-4", data: { controller: "sortable", sortable_name_value: "ordered_ids[]" } do %>
        <div data-sortable-target="order"></div>
        <ul class="space-y-2" data-sortable-target="list">
          <% @own_filters.each do |row| %>
            <li data-sortable-target="item"
                data-sortable-id="<%= row.id %>"
                draggable="true"
                data-action="dragstart->sortable#dragStart dragover->sortable#dragOver dragend->sortable#dragEnd drop->sortable#drop"
                class="flex items-center gap-3 rounded-xl border border-border bg-surface p-3 text-sm">
              <span class="cursor-grab select-none text-muted" aria-hidden="true">⠿</span>
              <span class="font-medium"><%= row.attribute_definition.name.presence || row.attribute_definition.key %></span>
            </li>
          <% end %>
        </ul>
        <div class="mt-3 flex justify-end">
          <%= submit_tag t("admin.category_attributes.index.save_order"), class: "btn-accent" %>
        </div>
      <% end %>
    <% else %>
      <p class="mt-3 text-sm text-muted"><%= t("admin.category_attributes.index.no_own") %></p>
    <% end %>
  </section>

  <section class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.category_attributes.index.add_title") %></h2>
    <%= form_with url: admin_category_category_attributes_path(@category), method: :post, scope: nil,
                  class: "mt-3 flex flex-wrap items-end gap-3" do %>
      <div class="min-w-0 flex-1">
        <%= label_tag :attribute_definition_id, t("admin.category_attributes.table.attribute"), class: "block text-xs font-semibold text-muted" %>
        <%= select_tag :attribute_definition_id,
                       options_from_collection_for_select(@available_definitions, :id, :name),
                       class: "field mt-1" %>
      </div>
      <%= submit_tag t("admin.category_attributes.index.add"), class: "btn-primary" %>
    <% end %>
    <p class="mt-2 text-xs text-muted"><%= t("admin.category_attributes.index.add_hint") %></p>
  </section>
</div>
