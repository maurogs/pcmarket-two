<div class="space-y-6">
  <header>
    <%= link_to t("admin.buyback_prices.form.back"), admin_buyback_prices_path, class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.buyback_prices.new.title") %></h1>
  </header>
  <%= render "form", default_multiplier: ->(condition) { { "like_new" => 1.0, "good" => 0.85, "fair" => 0.7, "for_parts" => 0.25 }.fetch(condition, 1.0) } %>
</div>
