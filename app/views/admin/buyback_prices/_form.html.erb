<%= form_with model: @price, url: @price.persisted? ? admin_buyback_price_path(@price) : admin_buyback_prices_path,
              method: @price.persisted? ? :patch : :post, class: "space-y-5" do |form| %>
  <%= render "shared/form_errors", object: @price %>

  <div class="grid gap-4 rounded-2xl border border-border bg-surface p-4 sm:grid-cols-2 sm:p-5">
    <div>
      <%= form.label :component_type, t("admin.buyback_prices.form.component_type"), class: "block text-sm font-semibold" %>
      <%= form.select :component_type, BuybackPrice.component_types.keys.map { |type| [ t("buyback.component_types.#{type}"), type ] }, {}, class: "field mt-1.5" %>
    </div>
    <div>
      <%= form.label :component_model, t("admin.buyback_prices.form.component_model"), class: "block text-sm font-semibold" %>
      <%= form.text_field :component_model, class: "field mt-1.5", placeholder: t("admin.buyback_prices.form.model_placeholder") %>
    </div>
    <div>
      <%= form.label :base_offer_cents, t("admin.buyback_prices.form.base_offer_cents"), class: "block text-sm font-semibold" %>
      <%= form.number_field :base_offer_cents, min: 0, class: "field mt-1.5" %>
      <p class="mt-1 text-xs text-muted"><%= t("admin.buyback_prices.form.base_hint") %></p>
    </div>
    <label class="flex items-center gap-3 self-end text-sm">
      <%= form.check_box :active, class: "h-5 w-5 rounded border-border text-primary-600" %>
      <span><%= t("admin.buyback_prices.form.active") %></span>
    </label>
  </div>

  <div class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.buyback_prices.form.multipliers_title") %></h2>
    <p class="mt-1 text-xs text-muted"><%= t("admin.buyback_prices.form.multipliers_hint") %></p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% BuybackPrice::CONDITION_KEYS.each do |condition| %>
        <div>
          <label for="buyback_price_condition_multipliers_<%= condition %>" class="block text-sm font-semibold"><%= buyback_condition_label(condition) %></label>
          <%= number_field_tag "buyback_price[condition_multipliers][#{condition}]",
                               @price.condition_multiplier(condition).positive? ? @price.condition_multiplier(condition) : default_multiplier(condition),
                               id: "buyback_price_condition_multipliers_#{condition}",
                               step: "0.01", min: 0.01, max: 1, class: "field mt-1.5" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <% if @price.persisted? %>
        <%= link_to t("admin.buyback_prices.form.delete"), admin_buyback_price_path(@price),
                    data: { turbo_method: :delete, turbo_confirm: t("admin.buyback_prices.form.delete_confirm") },
                    class: "text-sm font-semibold text-danger underline-offset-2 hover:underline" %>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("admin.common.cancel"), admin_buyback_prices_path, class: "btn-accent" %>
      <%= submit_tag t("admin.common.save"), class: "btn-primary" %>
    </div>
  </div>
<% end %>
