<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to t("admin.regions.index.back"), edit_admin_country_path(@country), class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.regions.index.title", country: @country.name) %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.regions.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.regions.index.count", count: @regions.size) %></p>
      <%= link_to t("admin.regions.index.new"), new_admin_country_region_path(@country), class: "btn-primary" %>
    </div>
  </header>

  <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
    <table class="min-w-full divide-y divide-border text-sm">
      <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
        <tr>
          <th class="px-4 py-3"><%= t("admin.regions.table.code") %></th>
          <th class="px-4 py-3"><%= t("admin.regions.table.name") %></th>
          <th class="px-4 py-3"><%= t("admin.regions.table.position") %></th>
          <th class="px-4 py-3"><%= t("admin.regions.table.listings") %></th>
          <th class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @regions.each do |region| %>
          <tr>
            <td class="px-4 py-3 font-mono text-xs"><%= region.code %></td>
            <td class="px-4 py-3 font-semibold"><%= region.name %></td>
            <td class="px-4 py-3 text-muted"><%= region.position %></td>
            <td class="px-4 py-3 text-muted"><%= region.listings.count %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("admin.common.edit"), edit_admin_country_region_path(@country, region), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              <%= link_to t("admin.common.delete"), admin_country_region_path(@country, region),
                          data: { turbo_method: :delete, turbo_confirm: t("admin.regions.index.delete_confirm") },
                          class: "ml-2 text-xs font-semibold text-danger underline-offset-2 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <section class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.regions.import.title") %></h2>
    <p class="mt-1 text-xs text-muted"><%= t("admin.regions.import.hint") %></p>
    <%= form_with url: admin_country_region_import_path(@country), method: :post, scope: nil, class: "mt-3 space-y-3" do %>
      <%= text_area_tag :text, nil, rows: 6, class: "field font-mono text-sm",
                        placeholder: t("admin.regions.import.placeholder") %>
      <%= submit_tag t("admin.regions.import.submit"), class: "btn-accent" %>
    <% end %>
  </section>
</div>
