<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <%= link_to t("admin.buyback_requests.show.back"), admin_buyback_requests_path, class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= @request.reference %></h1>
      <p class="mt-1 text-sm text-muted"><%= @request.user.display_name %> · <%= @request.user.email %></p>
    </div>
    <span class="inline-flex rounded-full border px-3 py-1.5 text-sm font-semibold <%= buyback_status_classes(@request.status) %>"><%= buyback_status_label(@request.status) %></span>
  </header>

  <div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
    <section class="space-y-5">
      <div class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.buyback_requests.show.details_title") %></h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-muted"><%= t("buyback.details.component") %></dt><dd class="font-semibold"><%= @request.component_model %> (<%= t("buyback.component_types.#{@request.component_type}") %>)</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted"><%= t("buyback.details.condition") %></dt><dd class="font-semibold"><%= buyback_condition_label(@request.condition) %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted"><%= t("buyback.details.offer") %></dt><dd class="font-semibold"><%= money(@request.offer_cents, currency: "EUR") %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted"><%= t("buyback.details.revised_offer") %></dt><dd class="font-semibold"><%= @request.revised_offer_cents.present? ? money(@request.revised_offer_cents, currency: "EUR") : "—" %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted"><%= t("buyback.details.iban") %></dt><dd class="font-mono text-xs font-semibold"><%= @request.masked_iban %></dd></div>
        </dl>
      </div>

      <div class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.buyback_requests.show.address_title") %></h2>
        <address class="mt-3 text-sm not-italic leading-relaxed text-muted">
          <%= @request.full_name %><br>
          <%= @request.line1 %><br>
          <% if @request.line2.present? %><%= @request.line2 %><br><% end %>
          <%= @request.postal_code %> <%= @request.city %><br>
          <%= @request.country_code %>
          <% if @request.phone.present? %><br><%= @request.phone %><% end %>
        </address>
        <% if @request.tracking_number.present? %>
          <p class="mt-3 text-xs text-muted"><%= t("buyback.show.tracking", carrier: @request.carrier.presence || t("buyback.show.carrier_unknown"), number: @request.tracking_number) %></p>
        <% end %>
        <% if @request.inspection_result.present? %>
          <p class="mt-3 rounded-xl bg-surface-muted px-3 py-2 text-xs"><strong><%= t("admin.buyback_requests.show.inspection_result") %>:</strong> <%= @request.inspection_result %></p>
        <% end %>
      </div>

      <div class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("buyback.show.progress_title") %></h2>
        <div class="mt-4"><%= render "buyback_requests/timeline", request: @request %></div>
      </div>
    </section>

    <section class="space-y-4">
      <div class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.buyback_requests.show.actions_title") %></h2>

        <% if @request.status == "accepted" && @request.revised_offer_cents.blank? %>
          <h3 class="mt-3 text-sm font-semibold"><%= t("admin.buyback_requests.actions.label_sent.title") %></h3>
          <%= form_with url: admin_buyback_request_events_path(@request), method: :post, scope: nil, class: "mt-2 space-y-2" do %>
            <%= hidden_field_tag :event, "label_sent" %>
            <%= text_field_tag :carrier, nil, placeholder: t("admin.buyback_requests.actions.label_sent.carrier"), class: "field" %>
            <%= text_field_tag :tracking_number, nil, placeholder: t("admin.buyback_requests.actions.label_sent.tracking"), class: "field" %>
            <%= submit_tag t("admin.buyback_requests.actions.label_sent.submit"), class: "btn-primary cursor-pointer" %>
          <% end %>
        <% elsif @request.status == "accepted" %>
          <h3 class="mt-3 text-sm font-semibold"><%= t("admin.buyback_requests.actions.paid.title") %></h3>
          <p class="text-xs text-muted"><%= t("admin.buyback_requests.actions.paid.body") %></p>
          <%= button_to t("admin.buyback_requests.actions.paid.submit"), admin_buyback_request_events_path(@request),
                        method: :post, params: { event: "paid" }, class: "btn-primary mt-2 cursor-pointer" %>
        <% elsif @request.status == "label_sent" %>
          <%= button_to t("admin.buyback_requests.actions.received.submit"), admin_buyback_request_events_path(@request),
                        method: :post, params: { event: "received" }, class: "btn-primary mt-3 cursor-pointer" %>
        <% elsif @request.status == "received" %>
          <%= form_with url: admin_buyback_request_events_path(@request), method: :post, scope: nil, class: "mt-3 space-y-2" do %>
            <%= hidden_field_tag :event, "inspected" %>
            <%= text_area_tag :inspection_result, nil, rows: 3, placeholder: t("admin.buyback_requests.actions.inspected.result"), class: "field" %>
            <%= number_field_tag :revised_offer, nil, step: "0.01", min: 0, placeholder: t("admin.buyback_requests.actions.inspected.revised_offer"), class: "field" %>
            <p class="text-xs text-muted"><%= t("admin.buyback_requests.actions.inspected.hint") %></p>
            <%= submit_tag t("admin.buyback_requests.actions.inspected.submit"), class: "btn-primary cursor-pointer" %>
          <% end %>
        <% elsif @request.status == "inspected" %>
          <div class="mt-3 space-y-2">
            <%= button_to t("admin.buyback_requests.actions.paid.submit"), admin_buyback_request_events_path(@request),
                          method: :post, params: { event: "paid" }, class: "btn-primary w-full cursor-pointer" %>
            <%= button_to t("admin.buyback_requests.actions.rejected.submit"), admin_buyback_request_events_path(@request),
                          method: :post, params: { event: "rejected" }, class: "btn-accent w-full cursor-pointer",
                          form: { data: { turbo_confirm: t("admin.buyback_requests.actions.rejected.confirm") } } %>
            <%= button_to t("admin.buyback_requests.actions.returned.submit"), admin_buyback_request_events_path(@request),
                          method: :post, params: { event: "returned" }, class: "btn-accent w-full cursor-pointer",
                          form: { data: { turbo_confirm: t("admin.buyback_requests.actions.returned.confirm") } } %>
          </div>
        <% elsif @request.status == "offer_revised" %>
          <div class="mt-3 space-y-2">
            <%= button_to t("admin.buyback_requests.actions.accepted_revision.submit"), admin_buyback_request_events_path(@request),
                          method: :post, params: { event: "accepted_revision" }, class: "btn-primary w-full cursor-pointer" %>
            <%= button_to t("admin.buyback_requests.actions.returned.submit"), admin_buyback_request_events_path(@request),
                          method: :post, params: { event: "returned" }, class: "btn-accent w-full cursor-pointer",
                          form: { data: { turbo_confirm: t("admin.buyback_requests.actions.returned.confirm") } } %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-muted"><%= t("admin.buyback_requests.show.no_actions") %></p>
        <% end %>
      </div>

      <div class="rounded-2xl border border-border bg-surface p-5 text-xs text-muted">
        <p><%= t("admin.buyback_requests.show.created_at", date: l(@request.created_at, format: :long)) %></p>
        <p class="mt-1"><%= t("admin.buyback_requests.show.user_note") %></p>
      </div>
    </section>
  </div>
</div>
