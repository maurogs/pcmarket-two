<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to t("admin.legal_pages.show.back"), admin_legal_pages_path, class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= @page.title %></h1>
      <p class="mt-2 text-sm text-muted">
        <%= @page.country_code %> · <%= @page.locale.upcase %> · <%= t("legal_pages.kinds.#{@page.kind}") %> · v<%= @page.version %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full border px-3 py-1 text-xs font-semibold <%= admin_status_badge_class(@page.status) %>"><%= t("admin.legal_pages.statuses.#{@page.status}") %></span>
      <% if @page.draft? %>
        <%= link_to t("admin.common.edit"), edit_admin_legal_page_path(@page), class: "btn-accent" %>
      <% end %>
      <%= link_to t("admin.legal_pages.show.compare"), admin_legal_page_comparison_path(@page), class: "btn-accent" %>
    </div>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <article class="prose prose-slate max-w-none rounded-2xl border border-border bg-surface p-6 dark:prose-invert">
      <%= @page.body %>
    </article>

    <aside class="space-y-4">
      <section class="rounded-2xl border border-border bg-surface p-4 text-sm">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.legal_pages.show.details_title") %></h2>
        <dl class="mt-3 space-y-2">
          <div class="flex justify-between gap-2"><dt class="text-muted"><%= t("admin.legal_pages.show.published_at") %></dt><dd class="font-semibold"><%= @page.published_at ? l(@page.published_at.to_date, format: :short) : t("admin.common.none") %></dd></div>
          <div class="flex justify-between gap-2"><dt class="text-muted"><%= t("admin.legal_pages.show.effective_at") %></dt><dd class="font-semibold"><%= @page.effective_at ? l(@page.effective_at.to_date, format: :short) : t("admin.common.none") %></dd></div>
          <div class="flex justify-between gap-2"><dt class="text-muted"><%= t("admin.legal_pages.show.notified_at") %></dt><dd class="font-semibold"><%= @page.notified_at ? l(@page.notified_at.to_date, format: :short) : t("admin.common.none") %></dd></div>
        </dl>
      </section>

      <% if @page.draft? %>
        <section class="rounded-2xl border border-border bg-surface p-4">
          <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.legal_pages.show.publish_title") %></h2>
          <p class="mt-1 text-xs text-muted"><%= t("admin.legal_pages.show.publish_hint") %></p>
          <%= form_with url: admin_legal_page_publication_path(@page), method: :post, scope: nil, class: "mt-3 space-y-2" do %>
            <%= label_tag :effective_at, t("admin.legal_pages.show.effective_at"), class: "block text-xs font-semibold text-muted" %>
            <%= date_field_tag :effective_at, (@page.effective_at || Date.current), class: "field" %>
            <%= submit_tag t("admin.legal_pages.show.publish"), class: "btn-primary w-full" %>
          <% end %>
        </section>
      <% end %>

      <section class="rounded-2xl border border-border bg-surface p-4">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.legal_pages.show.version_title") %></h2>
        <p class="mt-1 text-xs text-muted"><%= t("admin.legal_pages.show.version_hint") %></p>
        <%= form_with url: admin_legal_page_version_path(@page), method: :post, scope: nil, class: "mt-3 space-y-2" do %>
          <%= label_tag :version, t("admin.legal_pages.show.new_version"), class: "block text-xs font-semibold text-muted" %>
          <%= text_field_tag :version, nil, placeholder: t("admin.legal_pages.show.version_placeholder"), class: "field font-mono" %>
          <%= submit_tag t("admin.legal_pages.show.create_version"), class: "btn-accent w-full" %>
        <% end %>
      </section>

      <% if @page.published? && @page.notifiable? %>
        <section class="rounded-2xl border border-border bg-surface p-4">
          <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.legal_pages.show.notify_title") %></h2>
          <p class="mt-1 text-xs text-muted"><%= t("admin.legal_pages.show.notify_hint") %></p>
          <%= form_with url: admin_legal_page_notification_path(@page), method: :post, scope: nil, class: "mt-3" do %>
            <%= submit_tag t("admin.legal_pages.show.notify"), class: "btn-accent w-full",
                           data: { turbo_confirm: t("admin.legal_pages.show.notify_confirm") } %>
          <% end %>
        </section>
      <% end %>
    </aside>
  </div>
</div>
