<%= form_with model: @page, url: @page.persisted? ? admin_legal_page_path(@page) : admin_legal_pages_path,
              method: @page.persisted? ? :patch : :post, class: "space-y-5" do |form| %>
  <%= render "shared/form_errors", object: @page %>

  <div class="grid gap-4 rounded-2xl border border-border bg-surface p-4 sm:grid-cols-2 sm:p-5">
    <div>
      <%= form.label :country_code, t("admin.legal_pages.form.country"), class: "block text-sm font-semibold" %>
      <% if @page.persisted? %>
        <p class="mt-1 font-mono text-sm text-muted"><%= @page.country_code %></p>
      <% else %>
        <%= form.select :country_code, Country.order(:position, :code).map { |country| [country.name, country.code] }, {}, class: "field mt-1.5" %>
      <% end %>
    </div>
    <div>
      <%= form.label :locale, t("admin.legal_pages.form.locale"), class: "block text-sm font-semibold" %>
      <% if @page.persisted? %>
        <p class="mt-1 text-sm text-muted"><%= @page.locale.upcase %></p>
      <% else %>
        <%= form.select :locale, I18n.available_locales.map { |locale| [t("locale.names.#{locale}"), locale] }, {}, class: "field mt-1.5" %>
      <% end %>
    </div>
    <div>
      <%= form.label :kind, t("admin.legal_pages.form.kind"), class: "block text-sm font-semibold" %>
      <% if @page.persisted? %>
        <p class="mt-1 text-sm text-muted"><%= t("legal_pages.kinds.#{@page.kind}") %></p>
      <% else %>
        <%= form.select :kind, LegalPage::KINDS.map { |kind| [t("legal_pages.kinds.#{kind}"), kind] }, {}, class: "field mt-1.5" %>
      <% end %>
    </div>
    <div>
      <%= form.label :version, t("admin.legal_pages.form.version"), class: "block text-sm font-semibold" %>
      <%= form.text_field :version, class: "field mt-1.5 font-mono" %>
      <p class="mt-1 text-xs text-muted"><%= t("admin.legal_pages.form.version_hint") %></p>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :title, t("admin.legal_pages.form.title"), class: "block text-sm font-semibold" %>
      <%= form.text_field :title, class: "field mt-1.5" %>
    </div>
  </div>

  <div class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
    <%= form.label :body, t("admin.legal_pages.form.body"), class: "block text-sm font-semibold" %>
    <div class="mt-2"><%= form.rich_text_area :body, class: "field min-h-64" %></div>
    <p class="mt-1 text-xs text-muted"><%= t("admin.legal_pages.form.body_hint") %></p>
  </div>

  <div class="flex flex-wrap justify-end gap-2">
    <%= link_to t("admin.common.cancel"), @page.persisted? ? admin_legal_page_path(@page) : admin_legal_pages_path, class: "btn-accent" %>
    <%= submit_tag t("admin.common.save"), class: "btn-primary" %>
  </div>
<% end %>
