<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.legal_pages.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.legal_pages.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.legal_pages.index.count", count: @pages.size) %></p>
      <%= link_to t("admin.legal_pages.index.new"), new_admin_legal_page_path, class: "btn-primary" %>
    </div>
  </header>

  <%= form_with url: admin_legal_pages_path, method: :get, scope: nil, class: "rounded-2xl border border-border bg-surface px-4 py-4" do %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <%= label_tag :country_code, t("admin.legal_pages.filters.country"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :country_code, options_for_select([[t("admin.common.any"), ""]] + @countries.map { |country| [country.name, country.code] }, params[:country_code]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :locale, t("admin.legal_pages.filters.locale"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :locale, options_for_select([[t("admin.common.any"), ""]] + I18n.available_locales.map { |locale| [t("locale.names.#{locale}"), locale] }, params[:locale]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :kind, t("admin.legal_pages.filters.kind"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :kind, options_for_select([[t("admin.common.any"), ""]] + LegalPage::KINDS.map { |kind| [t("legal_pages.kinds.#{kind}"), kind] }, params[:kind]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :status, t("admin.legal_pages.filters.status"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :status, options_for_select([[t("admin.common.any"), ""], [t("admin.legal_pages.statuses.draft"), "draft"], [t("admin.legal_pages.statuses.published"), "published"]], params[:status]), class: "field mt-1.5" %>
      </div>
      <div class="flex items-end gap-2">
        <%= submit_tag t("admin.common.apply"), class: "btn-primary" %>
        <%= link_to t("admin.common.clear"), admin_legal_pages_path, class: "btn-accent" %>
      </div>
    </div>
  <% end %>

  <% if @pages.any? %>
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th class="px-4 py-3"><%= t("admin.legal_pages.table.country") %></th>
            <th class="px-4 py-3"><%= t("admin.legal_pages.table.locale") %></th>
            <th class="px-4 py-3"><%= t("admin.legal_pages.table.kind") %></th>
            <th class="px-4 py-3"><%= t("admin.legal_pages.table.title") %></th>
            <th class="px-4 py-3"><%= t("admin.legal_pages.table.version") %></th>
            <th class="px-4 py-3"><%= t("admin.legal_pages.table.status") %></th>
            <th class="px-4 py-3"><%= t("admin.legal_pages.table.effective") %></th>
            <th class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @pages.each do |page| %>
            <tr>
              <td class="px-4 py-3 font-mono text-xs"><%= page.country_code %></td>
              <td class="px-4 py-3 text-muted"><%= page.locale.upcase %></td>
              <td class="px-4 py-3"><%= t("legal_pages.kinds.#{page.kind}") %></td>
              <td class="px-4 py-3 font-semibold"><%= page.title %></td>
              <td class="px-4 py-3 font-mono text-xs"><%= page.version %></td>
              <td class="px-4 py-3">
                <span class="rounded-full border px-2 py-0.5 text-xs font-semibold <%= admin_status_badge_class(page.status) %>"><%= t("admin.legal_pages.statuses.#{page.status}") %></span>
              </td>
              <td class="px-4 py-3 text-muted"><%= page.effective_at ? l(page.effective_at.to_date, format: :short) : t("admin.common.none") %></td>
              <td class="px-4 py-3 text-right">
                <%= link_to t("admin.common.view"), admin_legal_page_path(page), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                <% if page.draft? %>
                  <%= link_to t("admin.common.edit"), edit_admin_legal_page_path(page), class: "ml-2 text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                <% end %>
                <%= link_to t("admin.legal_pages.index.compare"), admin_legal_page_comparison_path(page), class: "ml-2 text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.legal_pages.index.empty_title") %></h2>
      <p class="mt-2 text-sm text-muted"><%= t("admin.legal_pages.index.empty_body") %></p>
    </div>
  <% end %>
</div>
