<div class="space-y-6">
  <header>
    <%= link_to t("admin.countries.edit.back"), admin_countries_path, class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.countries.edit.title", country: @country.name) %></h1>
    <p class="mt-2 text-sm text-muted"><%= t("admin.countries.edit.subtitle") %></p>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-5">
      <%= form_with model: @country, url: admin_country_path(@country), method: :patch, class: "space-y-5" do |form| %>
        <%= render "shared/form_errors", object: @country %>

        <div class="grid gap-4 rounded-2xl border border-border bg-surface p-4 sm:grid-cols-2 sm:p-5">
          <div>
            <p class="text-sm font-semibold"><%= t("admin.countries.form.code") %></p>
            <p class="mt-1 font-mono text-sm text-muted"><%= @country.code %></p>
          </div>
          <div>
            <%= form.label :default_locale, t("admin.countries.form.default_locale"), class: "block text-sm font-semibold" %>
            <%= form.select :default_locale,
                            I18n.available_locales.map { |locale| [t("locale.names.#{locale}"), locale] },
                            {}, class: "field mt-1.5" %>
          </div>
          <div>
            <%= form.label :currency, t("admin.countries.form.currency"), class: "block text-sm font-semibold" %>
            <%= form.text_field :currency, maxlength: 3, class: "field mt-1.5 uppercase" %>
          </div>
          <div>
            <%= form.label :vat_rate, t("admin.countries.form.vat_rate"), class: "block text-sm font-semibold" %>
            <%= form.number_field :vat_rate, step: "0.01", min: 0, max: 100, class: "field mt-1.5" %>
          </div>
          <div>
            <%= form.label :position, t("admin.countries.form.position"), class: "block text-sm font-semibold" %>
            <%= form.number_field :position, min: 0, class: "field mt-1.5" %>
          </div>
          <label class="flex items-center gap-3 self-end text-sm">
            <%= form.check_box :active, class: "h-5 w-5 rounded border-border text-primary-600" %>
            <span><%= t("admin.countries.form.active") %></span>
          </label>
        </div>

        <div class="flex justify-end gap-2">
          <%= link_to t("admin.common.cancel"), admin_countries_path, class: "btn-accent" %>
          <%= submit_tag t("admin.common.save"), class: "btn-primary" %>
        </div>
      <% end %>
    </div>

    <aside class="space-y-4">
      <section class="rounded-2xl border border-border bg-surface p-4">
        <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.countries.checklist.title") %></h2>
        <p class="mt-1 text-xs text-muted"><%= t("admin.countries.checklist.subtitle") %></p>
        <ul class="mt-3 space-y-3 text-sm">
          <% @country.launch_checks.each do |check| %>
            <li class="rounded-xl border border-border p-3">
              <div class="flex items-center justify-between gap-2">
                <p class="font-semibold"><%= t("admin.countries.checklist.items.#{check[:key]}.title") %></p>
                <span class="rounded-full border px-2 py-0.5 text-[11px] font-semibold <%= check[:ok] ? admin_status_badge_class('active') : admin_status_badge_class('pending_review') %>">
                  <%= check[:ok] ? t("admin.countries.checklist.done") : t("admin.countries.checklist.pending") %>
                </span>
              </div>
              <% if check[:key] == "legal_pages" %>
                <% if check[:ok] %>
                  <p class="mt-1 text-xs text-muted"><%= t("admin.countries.checklist.items.legal_pages.done") %></p>
                <% else %>
                  <p class="mt-1 text-xs text-warning"><%= t("admin.countries.checklist.items.legal_pages.missing", kinds: check[:missing].map { |kind| t("legal_pages.kinds.#{kind}") }.to_sentence) %></p>
                <% end %>
                <%= link_to t("admin.countries.checklist.items.legal_pages.manage"), admin_legal_pages_path(country_code: @country.code, locale: @country.default_locale), class: "mt-2 inline-block text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              <% else %>
                <p class="mt-1 text-xs text-muted"><%= t("admin.countries.checklist.items.regions.count", count: check[:count]) %></p>
                <%= link_to t("admin.countries.checklist.items.regions.manage"), admin_country_regions_path(@country), class: "mt-2 inline-block text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    </aside>
  </div>
</div>
