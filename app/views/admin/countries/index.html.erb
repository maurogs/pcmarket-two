<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.countries.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.countries.index.subtitle") %></p>
    </div>
    <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.countries.index.count", count: @countries.size) %></p>
  </header>

  <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
    <table class="min-w-full divide-y divide-border text-sm">
      <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
        <tr>
          <th class="px-4 py-3"><%= t("admin.countries.table.country") %></th>
          <th class="px-4 py-3"><%= t("admin.countries.table.locale") %></th>
          <th class="px-4 py-3"><%= t("admin.countries.table.currency") %></th>
          <th class="px-4 py-3"><%= t("admin.countries.table.vat") %></th>
          <th class="px-4 py-3"><%= t("admin.countries.table.regions") %></th>
          <th class="px-4 py-3"><%= t("admin.countries.table.listings") %></th>
          <th class="px-4 py-3"><%= t("admin.countries.table.status") %></th>
          <th class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @countries.each do |country| %>
          <% checks = country.launch_checks %>
          <% ready = checks.all? { |check| check[:ok] } %>
          <tr>
            <td class="px-4 py-3">
              <p class="font-semibold"><%= country.name %> <span class="font-mono text-xs text-muted"><%= country.code %></span></p>
            </td>
            <td class="px-4 py-3 text-muted"><%= country.default_locale.upcase %></td>
            <td class="px-4 py-3 text-muted"><%= country.currency %></td>
            <td class="px-4 py-3 text-muted"><%= number_to_percentage(country.vat_rate, precision: 0) %></td>
            <td class="px-4 py-3 text-muted"><%= country.regions.size %></td>
            <td class="px-4 py-3 text-muted"><%= Listing.where(country_code: country.code).count %></td>
            <td class="px-4 py-3">
              <span class="rounded-full border px-2 py-0.5 text-xs font-semibold <%= admin_status_badge_class(country.active? ? 'active' : 'draft') %>">
                <%= country.active? ? t("admin.countries.statuses.active") : t("admin.countries.statuses.inactive") %>
              </span>
              <% unless country.active? || ready %>
                <p class="mt-1 text-[11px] text-warning"><%= t("admin.countries.table.not_ready") %></p>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("admin.countries.table.regions"), admin_country_regions_path(country), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              <%= link_to t("admin.common.edit"), edit_admin_country_path(country), class: "ml-2 text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
