<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.orders.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.orders.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.orders.index.count", count: @query.pagy.count) %></p>
      <%= link_to t("admin.common.export_csv"), admin_orders_path(request.query_parameters.merge(format: :csv)), class: "btn-accent" %>
    </div>
  </header>

  <%= form_with url: admin_orders_path, method: :get, scope: nil, class: "rounded-2xl border border-border bg-surface px-4 py-4" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <%= label_tag :q, t("admin.orders.filters.search"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= search_field_tag :q, @query.filters[:q], placeholder: t("admin.orders.filters.search_placeholder"), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :per_page, t("admin.common.per_page"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :per_page, options_for_select(Admin::Filterable::PER_PAGE_OPTIONS, @query.per_page), class: "field mt-1.5", onchange: "this.form.requestSubmit()" %>
      </div>
      <%= submit_tag t("admin.common.apply"), class: "btn-primary" %>
      <%= link_to t("admin.common.clear"), admin_orders_path, class: "btn-accent" %>
    </div>

    <details class="mt-4 rounded-xl border border-border bg-surface-muted/60 px-4 py-3" <%= "open" if admin_filters_active?(@query.filters) %>>
      <summary class="cursor-pointer text-sm font-semibold text-content"><%= t("admin.orders.filters.title") %></summary>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <%= label_tag :status, t("admin.orders.filters.status"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= select_tag :status, options_for_select([[t("admin.common.any"), ""]] + Admin::OrderQuery::FILTERABLE_STATUSES.map { |s| [order_status_label(s), s] }, @query.filters[:status]), class: "field mt-1.5" %>
        </div>
        <div>
          <%= label_tag :store_id, t("admin.orders.filters.store"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= select_tag :store_id, options_for_select([[t("admin.common.any"), ""]] + @query.stores.map { |s| [s.name, s.id] }, @query.filters[:store_id]), class: "field mt-1.5" %>
        </div>
        <div>
          <%= label_tag :buyer_id, t("admin.orders.filters.buyer_id"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= number_field_tag :buyer_id, @query.filters[:buyer_id], min: 1, class: "field mt-1.5" %>
        </div>
        <div>
          <%= label_tag :fulfilment, t("admin.orders.filters.fulfilment"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= select_tag :fulfilment, options_for_select([[t("admin.common.any"), ""]] + Admin::OrderQuery::FILTERABLE_FULFILMENTS.map { |f| [t("orders.fulfilments.#{f}"), f] }, @query.filters[:fulfilment]), class: "field mt-1.5" %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <%= label_tag :date_from, t("admin.common.from"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= date_field_tag :date_from, @query.filters[:date_from], class: "field mt-1.5" %>
          </div>
          <div>
            <%= label_tag :date_to, t("admin.common.to"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= date_field_tag :date_to, @query.filters[:date_to], class: "field mt-1.5" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <%= label_tag :amount_min, t("admin.orders.filters.amount_min"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= number_field_tag :amount_min, @query.filters[:amount_min], step: "0.01", min: 0, class: "field mt-1.5" %>
          </div>
          <div>
            <%= label_tag :amount_max, t("admin.orders.filters.amount_max"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
            <%= number_field_tag :amount_max, @query.filters[:amount_max], step: "0.01", min: 0, class: "field mt-1.5" %>
          </div>
        </div>
        <div>
          <%= label_tag :disputed, t("admin.orders.filters.disputed"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
          <%= select_tag :disputed, options_for_select([[t("admin.common.any"), ""], [t("admin.common.yes"), "true"], [t("admin.common.no"), "false"]], @query.filters[:disputed].nil? ? "" : @query.filters[:disputed].to_s), class: "field mt-1.5" %>
        </div>
      </div>
    </details>
  <% end %>

  <% if @query.records.any? %>
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.orders.table.number"), "number", query: @query, path: :admin_orders_path) %></th>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.orders.table.status"), "status", query: @query, path: :admin_orders_path) %></th>
            <th scope="col" class="px-4 py-3"><%= t("admin.orders.table.buyer") %></th>
            <th scope="col" class="px-4 py-3"><%= t("admin.orders.table.store") %></th>
            <th scope="col" class="px-4 py-3"><%= t("admin.orders.table.fulfilment") %></th>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.orders.table.total"), "total", query: @query, path: :admin_orders_path) %></th>
            <th scope="col" class="px-4 py-3"><%= t("admin.orders.table.commission") %></th>
            <th scope="col" class="px-4 py-3"><%= admin_sort_link(t("admin.orders.table.created"), "created_at", query: @query, path: :admin_orders_path) %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @query.records.each do |order| %>
            <tr class="align-middle">
              <td class="whitespace-nowrap px-4 py-3"><%= link_to order.number, admin_order_path(order), class: "font-semibold text-content underline-offset-2 hover:underline" %></td>
              <td class="whitespace-nowrap px-4 py-3">
                <span class="rounded-full border px-2 py-0.5 text-xs font-semibold <%= admin_status_badge_class(order.status) %>"><%= order_status_label(order.status) %></span>
              </td>
              <td class="px-4 py-3 text-muted"><%= order.buyer&.display_name || t("admin.orders.guest_buyer") %></td>
              <td class="px-4 py-3 text-muted"><%= order.store&.name %></td>
              <td class="px-4 py-3 text-muted"><%= order_fulfilment_label(order) %></td>
              <td class="whitespace-nowrap px-4 py-3 font-semibold"><%= money(order.total_cents, currency: order.currency) %></td>
              <td class="whitespace-nowrap px-4 py-3 text-muted"><%= money(order.commission_cents, currency: order.currency) %></td>
              <td class="whitespace-nowrap px-4 py-3 text-muted"><%= l(order.created_at, format: :short) %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right"><%= link_to t("admin.common.view"), admin_order_path(order), class: "font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagy_nav(@query.pagy) %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.orders.index.empty_title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("admin.orders.index.empty_body") %></p>
    </div>
  <% end %>
</div>
