<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.cpu_tiers.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.cpu_tiers.index.subtitle") %></p>
    </div>
    <%= link_to t("admin.cpu_tiers.index.new"), new_admin_cpu_tier_path, class: "btn-primary" %>
  </header>

  <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
    <table class="min-w-full divide-y divide-border text-sm">
      <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
        <tr>
          <th class="px-4 py-3"><%= t("admin.cpu_tiers.table.pattern") %></th>
          <th class="px-4 py-3"><%= t("admin.cpu_tiers.table.tier") %></th>
          <th class="px-4 py-3"><%= t("admin.cpu_tiers.table.position") %></th>
          <th class="px-4 py-3"><%= t("admin.cpu_tiers.table.active") %></th>
          <th class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @tiers.each do |tier| %>
          <tr>
            <td class="px-4 py-3 font-mono text-xs"><%= tier.pattern %></td>
            <td class="px-4 py-3 font-semibold"><%= tier.tier %></td>
            <td class="px-4 py-3 text-muted"><%= tier.position %></td>
            <td class="px-4 py-3"><%= tier.active? ? t("admin.common.yes") : t("admin.common.no") %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("admin.common.edit"), edit_admin_cpu_tier_path(tier), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              <%= link_to t("admin.common.delete"), admin_cpu_tier_path(tier),
                          data: { turbo_method: :delete, turbo_confirm: t("admin.cpu_tiers.index.delete_confirm") },
                          class: "ml-2 text-xs font-semibold text-danger underline-offset-2 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
