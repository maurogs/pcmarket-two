<div class="space-y-6">
  <header>
    <%= link_to t("admin.tags.form.back"), admin_tags_path, class: "text-sm font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.tags.edit.title", name: @tag.name.presence || @tag.slug) %></h1>
    <p class="mt-2 text-sm text-muted"><%= t("admin.tags.edit.subtitle") %></p>
  </header>
  <%= render "form" %>
</div>
