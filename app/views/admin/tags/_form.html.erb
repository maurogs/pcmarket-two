<%= form_with model: @tag, url: @tag.persisted? ? admin_tag_path(@tag) : admin_tags_path,
              method: @tag.persisted? ? :patch : :post, class: "space-y-5" do |form| %>
  <%= render "shared/form_errors", object: @tag %>

  <%= translatable_form_field(form, @tag, :name, label: t("admin.tags.form.name"), required: true) %>

  <div class="grid gap-4 rounded-2xl border border-border bg-surface p-4 sm:grid-cols-2 sm:p-5">
    <div>
      <%= form.label :kind, t("admin.tags.form.kind"), class: "block text-sm font-semibold" %>
      <%= form.select :kind, Tag.kinds.keys.map { |kind| [t("admin.tags.kinds.#{kind}"), kind] },
                      {}, class: "field mt-1.5", disabled: @tag.persisted? %>
      <% if @tag.persisted? %>
        <p class="mt-1 text-xs text-muted"><%= t("admin.tags.form.kind_locked") %></p>
      <% end %>
    </div>

    <div data-controller="colour_preview"
         data-colour-preview-styles-value="<%= html_escape(admin_tag_colour_styles.to_json) %>">
      <%= form.label :colour, t("admin.tags.form.colour"), class: "block text-sm font-semibold" %>
      <%= form.select :colour,
                      Tag::COLOURS.map { |colour| [t("admin.tags.colours.#{colour}"), colour] },
                      { include_blank: t("admin.tags.colours.none") },
                      class: "field mt-1.5",
                      data: { colour_preview_target: "select", action: "change->colour_preview#update" } %>
      <div class="mt-3 flex items-center gap-2 text-xs text-muted">
        <span><%= t("admin.tags.form.preview") %></span>
        <span data-colour-preview-target="preview" class="inline-flex items-center rounded-full border border-border bg-surface-muted px-2.5 py-1 text-xs font-semibold text-muted"><%= @tag.name.presence || @tag.slug || t("admin.tags.form.preview_label") %></span>
      </div>
    </div>

    <div>
      <%= form.label :position, t("admin.tags.form.position"), class: "block text-sm font-semibold" %>
      <%= form.number_field :position, min: 0, class: "field mt-1.5" %>
    </div>

    <label class="flex items-center gap-3 self-end text-sm">
      <%= form.check_box :active, class: "h-5 w-5 rounded border-border text-primary-600" %>
      <span><%= t("admin.tags.form.active") %></span>
    </label>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <% if @tag.persisted? && @tag.listings.none? %>
        <%= link_to t("admin.tags.form.delete"), admin_tag_path(@tag),
                    data: { turbo_method: :delete, turbo_confirm: t("admin.tags.form.delete_confirm") },
                    class: "text-sm font-semibold text-danger underline-offset-2 hover:underline" %>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("admin.common.cancel"), admin_tags_path, class: "btn-accent" %>
      <%= submit_tag t("admin.common.save"), class: "btn-primary" %>
    </div>
  </div>
<% end %>
