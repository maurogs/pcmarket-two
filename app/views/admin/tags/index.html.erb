<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.tags.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.tags.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.tags.index.count", count: @tags.length) %></p>
      <%= link_to t("admin.tags.index.new"), new_admin_tag_path, class: "btn-primary" %>
    </div>
  </header>

  <%= form_with url: admin_tags_path, method: :get, scope: nil, class: "rounded-2xl border border-border bg-surface px-4 py-4" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <%= label_tag :q, t("admin.tags.filters.search"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= search_field_tag :q, params[:q], placeholder: t("admin.tags.filters.search_placeholder"), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :kind, t("admin.tags.filters.kind"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :kind, options_for_select([[t("admin.common.any"), ""]] + Tag.kinds.keys.map { |kind| [t("admin.tags.kinds.#{kind}"), kind] }, params[:kind]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :active, t("admin.tags.filters.active"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :active, options_for_select([[t("admin.common.any"), ""], [t("admin.common.yes"), "true"], [t("admin.common.no"), "false"]], params[:active]), class: "field mt-1.5" %>
      </div>
      <%= submit_tag t("admin.common.apply"), class: "btn-primary" %>
      <%= link_to t("admin.common.clear"), admin_tags_path, class: "btn-accent" %>
    </div>
  <% end %>

  <% if @tags.any? %>
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th class="px-4 py-3"><%= t("admin.tags.table.name") %></th>
            <th class="px-4 py-3"><%= t("admin.tags.table.kind") %></th>
            <th class="px-4 py-3"><%= t("admin.tags.table.colour") %></th>
            <th class="px-4 py-3"><%= t("admin.tags.table.usage") %></th>
            <th class="px-4 py-3"><%= t("admin.tags.table.active") %></th>
            <th class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @tags.each do |tag| %>
            <tr>
              <td class="px-4 py-3">
                <p class="font-semibold"><%= tag.name.presence || tag.slug %></p>
                <p class="font-mono text-xs text-muted"><%= tag.slug %></p>
              </td>
              <td class="px-4 py-3 text-muted"><%= t("admin.tags.kinds.#{tag.kind}") %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold <%= admin_tag_colour_classes(tag.colour) %>"><%= tag.name.presence || tag.slug %></span>
              </td>
              <td class="px-4 py-3 text-muted"><%= t("admin.tags.table.listings", count: tag.usage_count.to_i) %></td>
              <td class="px-4 py-3">
                <span class="rounded-full border px-2 py-0.5 text-xs font-semibold <%= admin_status_badge_class(tag.active? ? 'active' : 'draft') %>">
                  <%= tag.active? ? t("admin.categories.statuses.active") : t("admin.categories.statuses.inactive") %>
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to t("admin.common.edit"), edit_admin_tag_path(tag), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                <%= link_to t("admin.common.delete"), admin_tag_path(tag),
                            data: { turbo_method: :delete, turbo_confirm: t("admin.tags.index.delete_confirm") },
                            class: "ml-2 text-xs font-semibold text-danger underline-offset-2 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= form_with url: admin_tag_positions_path, method: :patch, scope: nil, class: "rounded-2xl border border-border bg-surface p-4",
                  data: { controller: "sortable", sortable_name_value: "ordered_ids[]" } do %>
      <h2 class="text-sm font-bold uppercase tracking-widest text-muted"><%= t("admin.tags.index.reorder_title") %></h2>
      <p class="mt-1 text-xs text-muted"><%= t("admin.tags.index.reorder_hint") %></p>
      <div data-sortable-target="order"></div>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2" data-sortable-target="list">
        <% @tags.each do |tag| %>
          <li data-sortable-target="item"
              data-sortable-id="<%= tag.id %>"
              draggable="true"
              data-action="dragstart->sortable#dragStart dragover->sortable#dragOver dragend->sortable#dragEnd drop->sortable#drop"
              class="flex items-center gap-3 rounded-lg border border-border bg-surface-muted/40 p-2 text-sm">
            <span class="cursor-grab select-none text-muted" aria-hidden="true">⠿</span>
            <span class="font-medium"><%= tag.name.presence || tag.slug %></span>
            <span class="ml-auto text-xs text-muted"><%= t("admin.tags.kinds.#{tag.kind}") %></span>
          </li>
        <% end %>
      </ul>
      <div class="mt-3 flex justify-end"><%= submit_tag t("admin.tags.index.reorder_submit"), class: "btn-accent" %></div>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.tags.index.empty_title") %></h2>
      <p class="mt-2 text-sm text-muted"><%= t("admin.tags.index.empty_body") %></p>
    </div>
  <% end %>
</div>
