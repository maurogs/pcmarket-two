<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.dashboard.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.dashboard.subtitle") %></p>
    </div>
    <%= link_to t("admin.nav.moderation"), admin_listing_reviews_path, class: "btn-primary" %>
  </header>

  <section aria-label="<%= t("admin.dashboard.title") %>">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% Admin::DashboardStats::KPI_KEYS.each do |key| %>
        <li class="rounded-2xl border border-border bg-surface p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted"><%= admin_kpi_label(key) %></p>
          <p data-kpi="<%= key %>" class="mt-2 text-3xl font-extrabold tracking-tight text-content"><%= @stats.public_send(key) %></p>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="overflow-hidden rounded-2xl border border-border bg-surface">
    <div class="border-b border-border px-4 py-4 sm:px-6">
      <h2 class="text-lg font-bold"><%= t("admin.dashboard.oldest_pending.title") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("admin.dashboard.oldest_pending.subtitle") %></p>
    </div>

    <% if @pending_listings.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-border text-sm">
          <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
            <tr>
              <th scope="col" class="px-4 py-3"><%= t("admin.dashboard.oldest_pending.listing") %></th>
              <th scope="col" class="px-4 py-3"><%= t("admin.dashboard.oldest_pending.seller") %></th>
              <th scope="col" class="px-4 py-3"><%= t("admin.dashboard.oldest_pending.category") %></th>
              <th scope="col" class="px-4 py-3"><%= t("admin.dashboard.oldest_pending.price") %></th>
              <th scope="col" class="px-4 py-3"><%= t("admin.dashboard.oldest_pending.waiting") %></th>
              <th scope="col" class="px-4 py-3 text-right"><%= t("admin.dashboard.oldest_pending.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @pending_listings.each do |listing| %>
              <tr class="align-middle">
                <td class="px-4 py-3">
                  <p class="font-semibold text-content"><%= listing.title.presence || t("sell.listings.untitled") %></p>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-muted"><%= listing.seller.display_name %></td>
                <td class="whitespace-nowrap px-4 py-3 text-muted"><%= listing.category&.name %></td>
                <td class="whitespace-nowrap px-4 py-3 font-semibold text-content">
                  <%= listing.price_cents ? money(listing.price_cents, currency: listing.currency) : "—" %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-muted">
                  <%= t("admin.dashboard.oldest_pending.waiting_for", time: time_ago_in_words(listing.submitted_at || listing.created_at)) %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-right">
                  <%= link_to t("admin.dashboard.oldest_pending.review"),
                              admin_listing_review_path(listing),
                              class: "font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-4 py-10 text-center text-sm text-muted sm:px-6"><%= t("admin.dashboard.oldest_pending.empty") %></p>
    <% end %>
  </section>
</div>
