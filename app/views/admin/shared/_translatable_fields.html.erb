<div class="rounded-2xl border border-border bg-surface p-4 sm:p-5" data-controller="translatable_tabs">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm font-semibold text-content"><%= label %></p>
    <p class="text-xs text-muted"><%= t("admin.translatable.fallback_hint") %></p>
  </div>

  <div role="tablist" aria-label="<%= label %>" class="mt-3 flex flex-wrap gap-1 rounded-xl bg-surface-muted p-1">
    <% I18n.available_locales.each_with_index do |locale, index| %>
      <% value = record.public_send("#{attribute}_#{locale}") %>
      <% input_id = "#{record.model_name.param_key}_#{attribute}_#{record.id || 'new'}_#{locale}" %>
      <button type="button"
              id="<%= input_id %>_tab"
              role="tab"
              aria-controls="<%= input_id %>_panel"
              aria-selected="<%= index.zero? %>"
              tabindex="<%= index.zero? ? 0 : -1 %>"
              data-translatable-tabs-target="tab"
              data-locale="<%= locale %>"
              data-action="translatable_tabs#select keydown->translatable_tabs#navigate"
              class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wide transition <%= index.zero? ? 'bg-surface text-content shadow-sm' : 'text-muted hover:text-content' %>">
        <%= locale %>
        <span data-translatable-tabs-target="dot"
              data-locale="<%= locale %>"
              class="h-1.5 w-1.5 rounded-full <%= value.present? ? 'bg-success' : 'bg-danger' %>"
              aria-label="<%= value.present? ? t("admin.translatable.filled") : t("admin.translatable.missing") %>"
              title="<%= value.present? ? t("admin.translatable.filled") : t("admin.translatable.missing") %>"></span>
        <% if locale.to_s == "es" && required %>
          <span aria-hidden="true" class="text-danger">*</span>
        <% end %>
      </button>
    <% end %>
  </div>

  <% I18n.available_locales.each_with_index do |locale, index| %>
    <% field_name = "#{attribute}_#{locale}" %>
    <% input_id = "#{record.model_name.param_key}_#{attribute}_#{record.id || 'new'}_#{locale}" %>
    <div id="<%= input_id %>_panel"
         role="tabpanel"
         aria-labelledby="<%= input_id %>_tab"
         data-translatable-tabs-target="panel"
         data-locale="<%= locale %>"
         class="mt-3 <%= index.zero? ? '' : 'hidden' %>">
      <%= form.label field_name, label, class: "sr-only" %>
      <% options = { class: "field mt-1.5", id: input_id, required: locale.to_s == "es" && required,
                     data: { translatable_tabs_target: "field", locale: locale,
                             action: "input->translatable_tabs#refresh" } } %>
      <% if type == :textarea %>
        <%= form.text_area field_name, options.merge(rows: rows) %>
      <% else %>
        <%= form.text_field field_name, options %>
      <% end %>
    </div>
  <% end %>
</div>
