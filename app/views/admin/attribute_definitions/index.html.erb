<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.attribute_definitions.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.attribute_definitions.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.attribute_definitions.index.count", count: @query.pagy.count) %></p>
      <%= link_to t("admin.attribute_definitions.index.new"), new_admin_attribute_definition_path, class: "btn-primary" %>
    </div>
  </header>

  <%= form_with url: admin_attribute_definitions_path, method: :get, scope: nil,
                class: "rounded-2xl border border-border bg-surface px-4 py-4" do %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <%= label_tag :q, t("admin.attribute_definitions.filters.search"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= search_field_tag :q, @query.filters[:q], placeholder: t("admin.attribute_definitions.filters.search_placeholder"), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :group, t("admin.attribute_definitions.filters.group"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :group, options_for_select([[t("admin.common.any"), ""]] + @query.groups.map { |group| [group, group] }, @query.filters[:group]), class: "field mt-1.5" %>
      </div>
      <div>
        <%= label_tag :active, t("admin.attribute_definitions.filters.active"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
        <%= select_tag :active, options_for_select([[t("admin.common.any"), ""], [t("admin.common.yes"), "true"], [t("admin.common.no"), "false"]], @query.filters[:active].nil? ? "" : @query.filters[:active].to_s), class: "field mt-1.5" %>
      </div>
      <%= submit_tag t("admin.common.apply"), class: "btn-primary" %>
      <%= link_to t("admin.common.clear"), admin_attribute_definitions_path, class: "btn-accent" %>
    </div>
  <% end %>

  <% if @query.records.any? %>
    <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
      <table class="min-w-full divide-y divide-border text-sm">
        <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-widest text-muted">
          <tr>
            <th class="px-4 py-3"><%= admin_sort_link(t("admin.attribute_definitions.table.key"), "key", query: @query, path: :admin_attribute_definitions_path) %></th>
            <th class="px-4 py-3"><%= t("admin.attribute_definitions.table.name") %></th>
            <th class="px-4 py-3"><%= admin_sort_link(t("admin.attribute_definitions.table.group"), "group", query: @query, path: :admin_attribute_definitions_path) %></th>
            <th class="px-4 py-3"><%= t("admin.attribute_definitions.table.input_type") %></th>
            <th class="px-4 py-3"><%= t("admin.attribute_definitions.table.options") %></th>
            <th class="px-4 py-3"><%= t("admin.attribute_definitions.table.active") %></th>
            <th class="px-4 py-3 text-right"><%= t("admin.common.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @query.records.each do |definition| %>
            <tr>
              <td class="px-4 py-3 font-mono text-xs"><%= definition.key %></td>
              <td class="px-4 py-3 font-semibold"><%= definition.name.presence || definition.key %></td>
              <td class="px-4 py-3 text-muted"><%= definition.group.presence || t("admin.common.none") %></td>
              <td class="px-4 py-3 text-muted"><%= t("admin.attribute_definitions.input_types.#{definition.input_type}") %></td>
              <td class="px-4 py-3 text-muted"><%= definition.attribute_options.size %></td>
              <td class="px-4 py-3">
                <span class="rounded-full border px-2 py-0.5 text-xs font-semibold <%= admin_status_badge_class(definition.active? ? 'active' : 'draft') %>">
                  <%= definition.active? ? t("admin.categories.statuses.active") : t("admin.categories.statuses.inactive") %>
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to t("admin.common.edit"), edit_admin_attribute_definition_path(definition), class: "text-xs font-semibold text-primary-700 underline-offset-2 hover:underline dark:text-primary-300" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagy_nav(@query.pagy) %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.attribute_definitions.index.empty_title") %></h2>
      <p class="mt-2 text-sm text-muted"><%= t("admin.attribute_definitions.index.empty_body") %></p>
    </div>
  <% end %>
</div>
