<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.features.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("admin.features.index.subtitle") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-muted"><%= t("admin.features.index.count", count: @features.size) %></p>
      <%= link_to t("admin.features.index.flipper_ui"), "/admin/flipper", class: "btn-accent" %>
    </div>
  </header>

  <% if @features.any? %>
    <div class="space-y-3">
      <% @features.each do |feature| %>
        <%= form_with url: admin_feature_path(feature[:name]), method: :patch, scope: nil,
                      class: "grid gap-4 rounded-2xl border border-border bg-surface p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:p-5" do %>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-mono text-sm font-bold"><%= feature[:name] %></h2>
              <span class="rounded-full border px-2 py-0.5 text-[11px] font-semibold <%= admin_status_badge_class(feature[:enabled] ? 'active' : 'draft') %>">
                <%= feature[:enabled] ? t("admin.features.index.on") : t("admin.features.index.off") %>
              </span>
            </div>
            <p class="mt-1 text-sm text-muted"><%= feature[:description] %></p>
            <p class="mt-1 text-xs text-muted"><%= t("admin.features.index.percentage_label", percentage: feature[:percentage]) %></p>
          </div>

          <div class="flex flex-wrap items-end justify-end gap-3">
            <label class="inline-flex items-center gap-2 text-sm">
              <%= hidden_field_tag :enabled, "0", id: nil %>
              <%= check_box_tag :enabled, "1", feature[:enabled], id: "feature_#{feature[:name]}_enabled",
                                class: "h-5 w-5 rounded border-border text-primary-600" %>
              <span><%= t("admin.features.index.enabled") %></span>
            </label>
            <div>
              <%= label_tag "feature_#{feature[:name]}_percentage", t("admin.features.index.percentage"), class: "block text-xs font-semibold text-muted" %>
              <%= number_field_tag :percentage, feature[:percentage], min: 0, max: 100, step: 1,
                                   id: "feature_#{feature[:name]}_percentage", class: "field mt-1 w-24" %>
            </div>
            <%= submit_tag t("admin.features.index.update"), class: "btn-primary" %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("admin.features.index.empty_title") %></h2>
      <p class="mt-2 text-sm text-muted"><%= t("admin.features.index.empty_body") %></p>
    </div>
  <% end %>
</div>
