<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("admin.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("admin.reports.show.title", id: @report.id) %></h1>
      <p class="mt-2 text-sm text-muted"><%= l(@report.created_at, format: :long) %></p>
    </div>
    <%= link_to t("admin.reports.show.back"), admin_reports_path, class: "btn-accent" %>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-lg font-bold"><%= t("admin.reports.show.report_title") %></h2>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2 text-sm">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("admin.reports.show.reason") %></dt>
            <dd class="mt-1 font-semibold text-content"><%= report_reason_label(@report.reason) %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("admin.reports.show.status") %></dt>
            <dd class="mt-1 font-semibold text-content"><%= report_status_label(@report.status) %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("admin.reports.show.reporter") %></dt>
            <dd class="mt-1 text-content"><%= @report.reporter&.display_name || t("admin.reports.anonymous") %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("admin.reports.show.contact") %></dt>
            <dd class="mt-1 break-all text-content"><%= @report.contact_email.presence || "—" %></dd>
          </div>
        </dl>
        <div class="mt-4 rounded-xl bg-surface-muted p-4 text-sm leading-relaxed text-content">
          <%= simple_format(h(@report.details)) %>
        </div>
      </section>

      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-lg font-bold"><%= t("admin.reports.show.reported_item") %></h2>
        <p class="mt-1 text-xs font-semibold uppercase tracking-widest text-muted"><%= report_type_label(@report.reportable_type) %></p>

        <div class="mt-4 rounded-xl border border-border bg-surface-muted p-4 text-sm">
          <% case @report.reportable %>
          <% when Listing %>
            <% listing = @report.reportable %>
            <p class="font-bold text-content"><%= listing.title %></p>
            <p class="mt-1 text-muted"><%= listing.store&.name %> · <%= status_label(listing) %> · <%= money(listing.price_cents, currency: listing.currency) %></p>
            <%= link_to t("admin.reports.show.view_public"), listing_path(listing), class: "mt-2 inline-block text-xs font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
          <% when Store %>
            <% store = @report.reportable %>
            <p class="font-bold text-content"><%= store.name %></p>
            <p class="mt-1 text-muted"><%= store.user&.display_name %> · <%= t("admin.reports.store_statuses.#{store.status}") %></p>
            <%= link_to t("admin.reports.show.view_public"), storefront_path(store), class: "mt-2 inline-block text-xs font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
          <% when Message %>
            <% message = @report.reportable %>
            <p class="text-xs text-muted"><%= t("admin.reports.show.message_sender", name: message.sender.display_name) %></p>
            <p class="mt-1 whitespace-pre-line text-content"><%= message.body %></p>
            <p class="mt-2 text-xs text-muted"><%= t("admin.reports.show.message_hidden", hidden: (message.hidden_at.present? ? t("admin.reports.yes") : t("admin.reports.no"))) %></p>
          <% when User %>
            <% user = @report.reportable %>
            <p class="font-bold text-content"><%= user.display_name %></p>
            <p class="mt-1 break-all text-muted"><%= user.email %> · @<%= user.username %></p>
            <p class="mt-1 text-muted"><%= t("admin.reports.show.user_banned", banned: (user.banned? ? t("admin.reports.yes") : t("admin.reports.no"))) %></p>
          <% end %>
        </div>
      </section>

      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-lg font-bold"><%= t("admin.reports.show.history_title") %></h2>
        <% if @history.any? %>
          <ul class="mt-3 divide-y divide-border">
            <% @history.each do |report| %>
              <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
                <span>
                  <span class="font-semibold text-content">#<%= report.id %></span>
                  <span class="text-muted">· <%= report_reason_label(report.reason) %> · <%= report_status_label(report.status) %></span>
                </span>
                <span class="text-xs text-muted"><%= l(report.created_at, format: :short) %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-3 text-sm text-muted"><%= t("admin.reports.show.history_empty") %></p>
        <% end %>
      </section>
    </div>

    <aside class="space-y-4">
      <% if @report.resolved? %>
        <section class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="text-lg font-bold"><%= t("admin.reports.show.decision_title") %></h2>
          <p class="mt-2 text-sm font-semibold text-content"><%= report_status_label(@report.status) %></p>
          <p class="mt-1 text-xs text-muted">
            <%= t("admin.reports.show.handled_by", name: @report.handled_by&.display_name || "—") %>
            · <%= @report.handled_at ? l(@report.handled_at, format: :short) : "—" %>
          </p>
          <p class="mt-3 rounded-xl bg-surface-muted p-3 text-sm text-content"><%= @report.resolution_note %></p>
        </section>
      <% else %>
        <section class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="text-lg font-bold"><%= t("admin.reports.show.decision_title") %></h2>
          <p class="mt-1 text-xs text-muted"><%= t("admin.reports.show.decision_hint") %></p>

          <%= form_with url: admin_report_path(@report), method: :patch, scope: nil, class: "mt-4 space-y-3" do %>
            <div>
              <%= label_tag :resolution_note, t("admin.reports.show.note"), class: "block text-xs font-semibold uppercase tracking-widest text-muted" %>
              <%= text_area_tag :resolution_note, nil, rows: 4, class: "field mt-1.5 w-full", placeholder: t("admin.reports.show.note_placeholder") %>
            </div>
            <div class="space-y-2">
              <%= submit_tag t("admin.reports.show.dismiss"), name: "decision", value: "dismiss", class: "btn-accent w-full" %>
              <%= submit_tag t("admin.reports.show.take_action"), name: "decision", value: "action", class: "btn-primary w-full" %>
            </div>
          <% end %>

          <p class="mt-3 text-[11px] leading-relaxed text-muted"><%= t("admin.reports.show.action_effect.#{@report.reportable_type.underscore}") %></p>
        </section>
      <% end %>
    </aside>
  </div>
</div>
