<% set_meta_tags(title: @conversation.display_title, noindex: true) %>
<% other = conversation_counterparty(@conversation, current_user) %>

<div class="mx-auto flex min-h-[calc(100vh-9rem)] max-w-4xl flex-col"
     data-controller="chat"
     data-chat-current-user-id-value="<%= current_user.id %>">
  <header class="flex items-center gap-3 border-b border-border pb-4">
    <%= link_to conversations_path, class: "icon-button md:hidden", aria: { label: t("conversations.show.back") } do %>
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    <% end %>
    <%= conversation_avatar_tag(other, size: "h-11 w-11") %>
    <div class="min-w-0 flex-1">
      <p class="truncate text-base font-extrabold text-content"><%= other.display_name %></p>
      <p class="truncate text-xs text-muted">@<%= other.username %></p>
    </div>
    <div class="flex items-center gap-1">
      <%= link_to t("reports.link"),
                  new_report_path(reportable_type: "User", reportable_id: other.id),
                  class: "text-xs font-semibold text-muted underline-offset-2 hover:text-danger hover:underline" %>
      <%= button_to t("blocks.block"),
                    blocks_path,
                    params: { blocked_user_id: other.id },
                    class: "rounded-lg border border-border bg-surface px-2 py-1 text-xs font-semibold text-danger hover:bg-danger-soft" %>
    </div>
  </header>

  <% if @conversation.listing.present? %>
    <% listing = @conversation.listing %>
    <section class="mt-4 flex items-center gap-3 rounded-2xl border border-border bg-surface p-3">
      <% photo = listing.primary_photo %>
      <span class="h-14 w-14 shrink-0 overflow-hidden rounded-xl border border-border bg-surface-muted">
        <% if photo&.image&.attached? %>
          <%= image_tag url_for(photo.image.variant(:thumb)), alt: "", class: "h-full w-full object-cover" %>
        <% end %>
      </span>
      <div class="min-w-0 flex-1">
        <%= link_to listing.title, listing_path(listing), class: "block truncate text-sm font-bold text-content hover:text-primary-700 dark:hover:text-primary-300" %>
        <p class="mt-0.5 text-sm font-extrabold text-content"><%= money(listing.price_cents, currency: listing.currency) %></p>
      </div>
      <span class="shrink-0 rounded-full border border-border bg-surface-muted px-2.5 py-1 text-[11px] font-semibold text-muted"><%= status_label(listing) %></span>
    </section>
  <% end %>

  <% if Flipper.enabled?(:offers) %>
    <% pending_offers = @offers.select { |offer| offer_actionable?(offer, current_user) } %>
    <% redeemable_offers = @offers.select { |offer| offer_redeemable?(offer, current_user) } %>
    <% if pending_offers.any? || redeemable_offers.any? %>
      <section class="mt-4 space-y-3 rounded-2xl border border-primary-200 bg-primary-50 p-4 dark:border-primary-800 dark:bg-primary-900/30">
        <% pending_offers.each do |offer| %>
          <div class="rounded-xl border border-border bg-surface p-3">
            <p class="text-sm font-bold text-content"><%= t("offers.actions.pending", amount: offer_amount(offer)) %></p>
            <% if offer.message.present? %>
              <p class="mt-1 text-xs text-muted"><%= offer.message %></p>
            <% end %>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <%= button_to t("offers.actions.accept"), offer_path(offer), method: :patch,
                            params: { decision: "accept" }, class: "btn-primary px-3 py-1.5 text-xs" %>
              <%= button_to t("offers.actions.decline"), offer_path(offer), method: :patch,
                            params: { decision: "decline" }, class: "btn-accent px-3 py-1.5 text-xs" %>
            </div>
            <%= form_with url: offer_path(offer), method: :patch, scope: nil, class: "mt-3 flex flex-wrap items-end gap-2" do %>
              <%= hidden_field_tag :decision, "counter" %>
              <div>
                <%= label_tag "counter_amount_#{offer.id}", t("offers.actions.counter_amount"), class: "block text-[11px] font-semibold uppercase tracking-widest text-muted" %>
                <%= number_field_tag :amount, nil, min: 1, step: "0.01", id: "counter_amount_#{offer.id}", class: "field mt-1 w-32" %>
              </div>
              <div class="min-w-40 flex-1">
                <%= label_tag "counter_message_#{offer.id}", t("offers.actions.counter_message"), class: "block text-[11px] font-semibold uppercase tracking-widest text-muted" %>
                <%= text_field_tag :message, nil, id: "counter_message_#{offer.id}", class: "field mt-1" %>
              </div>
              <%= submit_tag t("offers.actions.counter"), class: "btn-primary px-3 py-2 text-xs" %>
            <% end %>
          </div>
        <% end %>

        <% redeemable_offers.each do |offer| %>
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-success/40 bg-success-soft p-3">
            <p class="text-sm font-semibold text-content"><%= t("offers.actions.accepted", amount: offer_amount(offer)) %></p>
            <%= button_to t("offers.actions.buy"),
                          cart_items_path,
                          params: { listing_id: offer.listing_id, offer_id: offer.id, quantity: 1, buy_now: true },
                          class: "btn-primary px-3 py-1.5 text-xs" %>
          </div>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <div id="messages" data-chat-target="messages" class="mt-4 flex-1 space-y-2 overflow-y-auto">
    <% @messages.group_by { |message| message.created_at.to_date }.each do |day, messages| %>
      <div class="flex justify-center py-2">
        <span class="rounded-full bg-surface-muted px-3 py-1 text-[11px] font-semibold text-muted"><%= l(day, format: :long) %></span>
      </div>
      <% messages.each do |message| %>
        <%= render "messages/message", message: message %>
      <% end %>
    <% end %>
  </div>

  <%= render "conversations/composer", conversation: @conversation, message: @message %>
</div>
