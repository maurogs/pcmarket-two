<div id="message-composer" class="mt-4 border-t border-border pt-4">
  <% if message.errors.any? %>
    <p class="mb-2 rounded-lg border border-danger/40 bg-danger-soft px-3 py-2 text-xs font-semibold text-danger">
      <%= message.errors.full_messages.first %>
    </p>
  <% end %>

  <%= form_with model: [ conversation, message ],
                multipart: true,
                class: "flex flex-col gap-2" do |form| %>
    <div class="flex items-end gap-2">
      <%= form.text_area :body,
                         rows: 1,
                         placeholder: t("conversations.show.composer_placeholder"),
                         data: { chat_target: "input", action: "keydown->chat#submitOnEnter" },
                         class: "field min-h-11 flex-1 resize-none" %>
      <label class="icon-button cursor-pointer" aria-label="<%= t("conversations.show.attach_images") %>">
        <%= form.file_field :images,
                            multiple: true,
                            accept: "image/png,image/jpeg,image/webp",
                            class: "sr-only",
                            data: { chat_target: "files" } %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6.5" stroke-linecap="round"></path>
          <path d="m16 3 5 5M21 3l-9 9" stroke-linecap="round"></path>
        </svg>
      </label>
      <%= form.submit t("conversations.show.send"), class: "btn-primary" %>
    </div>
    <p class="text-[11px] text-muted"><%= t("conversations.show.composer_hint") %></p>
  <% end %>
</div>
