<% photo = listing.primary_photo %>
<% expected = pc_finder_expected_performances(listing, criteria) %>
<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden bg-surface-muted">
    <%= link_to listing_path(listing), class: "block h-full w-full", tabindex: "-1", aria: { hidden: "true" } do %>
      <% if photo&.image&.attached? %>
        <%= image_tag url_for(photo.image.variant(:card)), alt: "", width: 640, height: 480,
                      loading: eager ? "eager" : "lazy",
                      class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-muted">
          <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m4 17 5-5 4 4 3-3 4 4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <h3 class="text-sm font-semibold leading-snug">
      <%= link_to listing.title, listing_path(listing), class: "line-clamp-2 transition hover:text-primary-700 dark:hover:text-primary-300" %>
    </h3>

    <% specs = card_specs(listing, limit: 3) %>
    <% if specs.any? %>
      <ul class="space-y-0.5 text-xs text-muted">
        <% specs.each do |spec| %>
          <li class="flex gap-1">
            <span class="shrink-0"><%= spec[:label] %>:</span>
            <span class="line-clamp-1"><%= spec[:value] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if expected.any? %>
      <div class="rounded-xl bg-primary-50 px-3 py-2 text-xs font-semibold text-primary-800 dark:bg-primary-900/30 dark:text-primary-100">
        <p class="text-[10px] font-bold uppercase tracking-widest text-primary-700 dark:text-primary-200"><%= t("pc_finder.results.expected_title") %></p>
        <ul class="mt-1 space-y-0.5">
          <% expected.each do |line| %>
            <li><%= line %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-auto space-y-2 pt-1">
      <p class="text-lg font-extrabold tracking-tight"><%= money(listing.price_cents, currency: listing.currency) %></p>
      <p class="text-xs text-muted"><%= condition_label(listing.condition) %> · <%= location_label(listing) %></p>
      <%= button_to cart_items_path, method: :post,
                    params: { listing_id: listing.id },
                    class: "btn-primary w-full cursor-pointer" do %>
        <%= t("pc_finder.results.add_to_cart") %>
      <% end %>
    </div>
  </div>
</article>
