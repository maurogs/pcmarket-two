<% set_meta_tags(title: @store.name, description: @store.description, noindex: false) %>

<div class="space-y-6">
  <header class="rounded-2xl border border-border bg-surface p-6">
    <div class="flex flex-wrap items-center gap-4">
      <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl bg-surface-muted">
        <% if @store.logo.attached? %>
          <%= image_tag url_for(@store.logo.variant(resize_to_limit: [ 160, 160 ], format: :webp)),
                        width: 160,
                        height: 160,
                        alt: @store.name,
                        class: "h-full w-full object-cover" %>
        <% else %>
          <div class="flex h-full w-full items-center justify-center text-2xl font-extrabold text-primary-700 dark:text-primary-300">
            <%= @store.name.first(2).upcase %>
          </div>
        <% end %>
      </div>

      <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-extrabold tracking-tight text-content"><%= @store.name %></h1>
        <p class="mt-1 text-sm text-muted"><%= t("storefronts.member_since", date: l(@store.created_at.to_date, format: :long)) %></p>
        <% if @store.description.present? %>
          <p class="mt-2 max-w-2xl text-sm text-content"><%= @store.description %></p>
        <% end %>
      </div>

      <% if user_signed_in? && @store.user_id != current_user.id %>
        <div class="flex flex-wrap items-center gap-2">
          <%= button_to t("listings.show.message_seller"),
                        conversations_path,
                        params: { store_id: @store.id },
                        class: "btn-primary" %>
          <%= button_to t("blocks.block"),
                        blocks_path,
                        params: { blocked_user_id: @store.user_id },
                        class: "rounded-xl border border-border bg-surface px-3 py-2 text-xs font-semibold text-danger hover:bg-danger-soft" %>
        </div>
      <% end %>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-muted">
      <span><%= t("listings.show.seller.listings") %>: <strong class="text-content"><%= @store.listings_count %></strong></span>
      <span><%= t("storefronts.report_hint") %></span>
      <%= link_to t("reports.link"),
                  new_report_path(reportable_type: "Store", reportable_id: @store.id),
                  class: "font-semibold text-danger underline-offset-2 hover:underline" %>
    </div>
  </header>

  <% if @listings.any? %>
    <section class="space-y-3">
      <h2 class="text-lg font-bold"><%= t("storefronts.listings_title") %></h2>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        <% @listings.each do |listing| %>
          <li><%= render "listings/card", listing: listing, eager: false %></li>
        <% end %>
      </ul>
    </section>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("storefronts.empty_title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("storefronts.empty_body") %></p>
    </div>
  <% end %>
</div>
