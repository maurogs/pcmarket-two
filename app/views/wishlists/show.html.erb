<% set_meta_tags(title: t("wishlist.title"), noindex: true) %>

<div class="space-y-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("wishlist.eyebrow") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("wishlist.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("wishlist.subtitle") %></p>
    </div>
  </header>

  <nav aria-label="<%= t("wishlist.tabs.label") %>">
    <ul class="flex flex-wrap items-center gap-1.5">
      <% Wishlist::TABS.each do |tab| %>
        <% current = @wishlist.tab == tab %>
        <% count = tab == "favourites" ? @wishlist.favourite_count : @wishlist.following_count %>
        <li>
          <%= link_to wishlist_path(tab: tab),
                      aria: { current: ("page" if current) },
                      class: "inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm font-medium transition #{current ? "border-primary-600 bg-primary-600 text-white" : "border-border bg-surface text-muted hover:border-primary-400 hover:text-primary-700 dark:hover:text-primary-300"}" do %>
            <span><%= t("wishlist.tabs.#{tab}") %></span>
            <span class="inline-flex min-w-5 items-center justify-center rounded-full px-1.5 py-0.5 text-[11px] font-bold leading-none <%= current ? "bg-white/20 text-white" : "bg-surface-muted text-content" %>">
              <%= count %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <% if @wishlist.tab == "favourites" %>
    <% if @wishlist.favourites.any? %>
      <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <% @wishlist.favourites.each do |favourite| %>
          <% listing = favourite.listing %>
          <% available = listing.publicly_visible? %>
          <% availability_label = wishlist_availability_label(listing) %>
          <li class="flex gap-3 rounded-2xl border border-border bg-surface p-3 <%= "opacity-60 grayscale" unless available %>">
            <%= link_to listing_path(listing), class: "block shrink-0" do %>
              <div class="h-24 w-24 overflow-hidden rounded-xl border border-border bg-surface-muted">
                <% photo = listing.primary_photo %>
                <% if photo&.image&.attached? %>
                  <%= image_tag url_for(photo.image.variant(:thumb)), alt: "", class: "h-full w-full object-cover" %>
                <% end %>
              </div>
            <% end %>

            <div class="flex min-w-0 flex-1 flex-col">
              <div class="flex items-start justify-between gap-2">
                <h2 class="min-w-0 text-sm font-semibold leading-snug text-content">
                  <%= link_to listing.title, listing_path(listing), class: "line-clamp-2 hover:text-primary-700 dark:hover:text-primary-300" %>
                </h2>
                <% if availability_label %>
                  <span class="shrink-0 rounded-full bg-surface-muted px-2 py-0.5 text-[11px] font-semibold text-muted"><%= availability_label %></span>
                <% end %>
              </div>

              <p class="mt-1 text-xs text-muted">
                <span><%= listing.store.name %></span>
                <span aria-hidden="true">·</span>
                <span><%= condition_label(listing.condition) %></span>
              </p>

              <p class="mt-1 text-sm font-bold text-content"><%= money(listing.price_cents, currency: listing.currency) %></p>

              <p class="mt-1 text-xs text-muted"><%= t("wishlist.favourites.added_on", date: l(favourite.created_at.to_date, format: :short)) %></p>

              <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
                <% if available %>
                  <%= button_to t("wishlist.favourites.move_to_basket"),
                                cart_items_path,
                                params: { listing_id: listing.id, quantity: 1 },
                                class: "rounded-lg border border-border bg-surface px-2 py-1 text-xs font-semibold text-content transition hover:bg-surface-muted" %>
                <% end %>
                <%= button_to t("wishlist.favourites.remove"),
                              listing_favourite_path(listing),
                              method: :delete,
                              class: "rounded-lg border border-border bg-surface px-2 py-1 text-xs font-semibold text-danger transition hover:bg-danger-soft" %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
        <h2 class="text-lg font-bold"><%= t("wishlist.favourites.empty_title") %></h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("wishlist.favourites.empty_body") %></p>
        <div class="mt-5 flex justify-center">
          <%= link_to t("wishlist.favourites.empty_cta"), root_path, class: "btn-primary" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <% if @wishlist.follows.any? %>
      <ul class="divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
        <% @wishlist.follows.each do |follow| %>
          <% store = follow.store %>
          <li class="flex flex-wrap items-center gap-4 p-4">
            <div class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-surface-muted">
              <% if store.logo.attached? %>
                <%= image_tag url_for(store.logo.variant(resize_to_limit: [ 96, 96 ], format: :webp)),
                              width: 96,
                              height: 96,
                              alt: store.name,
                              class: "h-full w-full object-cover" %>
              <% else %>
                <div class="flex h-full w-full items-center justify-center text-lg font-extrabold text-primary-700 dark:text-primary-300">
                  <%= store.name.first(2).upcase %>
                </div>
              <% end %>
            </div>

            <div class="min-w-0 flex-1">
              <p class="flex items-center gap-1 truncate text-sm font-bold text-content">
                <span class="truncate"><%= store.name %></span>
              </p>
              <p class="mt-1 text-xs text-muted">
                <%= t("wishlist.following.followers_count", count: store.followers_count) %>
                <span aria-hidden="true">·</span>
                <%= t("wishlist.following.listings_count", count: store.listings_count) %>
              </p>
              <p class="mt-0.5 text-xs text-muted"><%= t("wishlist.following.following_since", date: l(follow.created_at.to_date, format: :long)) %></p>
            </div>

            <%= button_to t("wishlist.following.unfollow"),
                          store_follow_path(store),
                          method: :delete,
                          class: "rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-semibold text-content transition hover:bg-surface-muted" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
        <h2 class="text-lg font-bold"><%= t("wishlist.following.empty_title") %></h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("wishlist.following.empty_body") %></p>
        <div class="mt-5 flex justify-center">
          <%= link_to t("wishlist.following.empty_cta"), root_path, class: "btn-primary" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
