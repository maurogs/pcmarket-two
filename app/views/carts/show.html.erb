<% set_meta_tags(title: t("cart.title"), noindex: true) %>

<div class="space-y-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("cart.eyebrow") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("cart.title") %></h1>
    </div>
    <p class="text-sm text-muted"><%= t("cart.item_count", count: @cart.persisted? ? @cart.item_count : 0) %></p>
  </header>

  <% if @groups.empty? && @cart.unavailable_items.empty? %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("cart.empty.title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("cart.empty.body") %></p>
      <div class="mt-5 flex justify-center">
        <%= link_to t("cart.empty.cta"), root_path, class: "btn-primary" %>
      </div>
    </div>
  <% else %>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="space-y-4">
        <% @groups.each do |group| %>
          <section class="overflow-hidden rounded-2xl border border-border bg-surface">
            <header class="flex flex-wrap items-center justify-between gap-2 border-b border-border bg-surface-muted px-4 py-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("cart.seller") %></p>
                <p class="text-sm font-bold text-content"><%= group.store.name %></p>
              </div>
              <p class="text-sm text-muted"><%= t("cart.shipping_line", price: money(group.shipping_cents)) %></p>
            </header>

            <ul class="divide-y divide-border">
              <% group.items.each do |item| %>
                <% listing = item.listing %>
                <li class="flex flex-col gap-3 p-4 sm:flex-row">
                  <%= link_to listing_path(listing), class: "block shrink-0" do %>
                    <% photo = listing.primary_photo %>
                    <div class="h-24 w-24 overflow-hidden rounded-xl border border-border bg-surface-muted">
                      <% if photo&.image&.attached? %>
                        <%= image_tag url_for(photo.image.variant(:thumb)), alt: "", class: "h-full w-full object-cover" %>
                      <% end %>
                    </div>
                  <% end %>

                  <div class="min-w-0 flex-1">
                    <h3 class="text-sm font-semibold leading-snug">
                      <%= link_to listing.title, listing_path(listing), class: "hover:text-primary-700 dark:hover:text-primary-300" %>
                    </h3>
                    <p class="mt-1 text-xs text-muted"><%= group.store.name %> · <%= condition_label(listing.condition) %></p>
                    <p class="mt-2 text-sm font-bold text-content"><%= money(listing.price_cents, currency: listing.currency) %></p>

                    <div class="mt-3 flex flex-wrap items-center gap-3">
                      <% if listing.quantity > 1 || item.quantity > 1 %>
                        <%= form_with url: cart_item_path(item), method: :patch, scope: nil, class: "flex items-center gap-2" do %>
                          <label for="cart_item_<%= item.id %>_quantity" class="text-xs font-medium text-muted"><%= t("cart.quantity") %></label>
                          <%= number_field_tag :quantity, item.quantity, min: 1, max: listing.quantity,
                                               id: "cart_item_#{item.id}_quantity",
                                               class: "w-16 rounded-lg border border-border bg-surface px-2 py-1 text-sm" %>
                          <%= submit_tag t("cart.update"), class: "rounded-lg border border-border bg-surface px-2 py-1 text-xs font-semibold hover:bg-surface-muted" %>
                        <% end %>
                      <% else %>
                        <p class="text-xs text-muted"><%= t("cart.quantity_value", count: item.quantity) %></p>
                      <% end %>

                      <%= button_to t("cart.remove"), cart_item_path(item), method: :delete,
                                    class: "rounded-lg border border-border bg-surface px-2 py-1 text-xs font-semibold text-danger hover:bg-danger-soft" %>
                      <button type="button" disabled title="<%= t("cart.wishlist_placeholder") %>"
                              class="rounded-lg border border-border bg-surface px-2 py-1 text-xs font-semibold text-muted opacity-60">
                        <%= t("cart.save_to_wishlist") %>
                      </button>
                    </div>
                  </div>

                  <p class="shrink-0 text-sm font-bold text-content sm:text-right"><%= money(item.line_total_cents, currency: listing.currency) %></p>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <% unavailable = @cart.unavailable_items %>
        <% if unavailable.any? %>
          <section class="rounded-2xl border border-warning/40 bg-warning-soft p-4">
            <h2 class="text-sm font-bold text-warning"><%= t("cart.unavailable.title") %></h2>
            <ul class="mt-3 space-y-3">
              <% unavailable.each do |item| %>
                <li class="flex flex-wrap items-center justify-between gap-3 text-sm">
                  <div>
                    <p class="font-semibold text-content"><%= item.listing.title %></p>
                    <p class="text-xs text-warning"><%= t("cart.unavailable.reasons.#{item.unavailable_reason}") %></p>
                  </div>
                  <%= button_to t("cart.remove"), cart_item_path(item), method: :delete,
                                class: "rounded-lg border border-border bg-surface px-2 py-1 text-xs font-semibold" %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <section class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="text-lg font-bold"><%= t("cart.summary.title") %></h2>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-muted"><%= t("cart.summary.subtotal") %></dt>
              <dd class="font-semibold"><%= money(@cart.subtotal_cents) %></dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted"><%= t("cart.summary.shipping") %></dt>
              <dd class="font-semibold"><%= money(@cart.shipping_cents) %></dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-border pt-2 text-base">
              <dt class="font-bold"><%= t("cart.summary.total") %></dt>
              <dd class="font-extrabold"><%= money(@cart.total_cents) %></dd>
            </div>
          </dl>

          <div class="mt-5 space-y-2">
            <% if user_signed_in? || Flipper.enabled?(:guest_checkout) %>
              <%= link_to t("cart.checkout"), new_checkout_path, class: "btn-primary w-full" %>
            <% else %>
              <%= link_to t("cart.log_in"), new_user_session_path, class: "btn-primary w-full" %>
            <% end %>
            <% unless user_signed_in? %>
              <% if Flipper.enabled?(:guest_checkout) %>
                <%= link_to t("cart.checkout_as_guest"), new_checkout_path, class: "btn-accent w-full" %>
                <%= link_to t("cart.log_in"), new_user_session_path, class: "block text-center text-xs font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
              <% else %>
                <p class="text-xs text-muted"><%= t("cart.guest_disabled") %></p>
              <% end %>
            <% end %>
          </div>
        </section>

        <section class="rounded-2xl border border-primary-200 bg-primary-50 p-5 text-sm dark:border-primary-800 dark:bg-primary-900/30">
          <h2 class="text-sm font-bold text-primary-900 dark:text-primary-100"><%= t("cart.buyer_protection.title") %></h2>
          <p class="mt-1.5 text-primary-800 dark:text-primary-200"><%= t("cart.buyer_protection.body", days: Setting.get(:buyer_protection_days, 2).to_i) %></p>
        </section>
      </aside>
    </div>
  <% end %>
</div>
