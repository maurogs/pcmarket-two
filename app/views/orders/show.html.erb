<% set_meta_tags(title: t("orders.show.title", number: @order.number), noindex: true) %>

<div class="space-y-6">
  <nav class="text-sm">
    <%= link_to t("orders.show.back"), orders_path, class: "font-semibold text-primary-700 hover:underline dark:text-primary-300" %>
  </nav>

  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("orders.show.eyebrow") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= @order.number %></h1>
      <p class="mt-1 text-sm text-muted"><%= t("orders.show.placed_on", date: l(@order.created_at.to_date, format: :long)) %> · <%= @order.store.name %></p>
    </div>
    <span class="inline-flex rounded-full border px-3 py-1.5 text-sm font-semibold <%= order_status_badge_class(@order.status) %>">
      <%= order_status_label(@order.status) %>
    </span>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-4">
      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-lg font-bold"><%= t("orders.show.items") %></h2>
        <ul class="mt-3 divide-y divide-border">
          <% @order.items.each do |item| %>
            <li class="flex gap-3 py-3">
              <div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl border border-border bg-surface-muted">
                <% if item.photo_url.present? %>
                  <%= image_tag item.photo_url, alt: "", class: "h-full w-full object-cover" %>
                <% end %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold"><%= item.title %></p>
                <p class="text-xs text-muted"><%= item.seller_name %> · <%= t("orders.show.quantity", count: item.quantity) %></p>
              </div>
              <p class="text-sm font-bold"><%= money(item.line_total_cents, currency: @order.currency) %></p>
            </li>
          <% end %>
        </ul>

        <dl class="mt-3 space-y-1 border-t border-border pt-3 text-sm">
          <div class="flex justify-between"><dt class="text-muted"><%= t("orders.show.subtotal") %></dt><dd class="font-semibold"><%= money(@order.subtotal_cents, currency: @order.currency) %></dd></div>
          <div class="flex justify-between"><dt class="text-muted"><%= t("orders.show.shipping") %></dt><dd class="font-semibold"><%= money(@order.shipping_cents, currency: @order.currency) %></dd></div>
          <div class="flex justify-between border-t border-border pt-2 text-base"><dt class="font-bold"><%= t("orders.show.total") %></dt><dd class="font-extrabold"><%= money(@order.total_cents, currency: @order.currency) %></dd></div>
        </dl>
      </section>

      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-lg font-bold"><%= t("orders.show.timeline") %></h2>
        <% if order_timeline(@order).any? %>
          <ol class="mt-4 space-y-3">
            <% order_timeline(@order).each do |event| %>
              <li class="flex gap-3 text-sm">
                <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-primary-600"></span>
                <div>
                  <p class="font-semibold"><%= event[:label] %></p>
                  <p class="text-xs text-muted"><%= l(event[:at], format: :long) %></p>
                </div>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="mt-2 text-sm text-muted"><%= t("orders.show.no_events") %></p>
        <% end %>
      </section>

      <section id="review" class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-lg font-bold"><%= t("reviews.section.title") %></h2>

        <% if @order.review&.persisted? %>
          <div class="mt-3 rounded-xl bg-surface-muted p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex gap-0.5">
                <% rating_stars(@order.review.rating).each do |star| %>
                  <svg class="h-4 w-4 <%= star == "full" ? "text-accent" : "text-border" %>" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9L12 3Z"></path>
                  </svg>
                <% end %>
              </div>
              <p class="text-xs text-muted"><%= l(@order.review.created_at.to_date, format: :long) %></p>
            </div>
            <p class="mt-2 whitespace-pre-line text-sm text-content"><%= @order.review.body %></p>
            <% if @order.review.seller_replied? %>
              <div class="mt-3 rounded-xl bg-surface p-3">
                <p class="text-xs font-semibold uppercase tracking-widest text-muted"><%= t("reviews.section.seller_reply") %></p>
                <p class="mt-1 whitespace-pre-line text-sm text-content"><%= @order.review.seller_reply %></p>
              </div>
            <% end %>
          </div>

          <% if policy(@order.review).update? %>
            <details class="mt-4">
              <summary class="cursor-pointer text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300">
                <%= t("reviews.section.edit") %>
              </summary>
              <div class="mt-3">
                <%= render "reviews/form", order: @order, review: @order.review %>
              </div>
            </details>
          <% end %>
        <% elsif policy(@review).create? %>
          <p class="mt-1 text-sm text-muted"><%= t("reviews.section.cta") %></p>
          <div class="mt-4">
            <%= render "reviews/form", order: @order, review: @review %>
          </div>
        <% elsif @order.delivered? || @order.completed? %>
          <p class="mt-2 text-sm text-muted"><%= t("reviews.section.window_closed") %></p>
        <% else %>
          <p class="mt-2 text-sm text-muted"><%= t("reviews.section.not_yet") %></p>
        <% end %>
      </section>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-sm font-bold"><%= t("orders.show.delivery") %></h2>
        <p class="mt-2 text-sm font-semibold"><%= order_fulfilment_label(@order) %></p>
        <% if @order.tracking_number.present? %>
          <p class="mt-2 text-sm text-muted"><%= t("orders.show.tracking", carrier: t("orders.carriers.#{@order.tracking_carrier.presence || 'other'}"), number: @order.tracking_number) %></p>
        <% end %>
        <address class="mt-3 space-y-0.5 text-sm not-italic text-muted">
          <% order_address_lines(@order).each do |line| %>
            <span class="block"><%= line %></span>
          <% end %>
        </address>
      </section>

      <section class="rounded-2xl border border-border bg-surface p-5">
        <h2 class="text-sm font-bold"><%= t("orders.show.actions") %></h2>
        <div class="mt-3 space-y-2">
          <% if policy(@order).confirm_delivery? %>
            <%= button_to t("orders.show.confirm_delivery"), order_delivery_confirmation_path(@order),
                          method: :post, class: "btn-primary w-full" %>
          <% end %>

          <% if policy(@order).cancel? %>
            <%= form_with url: order_cancellation_path(@order), method: :post, scope: nil, class: "space-y-2" do %>
              <%= text_field_tag :reason, nil, placeholder: t("orders.show.cancel_reason"), class: "field" %>
              <%= submit_tag t("orders.show.cancel"), class: "btn-accent w-full",
                             data: { turbo_confirm: t("orders.show.cancel_confirm") } %>
            <% end %>
          <% end %>

          <% if policy(@order).report_problem? %>
            <%= button_to t("orders.show.report_problem"), order_problem_report_path(@order),
                          method: :post, class: "w-full rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-content hover:bg-surface-muted" %>
            <p class="text-xs text-muted"><%= t("orders.show.report_problem_hint") %></p>
          <% end %>
        </div>
      </section>

      <% if @order.buyer_protection_ends_at.present? %>
        <section class="rounded-2xl border border-primary-200 bg-primary-50 p-5 text-sm dark:border-primary-800 dark:bg-primary-900/30">
          <h2 class="text-sm font-bold text-primary-900 dark:text-primary-100"><%= t("orders.show.protection_title") %></h2>
          <p class="mt-1.5 text-primary-800 dark:text-primary-200"><%= t("orders.show.protection_body", date: l(@order.buyer_protection_ends_at.to_date, format: :long)) %></p>
        </section>
      <% end %>
    </aside>
  </div>
</div>
