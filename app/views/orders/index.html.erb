<% set_meta_tags(title: t("orders.index.title"), noindex: true) %>

<div class="space-y-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-700 dark:text-primary-300"><%= t("orders.index.eyebrow") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight"><%= t("orders.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted"><%= t("orders.index.subtitle") %></p>
    </div>
    <p class="text-sm text-muted"><%= t("orders.index.count", count: @orders.size) %></p>
  </header>

  <% if @orders.any? %>
    <ul class="space-y-3">
      <% @orders.each do |order| %>
        <li class="rounded-2xl border border-border bg-surface p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-muted"><%= l(order.created_at.to_date, format: :long) %></p>
              <h2 class="text-lg font-extrabold">
                <%= link_to order.number, order_path(order), class: "hover:text-primary-700 dark:hover:text-primary-300" %>
              </h2>
              <p class="text-sm text-muted"><%= order.store.name %></p>
            </div>
            <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold <%= order_status_badge_class(order.status) %>">
              <%= order_status_label(order.status) %>
            </span>
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3 text-sm">
            <p class="text-muted"><%= t("orders.index.items", count: order.items.sum(&:quantity)) %></p>
            <div class="flex items-center gap-3">
              <span class="font-bold"><%= money(order.total_cents, currency: order.currency) %></span>
              <%= link_to t("orders.index.view"), order_path(order), class: "btn-accent" %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center">
      <h2 class="text-lg font-bold"><%= t("orders.index.empty_title") %></h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted"><%= t("orders.index.empty_body") %></p>
      <div class="mt-5 flex justify-center">
        <%= link_to t("orders.index.empty_cta"), root_path, class: "btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
