<p style="margin: 0 0 16px; font-size: 16px; font-weight: 700; color: #0f172a;"><%= t("account_mailer.data_export.title") %></p>
<p style="margin: 0 0 12px; font-size: 14px; line-height: 1.7; color: #334155;"><%= t("account_mailer.data_export.greeting", name: @user.display_name) %></p>
<p style="margin: 0 0 20px; font-size: 14px; line-height: 1.7; color: #334155;"><%= t("account_mailer.data_export.body") %></p>
<p style="margin: 0 0 12px;">
  <a href="<%= @download_url %>" style="display: inline-block; border-radius: 10px; background-color: #4f46e5; color: #ffffff; padding: 12px 20px; font-size: 14px; font-weight: 700; text-decoration: none;"><%= t("account_mailer.data_export.cta") %></a>
</p>
<p style="margin: 20px 0 0; font-size: 12px; line-height: 1.7; color: #64748b;"><%= t("account_mailer.data_export.expiry") %></p>
