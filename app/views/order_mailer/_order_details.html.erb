<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 16px; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
  <% order.items.each do |item| %>
    <tr>
      <td style="padding: 10px 0; font-size: 13px; color: #0f172a;">
        <%= item.title %> × <%= item.quantity %>
      </td>
      <td style="padding: 10px 0; font-size: 13px; color: #0f172a; text-align: right;">
        <%= number_to_currency(BigDecimal(item.line_total_cents) / 100, unit: "€") %>
      </td>
    </tr>
  <% end %>
  <tr>
    <td style="padding: 8px 0; font-size: 12px; color: #52607a;"><%= t("order_mailer.details.subtotal") %></td>
    <td style="padding: 8px 0; font-size: 12px; color: #52607a; text-align: right;"><%= number_to_currency(BigDecimal(order.subtotal_cents) / 100, unit: "€") %></td>
  </tr>
  <tr>
    <td style="padding: 4px 0; font-size: 12px; color: #52607a;"><%= t("order_mailer.details.shipping") %></td>
    <td style="padding: 4px 0; font-size: 12px; color: #52607a; text-align: right;"><%= number_to_currency(BigDecimal(order.shipping_cents) / 100, unit: "€") %></td>
  </tr>
  <tr>
    <td style="padding: 8px 0 12px; font-size: 14px; font-weight: 700; color: #0f172a;"><%= t("order_mailer.details.total") %></td>
    <td style="padding: 8px 0 12px; font-size: 14px; font-weight: 700; color: #0f172a; text-align: right;"><%= number_to_currency(BigDecimal(order.total_cents) / 100, unit: "€") %></td>
  </tr>
</table>

<% if order.tracking_number.present? %>
  <p style="margin: 0 0 12px; font-size: 13px; color: #334155;">
    <%= t("order_mailer.details.tracking", carrier: order.tracking_carrier, number: order.tracking_number) %>
  </p>
<% end %>
