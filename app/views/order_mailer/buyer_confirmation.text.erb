<%= t("order_mailer.buyer_confirmation.greeting", name: @order.checkout.shipping_address["full_name"]) %>

<%= t("order_mailer.buyer_confirmation.body", number: @order.number, store: @order.store.name) %>

<%= render "order_mailer/order_details", order: @order %>

<%= t("order_mailer.buyer_confirmation.cta") %>: <%= order_url(@order, locale: @locale) %>

<%= t("order_mailer.buyer_confirmation.closing") %>
