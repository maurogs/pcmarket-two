<%= render layout: "devise/shared/auth_layout",
           locals: { title: t("auth.forgot_password.title"), subtitle: t("auth.forgot_password.subtitle") } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-content" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field mt-1.5" %>
    </div>

    <%= f.submit t("auth.forgot_password.submit"), class: "btn-primary w-full" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
