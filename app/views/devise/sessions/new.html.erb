<%= render layout: "devise/shared/auth_layout",
           locals: { title: t("auth.sign_in.title"), subtitle: t("auth.sign_in.subtitle") } do %>
  <% if Devise.omniauth_configs.key?(:google_oauth2) %>
    <%= button_to user_google_oauth2_omniauth_authorize_path,
                  data: { turbo: false },
                  class: "btn-primary w-full" do %>
      <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4Z"></path>
        <path fill="currentColor" d="M12 22c2.7 0 4.9-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z"></path>
        <path fill="currentColor" d="M6.4 14a6 6 0 0 1 0-3.9V7.5H3.1a10 10 0 0 0 0 9l3.3-2.5Z"></path>
        <path fill="currentColor" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.5L6.4 10C7.2 7.7 9.4 6 12 6Z"></path>
      </svg>
      <span><%= t("auth.google") %></span>
    <% end %>

    <div class="my-5 flex items-center gap-3 text-xs font-medium uppercase tracking-widest text-muted">
      <span class="h-px flex-1 bg-border"></span>
      <span><%= t("auth.or") %></span>
      <span class="h-px flex-1 bg-border"></span>
    </div>
  <% end %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-content" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field mt-1.5" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-content" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "field mt-1.5" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-muted">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-border text-primary-600 focus:ring-primary-500" %>
        <span><%= t("auth.remember_me") %></span>
      </label>
    <% end %>

    <%= f.submit t("auth.sign_in.submit"), class: "btn-primary w-full" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
