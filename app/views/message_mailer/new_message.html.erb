<p style="margin: 0 0 12px; font-size: 15px; color: #0f172a;">
  <%= t("message_mailer.new_message.greeting", name: @recipient.display_name) %>
</p>

<p style="margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #334155;">
  <%= t("message_mailer.new_message.body",
        sender: @message.sender.display_name,
        title: @conversation.display_title) %>
</p>

<blockquote style="margin: 0 0 16px; border-left: 3px solid #4f46e5; padding: 8px 14px; background-color: #f8fafc; font-size: 14px; line-height: 1.6; color: #334155;">
  <%= truncate(@message.body, length: 280) %>
</blockquote>

<p style="margin: 16px 0;">
  <a href="<%= @cta_url %>"
     style="display: inline-block; border-radius: 12px; background-color: #4f46e5; color: #ffffff; font-size: 14px; font-weight: 600; padding: 12px 20px; text-decoration: none;">
    <%= t("message_mailer.new_message.cta") %>
  </a>
</p>

<p style="margin: 0; font-size: 14px; line-height: 1.6; color: #334155;">
  <%= t("message_mailer.new_message.closing") %>
</p>
